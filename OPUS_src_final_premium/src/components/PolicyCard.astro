---
interface Props { label: string; title: string; body: string; }
const { label, title, body } = Astro.props;
---
<article class="h-full border border-neutral-200 bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,0.04)] md:p-7">
  <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">{label}</p>
  <div class="mt-3 h-[1.75px] w-12 bg-opus-red"></div>
  <h3 class="mt-4 text-[1.02rem] font-semibold leading-6 tracking-[-0.01em] text-opus-dark">{title}</h3>
  <p class="mt-3 text-sm leading-7 text-neutral-700 md:text-[0.98rem]">{body}</p>
</article>
