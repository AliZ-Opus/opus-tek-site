---
import PolicyCard from "./PolicyCard.astro";
interface CardData { label: string; title: string; body: string; }
interface Props { id: string; eyebrow: string; title: string; intro: string; cards: CardData[]; }
const { id, eyebrow, title, intro, cards = [] } = Astro.props;
---
<section id={id} class="scroll-mt-32 border-t border-neutral-200 py-14 md:py-18">
  <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
    <div class="max-w-[920px]">
      <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">{eyebrow}</p>
      <h2 class="mt-4 text-[clamp(1.8rem,3vw,3rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">{title}</h2>
      <p class="mt-5 max-w-[72ch] text-base leading-8 text-neutral-700 md:text-[1.02rem]">{intro}</p>
    </div>
    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      {cards.map((card) => <PolicyCard label={card.label} title={card.title} body={card.body} />)}
    </div>
  </div>
</section>
