---
import { Image } from "astro:assets";
import S1Underline from "./nav/S1Underline.astro";
import HomeHeroMicroCard from "./HomeHeroMicroCard.astro";
import heroImage from "../assets/hero/opus-hero-cgi-hq.png";

interface PodItem {
  label: string;
  href: string;
  current?: boolean;
}

interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  pods?: PodItem[];
}

const {
  kicker = "ARCHITECTURE · INTÉGRATION · IA",
  title = "Transformer des systèmes complexes en dispositifs exécutables.",
  lead = "OPUS accompagne les organisations qui doivent concevoir, sécuriser et exécuter des plateformes technologiques, intégrations et capacités d’intelligence artificielle dans des environnements exigeants.",
  primaryCtaLabel = "Parler à un expert",
  primaryCtaHref = "/contact",
  secondaryCtaLabel = "Voir nos services",
  secondaryCtaHref = "/services",
  pods = [
    { label: "SERVICES", href: "/services", current: true },
    { label: "SOLUTIONS", href: "/offres" },
    { label: "RESSOURCES", href: "/ressources" },
  ],
} = Astro.props;
---

<section aria-label="Accueil - Hero OPUS" class="relative isolate overflow-hidden bg-white">
  <div class="mx-auto grid min-h-[84svh] max-w-[1680px] grid-cols-1 items-center px-4 py-12 md:px-8 xl:px-10 lg:grid-cols-[29%_71%]">
    <div class="relative z-20 flex min-w-0 items-center">
      <div class="relative w-full max-w-[620px] py-10 lg:py-14">
        <div
          aria-hidden="true"
          class="hero-mask-left pointer-events-none absolute inset-y-0 -left-8 right-[-84%] z-0"
        ></div>

        <div class="relative z-10">
          <p class="mb-6 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
            {kicker}
          </p>

          <h1 class="max-w-[16ch] text-[clamp(2.8rem,5vw,4.8rem)] font-black leading-[0.92] tracking-[-0.04em] text-opus-dark">
            {title}
          </h1>

          <p class="mt-6 max-w-[60ch] text-lg leading-8 text-neutral-700">
            {lead}
          </p>

          <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-neutral-600">
            <span class="inline-flex items-center gap-2">
              <span class="h-[2px] w-4 bg-opus-red"></span>
              Senior-led engagements
            </span>

            <span class="inline-flex items-center gap-2">
              <span class="h-[2px] w-4 bg-opus-red"></span>
              Enterprise architecture
            </span>

            <span class="inline-flex items-center gap-2">
              <span class="h-[2px] w-4 bg-opus-red"></span>
              Decision-to-execution model
            </span>
          </div>

          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href={primaryCtaHref}
              class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white shadow-[0_10px_24px_rgba(0,0,0,0.08)] transition hover:border-black hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
            >
              {primaryCtaLabel} →
            </a>

            <a
              href={secondaryCtaHref}
              class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark shadow-[0_10px_24px_rgba(0,0,0,0.04)] transition hover:border-opus-dark hover:bg-opus-dark hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
            >
              {secondaryCtaLabel}
            </a>
          </div>

          <div class="mt-10 w-fit">
            <S1Underline selector='[data-s1-item]' active='[aria-current="page"]'>
              <nav aria-label="Navigation rapide accueil" class="flex items-center gap-7">
                {pods.map((item) => (
                  <a
                    href={item.href}
                    data-s1-item
                    aria-current={item.current ? "page" : undefined}
                    class:list={[
                      "inline-flex min-h-10 items-center pb-3 text-[0.72rem] font-semibold uppercase tracking-[0.18em] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]",
                      item.current ? "text-opus-dark" : "text-neutral-500 hover:text-opus-dark",
                    ]}
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
            </S1Underline>
          </div>
        </div>
      </div>
    </div>

    <div class="relative mt-6 h-full min-h-[520px] sm:min-h-[600px] lg:mt-0 lg:min-h-[760px]">
      <Image
        src={heroImage}
        alt="Visualisation architecturale OPUS"
        widths={[1280, 1600, 1920, 2400]}
        sizes="(max-width: 1023px) 100vw, 71vw"
        format="avif"
        quality={96}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-center"
        style="opacity:1!important;"
      />

      <div class="absolute bottom-6 right-6 z-20 w-[330px] md:bottom-8 md:right-8 md:w-[360px]">
        <HomeHeroMicroCard />
      </div>
    </div>
  </div>
</section>
