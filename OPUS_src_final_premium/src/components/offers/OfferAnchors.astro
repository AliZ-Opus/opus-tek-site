---
import S1Underline from '../nav/S1Underline.astro';
const { items = [] } = Astro.props;
---
<nav class="offer-anchors" aria-label="Sections de l'offre" data-offer-anchors>
  <S1Underline selector='[data-offer-anchor]' active='[aria-current="true"]'>
    <div class="offer-anchors__list">
      {items.map((item, i) => (
        <a data-offer-anchor href={`#${item.id}`} class={`offer-anchor ${i===0 ? 'is-active': ''}`} aria-current={i===0 ? 'true' : 'false'}>{item.label}</a>
      ))}
    </div>
  </S1Underline>
  <script>
    const root = document.currentScript?.closest('[data-offer-anchors]');
    if (root) {
      const links = Array.from(root.querySelectorAll('[data-offer-anchor]'));
      const ids = links.map(l => l.getAttribute('href')?.slice(1)).filter(Boolean);
      const sections = ids.map(id => document.getElementById(id)).filter(Boolean);

      const setActive = (id) => {
        links.forEach((l) => {
          const active = l.getAttribute('href') === `#${id}`;
          l.classList.toggle('is-active', active);
          l.setAttribute('aria-current', active ? 'true' : 'false');
        });
      };

      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter(e => e.isIntersecting)
          .sort((a,b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible?.target?.id) setActive(visible.target.id);
      }, { rootMargin: '-20% 0px -65% 0px', threshold: [0.1, 0.3, 0.6] });

      sections.forEach(s => observer.observe(s));
      window.addEventListener('hashchange', () => {
        const id = location.hash.replace('#','');
        if (id) setActive(id);
      });
    }
  </script>
</nav>
