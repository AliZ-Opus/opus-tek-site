---
const cases = [
  { href: "/case-studies/megawatt", title: "MegaWatt", text: "Priorisation intelligente des appels d’offres et gain mesurable de capacité commerciale." },
  { href: "/case-studies/nostra", title: "Nostra", text: "Calcul intensif nocturne, volumétrie élevée et résultats exploitables dès le matin." },
  { href: "/case-studies/pharmacie", title: "Pharmacie", text: "IA appliquée en environnement réglementé, avec adoption rapide et traçabilité." },
];
---

<section class="border-t border-black/8 bg-white" aria-label="Études de cas - aperçu">
  <div class="mx-auto w-full max-w-[1680px] px-4 py-16 md:px-8 md:py-20 xl:px-10">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-[56ch]">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">ÉTUDES DE CAS</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-authority text-opus-dark md:text-5xl">Des preuves terrain, en contextes exigeants.</h2>
        <p class="mt-5 text-base leading-7 text-neutral-700 md:text-[1.02rem]">Synthèse des approches, décisions et résultats observables dans des contextes où la rigueur d’exécution fait la différence.</p>
      </div>

      <a
        class="inline-flex min-h-12 items-center justify-center border border-neutral-400 bg-white px-6 text-sm font-medium text-opus-dark shadow-[0_10px_24px_rgba(0,0,0,0.04)] transition hover:border-opus-dark hover:bg-opus-dark hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
        href="/ressources"
      >
        Voir toutes les études de cas →
      </a>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 xl:grid-cols-3">
      {cases.map((c) => (
        <a
          class="group flex min-h-[250px] flex-col rounded-[20px] border border-black/8 bg-white px-6 py-6 text-left text-opus-dark shadow-[0_10px_24px_rgba(0,0,0,0.03)] transition hover:-translate-y-0.5 hover:border-black/12 hover:shadow-[0_18px_36px_rgba(17,24,39,0.08)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
          href={c.href}
        >
          <div class="h-[2px] w-14 bg-opus-red/70"></div>
          <p class="mt-5 text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">ÉTUDE DE CAS</p>
          <h3 class="mt-3 text-[1.4rem] font-semibold leading-tight text-opus-dark">{c.title}</h3>
          <p class="mt-4 text-[0.98rem] leading-7 text-neutral-700">{c.text}</p>
          <div class="mt-auto pt-6 text-[0.82rem] font-medium uppercase tracking-[0.18em] text-opus-dark transition group-hover:text-opus-red">
            Lire le cas →
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
