---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeServicesHub from "../components/HomeServicesHub.astro";
import ExecutionArchitecture from "../components/ExecutionArchitecture.astro";
import heroImage from "../assets/hero/opus-services.png";

const pageTitle = "Services — OPUS Technology";
const pageDescription =
  "Domaines de services OPUS : architecture, intégration et intelligence appliquée pour cadrer, relier et exécuter des environnements complexes.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Services OPUS" class="relative isolate overflow-clip border-b border-neutral-200 bg-white">
      <div class="mx-auto grid min-h-[80svh] max-h-[760px] max-w-[1680px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[45%_55%] xl:px-10">
        <div class="relative z-20 flex min-w-0 items-center">
          <div class="relative w-full max-w-[800px] py-8 lg:py-12 lg:pr-12 xl:pr-24">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-y-0 -left-8 right-[-38%] z-0"
              style="
                background: linear-gradient(to right, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0) 100%);
                -webkit-mask-image: linear-gradient(to right, black 42%, transparent 100%);
                mask-image: linear-gradient(to right, black 42%, transparent 100%);
                -webkit-mask-repeat: no-repeat;
                mask-repeat: no-repeat;
                -webkit-mask-size: 100% 100%;
                mask-size: 100% 100%;
              "
            ></div>

            <div class="relative z-10">
              <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500 sm:text-xs">
                SERVICES
              </p>

              <h1 class="max-w-[18ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
                Cadrer les capacités. Relier les systèmes. Rendre l’exécution plus lisible.
              </h1>

              <p class="mt-6 max-w-[60ch] text-base leading-8 text-neutral-700 md:text-[1.05rem]">
                Cette page organise les domaines de services OPUS comme un dispositif de lecture et
                d’action. L’objectif n’est pas d’empiler des expertises, mais de rendre compréhensibles
                les capacités qui permettent de transformer un besoin complexe en trajectoire exécutable.
              </p>

              <div class="mt-7 h-[2px] w-24 bg-opus-red"></div>

              <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm text-neutral-600">
                <span class="inline-flex items-center gap-2">
                  <span class="h-[2px] w-4 bg-opus-red"></span>
                  Architecture
                </span>
                <span class="inline-flex items-center gap-2">
                  <span class="h-[2px] w-4 bg-opus-red"></span>
                  Intégration
                </span>
                <span class="inline-flex items-center gap-2">
                  <span class="h-[2px] w-4 bg-opus-red"></span>
                  Intelligence appliquée
                </span>
              </div>

              <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                <a
                  href="/offres"
                  class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white shadow-[0_10px_24px_rgba(0,0,0,0.08)] transition hover:border-black hover:bg-black"
                >
                  Voir les offres →
                </a>

                <a
                  href="/contact"
                  class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark shadow-[0_10px_24px_rgba(0,0,0,0.04)] transition hover:border-opus-dark hover:bg-opus-dark hover:text-white"
                >
                  Soumettre un besoin →
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-full min-h-[400px] sm:min-h-[520px] lg:min-h-[560px] xl:mt-0 xl:min-h-[640px]">
          <Image
            src={heroImage}
            alt="Visuel architectural illustrant les domaines de services OPUS"
            widths={[960, 1280, 1600, 1920]}
            sizes="(max-width: 1023px) 100vw, 55vw"
            format="avif"
            quality={92}
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-center"
            style="opacity: 1 !important;"
          />

          <div class="absolute bottom-6 right-6 z-20 w-[310px] border border-white/45 bg-white/80 p-5 shadow-[0_16px_40px_rgba(0,0,0,0.12)] backdrop-blur-md md:bottom-8 md:right-8 md:w-[360px]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
              EXECUTION SIGNAL
            </p>
            <h2 class="mt-4 text-[1.08rem] font-semibold leading-6 text-opus-dark">
              Une lecture claire des capacités qui soutiennent le delivery.
            </h2>
            <p class="mt-3 text-sm leading-7 text-neutral-700">
              Architecture, intégration et IA appliquée dans un cadre plus lisible, plus gouverné et
              plus exécutable.
            </p>
          </div>
        </div>
      </div>
    </section>

    <div class="relative z-30 -mt-[96px] md:-mt-[110px] lg:-mt-[120px]">
      <HomeServicesHub />
    </div>

    <ExecutionArchitecture />

    <section class="border-t border-neutral-200 bg-white py-16 md:py-20">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.05fr_.95fr]">
          <article class="border border-neutral-200 bg-white p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
              SERVICES → OFFRES
            </p>

            <h2 class="mt-4 max-w-[14ch] text-[clamp(1.9rem,3vw,3.1rem)] font-black leading-[0.96] tracking-[-0.04em] text-opus-dark">
              Les services deviennent des objets d’engagement lisibles.
            </h2>

            <p class="mt-5 max-w-[62ch] text-sm leading-8 text-neutral-700 md:text-[0.98rem]">
              Les offres OPUS traduisent les domaines de services en trajectoires concrètes,
              activables et compréhensibles pour un décideur. Elles servent de point d’entrée clair
              dans un dispositif plus large.
            </p>

            <div class="mt-7">
              <a
                href="/offres"
                class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black"
              >
                Ouvrir les offres →
              </a>
            </div>
          </article>

          <article class="border border-neutral-200 bg-neutral-50 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
              NEXT STEP
            </p>

            <p class="mt-4 text-sm leading-8 text-neutral-700 md:text-[0.98rem]">
              Lorsqu’un contexte est dense, multi-plateforme ou difficile à cadrer, la bonne entrée
              consiste d’abord à clarifier le besoin, le périmètre et la logique d’exécution.
            </p>

            <div class="mt-6 border-t border-neutral-200 pt-6">
              <a
                href="/contact"
                class="inline-flex min-h-11 items-center justify-center border border-neutral-300 bg-white px-5 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white"
              >
                Parler à OPUS →
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>