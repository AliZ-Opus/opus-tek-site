---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Carrières — OPUS Technology"
  description="Carrières chez OPUS : rejoindre une équipe orientée exécution, qualité, gouvernance et delivery."
>
  <main id="main" class="site-main">
    <section class="page">
      <div class="wrap">
        <div class="page-inner">
          <div class="page-kicker">CARRIÈRES</div>
          <h1 class="page-title">Rejoindre OPUS.</h1>
          <p class="page-lead">
            Nous cherchons des profils solides, orientés exécution : architecture, intégration, data/IA, sécurité, delivery.
            Notre standard : <strong>clarté</strong>, <strong>qualité</strong> et <strong>preuves</strong>.
          </p>

          <div class="hero-cta" style="margin-top:18px;">
            <a class="btn btn-primary" href="/contact">Candidater →</a>
            <a class="btn btn-secondary" href="/expertises">Voir nos expertises →</a>
          </div>

          <h2 class="page-title" style="font-size:28px; margin-top:34px;">Ce qu’on valorise</h2>
          <div class="page-grid" style="margin-top:18px;">
            <article class="card">
              <h3 class="card-title">Exécution propre</h3>
              <p class="card-text">
                Livrer avec rigueur : tests, standards, traçabilité, documentation exploitable.
              </p>
            </article>

            <article class="card">
              <h3 class="card-title">Responsabilités claires</h3>
              <p class="card-text">
                Ownership, transparence, priorisation. On évite la confusion et la dérive.
              </p>
            </article>

            <article class="card">
              <h3 class="card-title">Contexte exigeant</h3>
              <p class="card-text">
                Plateformes critiques, sécurité, conformité, intégration. Le “facile” n’est pas notre terrain.
              </p>
            </article>
          </div>

          <h2 class="page-title" style="font-size:28px; margin-top:34px;">Profils recherchés</h2>
          <div class="page-grid" style="margin-top:18px;">
            <article class="card">
              <h3 class="card-title">Architecture & intégration</h3>
              <p class="card-text">
                Architecte solution, intégrateur senior, lead dev. API, événements, patterns, fiabilité, observabilité.
              </p>
            </article>

            <article class="card">
              <h3 class="card-title">Données & IA</h3>
              <p class="card-text">
                Data engineer, ML/AI engineer, analyste. Pipelines, qualité data, RAG, extraction, garde-fous.
              </p>
            </article>

            <article class="card">
              <h3 class="card-title">Delivery & qualité</h3>
              <p class="card-text">
                DevOps, QA, delivery lead. CI/CD, environnements, tests, readiness, stabilisation production.
              </p>
            </article>
          </div>

          <h2 class="page-title" style="font-size:28px; margin-top:34px;">Processus</h2>
          <div class="page-grid" style="margin-top:18px;">
            <article class="card">
              <h3 class="card-title">1) Contact</h3>
              <p class="card-text">
                Courte prise de contexte : ton rôle, tes forces, ce que tu veux livrer.
              </p>
            </article>

            <article class="card">
              <h3 class="card-title">2) Échange technique</h3>
              <p class="card-text">
                Discussion concrète : cas, décisions, qualité, delivery. Pas d’entretien théorique inutile.
              </p>
            </article>

            <article class="card">
              <h3 class="card-title">3) Alignement</h3>
              <p class="card-text">
                Mandat, rythme, attentes, responsabilité. On s’engage uniquement si c’est clair.
              </p>
            </article>
          </div>

          <div class="hero-cta" style="margin-top:26px;">
            <a class="btn btn-primary" href="/contact">Candidater →</a>
            <a class="btn btn-secondary" href="/a-propos">À propos d’OPUS →</a>
          </div>

          <div class="breadcrumb">
            <a href="/">Accueil</a> <span>→</span> <span>Carrières</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>