---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MicroBand from "../../components/MicroBand.astro";
import bandServices from "../../assets/bands/opus-band-services.png";

const pageTitle = "Insights — OPUS Technology";
const pageDescription =
  "Observatoire, briefings exécutifs et signaux de marché structurés par OPUS Technology pour décideurs, sponsors et partenaires.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
<section class="relative isolate overflow-hidden border-b border-neutral-200 bg-white">
  <div aria-hidden="true" class="absolute inset-y-0 right-0 hidden w-[41%] bg-neutral-100 lg:block"></div>
  <div aria-hidden="true" class="absolute left-0 top-0 h-[2px] w-32 bg-opus-red"></div>

  <div class="relative mx-auto max-w-[1680px] px-4 py-12 md:px-8 md:py-14 xl:px-10 xl:py-16">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.88fr)_minmax(420px,0.92fr)] lg:gap-10 xl:gap-14">
      <div class="max-w-[700px] self-center">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
          INSIGHTS
        </p>

        <h1 class="mt-5 max-w-[7.4ch] text-[clamp(2.6rem,4.4vw,4.6rem)] font-black leading-[0.9] tracking-[-0.06em] text-opus-dark">
          Recherche utile. Signaux lisibles. Capture exploitable.
        </h1>

        <p class="mt-6 max-w-[57ch] text-[0.98rem] leading-8 text-neutral-700">
          Insights n’est pas un blog. C’est un hub de lecture stratégique. OPUS y publie des
          artefacts conçus pour soutenir une décision, qualifier un marché et transformer un
          signal en matière exploitable.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/insights/etude-ia-2026"
            class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black"
          >
            Participer à l’étude IA 2026 →
          </a>

          <a
            href="/ressources"
            class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white"
          >
            Voir les ressources →
          </a>
        </div>
      </div>

      <div class="relative self-center lg:pl-4 xl:pl-8">
        <div aria-hidden="true" class="absolute left-0 top-0 hidden h-full w-px bg-neutral-200 lg:block"></div>

        <div class="relative lg:ml-10 xl:ml-14">
          <article class="border border-neutral-200 bg-white p-6 shadow-[0_18px_50px_rgba(0,0,0,0.06)]">
            <div class="flex items-start justify-between gap-6">
              <div>
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
                  DELIVERY SIGNAL
                </p>
                <h2 class="mt-4 text-[1.4rem] font-semibold leading-tight text-opus-dark">
                  Hub de lecture structuré pour signaux, études et restitution exploitable.
                </h2>
              </div>

              <div class="mt-1 h-3 w-3 shrink-0 rounded-full bg-opus-red"></div>
            </div>

            <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
              <div class="border border-neutral-200 px-4 py-4">
                <p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">
                  Status
                </p>
                <p class="mt-2 text-sm font-medium text-opus-dark">Actif</p>
              </div>

              <div class="border border-neutral-200 px-4 py-4">
                <p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">
                  Focus
                </p>
                <p class="mt-2 text-sm font-medium text-opus-dark">IA / Marché</p>
              </div>

              <div class="border border-neutral-200 px-4 py-4">
                <p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">
                  Output
                </p>
                <p class="mt-2 text-sm font-medium text-opus-dark">Briefings</p>
              </div>
            </div>
          </article>

          <article class="relative -mt-px border border-neutral-200 bg-neutral-50 p-6 shadow-[0_12px_34px_rgba(0,0,0,0.04)] lg:ml-10 xl:ml-14">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
              RESEARCH POSTURE
            </p>

            <p class="mt-4 max-w-[58ch] text-sm leading-8 text-neutral-700 md:text-[0.98rem]">
              Capture terrain, qualification du besoin, lecture de marché et restitution sous forme
              de sorties courtes, denses et directement activables.
            </p>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>

    <section aria-label="Insight principal" class="home-section-pad border-b border-neutral-200 bg-white">
      <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.15fr_.85fr]">
          <article class="group relative overflow-hidden border border-neutral-200 bg-white shadow-[0_16px_50px_rgba(0,0,0,0.06)]">
            <div class="grid grid-cols-1 lg:grid-cols-[1.06fr_.94fr]">
              <div class="relative p-8 md:p-10 lg:p-12">
                <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
                  FEATURED INSIGHT
                </p>

                <h2 class="mt-5 max-w-[10ch] text-[clamp(2.2rem,4.2vw,4.4rem)] font-black leading-[0.94] tracking-[-0.04em] text-opus-dark">
                  Observatoire des Compétences IA 2026
                </h2>

                <p class="mt-6 max-w-[58ch] text-base leading-8 text-neutral-700 md:text-[1.02rem]">
                  Étude de marché structurée sur les MBA IA, les certifications professionnelles,
                  l’éducation globale et les stages liés aux capacités d’exécution en intelligence
                  artificielle.
                </p>

                <div class="mt-7 h-[2px] w-16 bg-opus-red"></div>

                <div class="mt-8 flex flex-wrap gap-3">
                  <a
                    href="/insights/etude-ia-2026"
                    class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black"
                  >
                    Ouvrir l’étude →
                  </a>

                  <a
                    href="/contact"
                    class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white"
                  >
                    Parler à OPUS →
                  </a>
                </div>
              </div>

              <div class="relative min-h-[280px] overflow-hidden bg-neutral-100">
                <div
                  aria-hidden="true"
                  class="absolute inset-0"
                  style="background:
                    radial-gradient(circle at 18% 26%, rgba(255,255,255,0.95), transparent 28%),
                    radial-gradient(circle at 72% 40%, rgba(255,255,255,0.6), transparent 24%),
                    linear-gradient(135deg, #f5f5f5 0%, #dddddd 48%, #f7f7f7 100%);
                    mix-blend-mode: luminosity;"
                ></div>

                <div class="absolute inset-0 flex items-end p-8 md:p-10">
                  <div class="max-w-[420px] border border-white/50 bg-white/80 p-5 shadow-sm backdrop-blur-md">
                    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
                      RESEARCH LAB
                    </p>
                    <p class="mt-3 text-sm leading-7 text-neutral-700">
                      Un artefact de capture conçu pour qualifier le marché, les attentes et les
                      trajectoires de montée en compétence en IA.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </article>

          <div class="grid grid-cols-1 gap-6">
            <article class="border border-neutral-200 bg-white p-7 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
                EXECUTIVE BRIEFING
              </p>

              <h3 class="mt-4 text-[1.15rem] font-semibold leading-7 text-opus-dark">
                Lecture dirigeant
              </h3>

              <p class="mt-4 text-sm leading-8 text-neutral-700 md:text-[0.98rem]">
                Une lecture dense et exploitable pour décideurs, partenaires, sponsors et directions
                qui veulent des signaux propres plutôt qu’un flux de contenu faible.
              </p>

              <div class="mt-6 border-t border-neutral-200 pt-6">
                <a
                  href="/ressources/executive-one-pager"
                  class="inline-flex min-h-11 items-center justify-center border border-neutral-300 bg-white px-5 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white"
                >
                  Ouvrir l’executive one-pager →
                </a>
              </div>
            </article>

            <article class="border border-neutral-200 bg-white p-7 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
                SIGNALS
              </p>

              <div class="mt-4 space-y-5">
                <div class="border-b border-neutral-200 pb-5">
                  <h3 class="text-[1.05rem] font-semibold leading-7 text-opus-dark">
                    OPUS × Phoenixx
                  </h3>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">
                    Modèle de delivery lisible, présence Québec et exécution structurée.
                  </p>
                </div>

                <div class="border-b border-neutral-200 pb-5">
                  <h3 class="text-[1.05rem] font-semibold leading-7 text-opus-dark">
                    Observatoire IA 2026
                  </h3>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">
                    Le premier artefact actif du hub Insights, orienté capture et qualification.
                  </p>
                </div>

                <div>
                  <h3 class="text-[1.05rem] font-semibold leading-7 text-opus-dark">
                    Ressources premium
                  </h3>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">
                    Le hub documentaire prend le relais pour fournir preuves, dossiers et documents exécutifs.
                  </p>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </section>

    <MicroBand
      src={bandServices}
      alt="Insights execution band"
      height={300}
      slogan="Un signal n’a de valeur que s’il devient lisible."
      class="my-2"
    />

    <section aria-label="Architecture éditoriale" class="home-section-pad border-b border-neutral-200 bg-white">
      <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
          <article class="border border-neutral-200 bg-white p-7 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
              01 — CAPTURE
            </p>
            <h3 class="mt-4 text-[1.15rem] font-semibold text-opus-dark">Collecter les signaux utiles</h3>
            <p class="mt-4 text-sm leading-8 text-neutral-700">
              Études, questionnaires, qualification terrain et collecte structurée des signaux qui méritent une lecture dirigeante.
            </p>
          </article>

          <article class="border border-neutral-200 bg-white p-7 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
              02 — LECTURE
            </p>
            <h3 class="mt-4 text-[1.15rem] font-semibold text-opus-dark">Transformer le bruit en matière lisible</h3>
            <p class="mt-4 text-sm leading-8 text-neutral-700">
              OPUS condense la complexité en sorties courtes, hiérarchisées, soutenues par une structure documentaire maîtrisée.
            </p>
          </article>

          <article class="border border-neutral-200 bg-white p-7 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
              03 — ACTIVATION
            </p>
            <h3 class="mt-4 text-[1.15rem] font-semibold text-opus-dark">Raccorder l’insight à l’exécution</h3>
            <p class="mt-4 text-sm leading-8 text-neutral-700">
              L’insight ne reste pas isolé : il alimente les services, les offres, les preuves documentaires et la conversion Contact.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section aria-label="Ponts premium" class="home-section-pad bg-white">
      <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_1fr]">
          <article class="border border-neutral-200 bg-white p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
              RESSOURCES
            </p>
            <h2 class="mt-4 max-w-[12ch] text-[clamp(1.8rem,3vw,3rem)] font-black leading-[0.96] tracking-[-0.04em] text-opus-dark">
              Les insights deviennent des preuves.
            </h2>
            <p class="mt-5 max-w-[58ch] text-sm leading-8 text-neutral-700 md:text-[0.98rem]">
              Capability pack, one-pager exécutif et études de cas structurent la continuité documentaire du site.
            </p>
            <div class="mt-7">
              <a
                href="/ressources"
                class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black"
              >
                Explorer le hub Ressources →
              </a>
            </div>
          </article>

          <article class="border border-neutral-200 bg-neutral-50 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
              CONTACT
            </p>
            <h2 class="mt-4 max-w-[12ch] text-[clamp(1.8rem,3vw,3rem)] font-black leading-[0.96] tracking-[-0.04em] text-opus-dark">
              Passer du signal à la conversation.
            </h2>
            <p class="mt-5 max-w-[58ch] text-sm leading-8 text-neutral-700 md:text-[0.98rem]">
              Quand un besoin émerge, le hub Insights doit pouvoir convertir directement vers un échange cadré.
            </p>
            <div class="mt-7">
              <a
                href="/contact"
                class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black"
              >
                Soumettre un besoin →
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>