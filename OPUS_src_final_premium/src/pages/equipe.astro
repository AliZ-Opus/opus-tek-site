---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/hero/opus-trust-team.png";

const pageTitle = "Équipe — OPUS Technology";
const pageDescription =
  "L’expertise senior n’est pas un slogan, c’est notre modèle de livraison. Découvrez l’équipe OPUS à travers une lecture structurée : vision, rôle et engagement.";

const teamMembers = [
  {
    kicker: "PRÉSIDENT",
    name: "David Banford",
    title: "Président",
    photo: "/assets/team/david-banford.jpg",
    linkedin: "https://www.linkedin.com/in/david-banford/",
    vision:
      "Faire d’OPUS et de PHOENIXX des structures capables de transformer l’ambition technologique en capacité réelle d’exécution, avec une croissance soutenue par la discipline, l’innovation et une lecture claire de la valeur.",
    role:
      "Porter la vision stratégique, structurer l’expansion, aligner les capacités d’affaires et de livraison, et maintenir une trajectoire crédible entre innovation, performance et développement du marché.",
    commitment:
      "Mettre l’expérience entrepreneuriale, la profondeur technologique et la capacité de bâtir à grande échelle au service d’organisations qui attendent plus qu’un fournisseur : un partenaire d’exécution fiable, ambitieux et structuré.",
  },
  {
    kicker: "VICE-PRÉSIDENT ARCHITECTURE ET OPÉRATIONS",
    name: "Ali Zouari",
    title: "Vice-président Architecture et Opérations",
    photo: "/assets/team/ali-zouari.jpg",
    linkedin: "https://www.linkedin.com/in/ali-zouari-05608b5/",
    vision:
      "Concevoir des fondations numériques durables capables d’aligner les besoins d’affaires, les exigences de sécurité, les cadres de gouvernance et les choix technologiques dans des environnements complexes.",
    role:
      "Structurer les architectures cibles, sécuriser les décisions d’intégration, réduire la complexité des écosystèmes TI et créer un point de convergence entre les équipes affaires, produit, TI, les architectes spécialisés et les partenaires technologiques.",
    commitment:
      "Mettre plus de 28 années d’expérience en architecture, gouvernance de solutions et leadership technique au service d’une exécution claire, évolutive et réutilisable, de la stratégie jusqu’à la préparation à l’exploitation.",
  },

  {
    kicker: "RESPONSABLE DU SITE",
    name: "Slim El Mekki",
    title: "Responsable du site OPUS",
    photo: "/assets/team/slim-el-mekki.jpg",
    linkedin: "https://www.linkedin.com/in/med-slim-el-mekki-5b1853127/",
    vision:
      "Faire du site OPUS un espace de crédibilité, de précision et de cohérence, où chaque page soutient la posture expert-to-expert de l’organisation et renforce sa valeur perçue.",
    role:
      "Piloter la cohérence du site, la qualité d’intégration, la clarté du parcours, la présence des preuves et la stabilité d’ensemble entre contenu, présentation et conversion.",
    commitment:
      "Maintenir un environnement numérique net, rigoureux et premium, où l’expérience utilisateur soutient la décision, valorise l’expertise et renforce la confiance.",
  },
    {
    kicker: "DÉVELOPPEMENT DES AFFAIRES",
    name: "Yassine Zouari",
    title: "Développement des affaires — PHOENIXX & OPUS",
    photo: "/assets/team/yassine-zouari.jpg",
    linkedin: "https://www.linkedin.com/in/yassine-zouari-28a27b356/",
    vision:
      "Créer des relations d’affaires fondées sur la clarté, la confiance et une compréhension concrète des priorités client, en reliant les besoins du terrain aux capacités technologiques d’OPUS et de PHOENIXX.",
    role:
      "Qualifier les besoins, structurer les premiers échanges, soutenir le développement commercial et faire le lien entre la valeur recherchée par le client et le modèle d’intervention proposé.",
    commitment:
      "Apporter discipline, responsabilité et qualité relationnelle dans chaque interaction afin que la croissance d’affaires repose sur des bases solides, humaines et crédibles.",
  },
  {
  kicker: "DÉVELOPPEMENT DES AFFAIRES",
  name: "Kamel Saidi",
  title: "Développement des affaires — PHOENIXX & OPUS",
  photo: "/assets/team/kamel-saidi.png",
  linkedin: "https://www.linkedin.com/in/kamel-saidi-251327185/",
  vision:
    "Développer des relations d’affaires durables en reliant lecture du marché, compréhension client et capacité réelle d’exécution, afin de soutenir une croissance crédible dans des environnements technologiques en évolution rapide.",
  role:
    "Identifier les opportunités de croissance, analyser les tendances émergentes, structurer les approches de développement de marché, bâtir des partenariats stratégiques et accompagner les discussions commerciales jusqu’à la conclusion des ententes.",
  commitment:
    "Créer des relations de confiance durables avec les clients, porter une approche consultative orientée solution et transformer les besoins d’affaires en trajectoires de collaboration concrètes, claires et génératrices de valeur.",
}
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Équipe OPUS" class="relative isolate overflow-clip bg-white">
      <div class="mx-auto w-full grid min-h-[80svh] max-h-[760px] max-w-[1680px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[45%_55%] xl:grid-cols-[45%_55%] xl:px-10">
        <div class="relative z-20 flex min-w-0 items-center">
          <div class="relative w-full max-w-[800px] py-8 lg:py-12 lg:pr-12 xl:pr-24">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-y-0 -left-8 right-[-38%] z-0"
              style="
                background: linear-gradient(to right, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0) 100%);
                -webkit-mask-image: linear-gradient(to right, black 42%, transparent 100%);
                mask-image: linear-gradient(to right, black 42%, transparent 100%);
                -webkit-mask-repeat: no-repeat;
                mask-repeat: no-repeat;
                -webkit-mask-size: 100% 100%;
                mask-size: 100% 100%;
              "
            ></div>

            <div class="relative z-10">
              <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500 sm:text-xs">
                ÉQUIPE
              </p>

              <h1 class="max-w-[20ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
                L’expertise senior n’est pas un slogan, c’est notre modèle de livraison.
              </h1>

              <p class="mt-6 max-w-[60ch] text-base leading-8 text-neutral-700 md:text-[1.05rem]">
                OPUS s’appuie sur une logique simple : des rôles lisibles, une responsabilité assumée et une posture
                d’exécution qui reste crédible du premier échange jusqu’au delivery.
              </p>

              <div class="mt-7 h-[2px] w-24 bg-opus-red"></div>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-full min-h-[400px] sm:min-h-[520px] lg:min-h-[560px] xl:mt-0 xl:min-h-[640px]">
          <Image
            src={heroImage}
            alt="Réunion d’équipe illustrant le modèle de livraison OPUS"
            widths={[960, 1280, 1600, 1920]}
            sizes="(max-width: 1023px) 100vw, 55vw"
            format="avif"
            quality={92}
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-center"
            style="opacity: 1 !important;"
          />
        </div>
      </div>
    </section>

    <section class="relative z-30 -mt-[96px] md:-mt-[110px] lg:-mt-[120px]">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="w-full border border-neutral-200 bg-white shadow-[0_18px_50px_rgba(0,0,0,0.08)]">
          <div class="w-full px-6 py-6 md:px-7 md:py-7">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
              STORYTELLING
            </p>

            <h2 class="mt-4 max-w-[18ch] text-[clamp(1.9rem,3.8vw,3.4rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">
              Une lecture humaine, mais structurée.
            </h2>

            <p class="mt-5 max-w-[72ch] text-base leading-8 text-neutral-700">
              Chaque rôle existe pour soutenir la même promesse : une exécution claire, gouvernée et défendable.
            </p>

            <div class="mt-10 w-full grid grid-cols-1 gap-6 lg:grid-cols-2 2xl:grid-cols-4">
              {teamMembers.map((member) => (
                <article class="flex h-full flex-col border border-neutral-200 bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,0.04)] md:p-7">
                  <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-opus-red">
                    {member.kicker}
                  </p>

                  <div class="mt-3 h-[1.75px] w-12 bg-opus-red"></div>

                  <div class="mt-5 overflow-hidden border border-neutral-200 bg-neutral-50">
                    <img
                      src={member.photo}
                      alt={member.name}
                      loading="eager"
                      decoding="async"
                      class="h-auto w-full object-cover object-center"
                    />
                  </div>

                  <h3 class="mt-5 text-[1.08rem] font-semibold leading-6 text-opus-dark">
                    {member.name}
                  </h3>

                  <p class="mt-1 text-sm leading-6 text-neutral-500">
                    {member.title}
                  </p>

                  <div class="mt-4">
                    <a
                      href={member.linkedin}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex items-center text-sm font-medium text-opus-dark underline-offset-4 transition hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
                    >
                      Voir le profil LinkedIn
                    </a>
                  </div>

                  <div class="mt-6 space-y-5">
                    <div>
                      <p class="text-[0.72rem] font-semibold uppercase tracking-[0.2em] text-neutral-500">
                        La Vision
                      </p>
                      <p class="mt-2 text-sm leading-7 text-neutral-700">{member.vision}</p>
                    </div>

                    <div>
                      <p class="text-[0.72rem] font-semibold uppercase tracking-[0.2em] text-neutral-500">
                        Le Rôle
                      </p>
                      <p class="mt-2 text-sm leading-7 text-neutral-700">{member.role}</p>
                    </div>

                    <div>
                      <p class="text-[0.72rem] font-semibold uppercase tracking-[0.2em] text-neutral-500">
                        L’Engagement
                      </p>
                      <p class="mt-2 text-sm leading-7 text-neutral-700">{member.commitment}</p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>