---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import HomeServicesHub from "../components/HomeServicesHub.astro";
import MicroBand from "../components/MicroBand.astro";
import FeaturedInsight from "../components/insights/FeaturedInsight.astro";
import HomeCaseStudiesTeaser from "../components/HomeCaseStudiesTeaser.astro";
import ExecutionModel  from "../components/ExecutionModel.astro";

import bandServices from "../assets/bands/opus-band-services.png";
import bandTrust from "../assets/bands/opus-band-trust.png";

const pageTitle = "OPUS Technology — Architecture, IA, intégration et exécution";
const pageDescription =
  "OPUS Technology accompagne les organisations dans l’architecture, l’intégration, les plateformes et l’intelligence artificielle.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">

  <Hero />

  <ExecutionModel />

  <!-- DELIVERY POSTURE / PROOF -->
  <section aria-label="Preuves et réassurance" class="relative z-20 bg-white pt-10 md:pt-12 mt-10">
    <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
      <div class="grid grid-cols-1 items-stretch overflow-hidden border border-neutral-200 border-t-[1.5px] border-t-opus-red bg-white shadow-[0_16px_50px_rgba(0,0,0,0.06)] lg:grid-cols-4">

<article class="h-full bg-white p-7 lg:border-r lg:border-neutral-200">
  <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
    DELIVERY POSTURE
  </p>

  <div class="mt-5 space-y-2.5 text-sm">
    <div class="border border-neutral-200 px-4 py-2.5 text-opus-dark">
      Delivery-ready
    </div>
    <div class="border border-neutral-200 px-4 py-2.5 text-opus-dark">
      Senior-led
    </div>
    <div class="border border-neutral-200 px-4 py-2.5 text-opus-dark">
      NDA-safe
    </div>
  </div>
</article>

        <article class="overlap-hairline h-full border border-neutral-200 bg-white p-8 shadow-sm">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
            DOCUMENTED
          </p>

          <p class="mt-4 text-5xl font-black text-opus-red">
            12+
          </p>

          <p class="mt-3 text-sm leading-7 text-neutral-700">
            Disciplines de delivery structurées et directement exploitables.
          </p>
        </article>

        <article class="overlap-hairline h-full border border-neutral-200 bg-white p-8 shadow-sm">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
            VERIFIED
          </p>

          <p class="mt-4 text-5xl font-black text-opus-red">
            100%
          </p>

          <p class="mt-3 text-sm leading-7 text-neutral-700">
            Sorties traçables, livrables lisibles, décisions structurées.
          </p>
        </article>

        <article class="overlap-hairline h-full border border-neutral-200 bg-white p-8 shadow-sm">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
            PROOF DISCIPLINE
          </p>

          <p class="mt-4 text-sm leading-7 text-neutral-700">
            Des résultats documentés, structurés et soutenus par une discipline d’exécution senior.
          </p>
        </article>

      </div>
    </div>
  </section>



  <!-- SERVICES (déplacé plus haut pour corriger UX) -->
  <HomeServicesHub />


  <!-- NARRATIVE OPUS -->
  <section class="home-section-pad bg-white">
    <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">

      <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.02fr_.98fr] lg:items-end">

        <div>
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
            OPUS TECHNOLOGY
          </p>

          <h2 class="mt-5 max-w-[12ch] text-[clamp(2.2rem,4.4vw,4.2rem)] font-black leading-[0.94] tracking-[-0.04em] text-opus-dark">
            Une exécution technologique qui inspire confiance.
          </h2>
        </div>

        <div class="max-w-[68ch]">
          <p class="text-base leading-8 text-neutral-700 md:text-[1.02rem]">
            OPUS structure des services, des solutions et des capacités d’exécution pour des contextes où la rigueur n’est pas une option. La forme ne remplace pas le fond : elle le rend visible, lisible et défendable.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">

            <a
              href="/services"
              class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black"
            >
              Explorer les services →
            </a>

            <a
              href="/phoenixx-opus"
              class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white"
            >
              Voir le modèle Phoenixx + OPUS →
            </a>

          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- BAND -->
  <MicroBand
    src={bandServices}
    alt="Execution band"
    height={340}
    slogan="La théorie ne vaut rien sans l’exécution."
    class="my-2"
  />


  <!-- CASE STUDIES -->
  <HomeCaseStudiesTeaser />


  <!-- TRUST BAND -->
  <MicroBand
    src={bandTrust}
    alt="Trust band"
    height={340}
    slogan="Des résultats documentés. Une confiance vérifiée."
    class="my-2"
  />


  <!-- INSIGHTS -->
  <FeaturedInsight />

</main>
</BaseLayout>