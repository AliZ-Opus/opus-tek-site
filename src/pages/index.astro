---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import HomeServicesHub from "../components/HomeServicesHub.astro";
import MicroBand from "../components/MicroBand.astro";
import FeaturedInsight from "../components/insights/FeaturedInsight.astro";
import HomeCaseStudiesTeaser from "../components/HomeCaseStudiesTeaser.astro";
import ExecutionModel from "../components/ExecutionModel.astro";

import bandServices from "../assets/bands/opus-band-services.png";
import bandTrust from "../assets/bands/opus-band-trust.png";

const pageTitle = "OPUS Technology — Architecture, IA, intégration et exécution";
const pageDescription =
  "OPUS transforme des contextes complexes en trajectoires exécutables: cadrage clair, delivery gouverné, preuves lisibles et confiance renforcée.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <Hero />

    <ExecutionModel />

    <section aria-label="Preuves OPUS" class="relative z-20 mt-10 bg-white pt-10 md:pt-12">
      <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 overflow-hidden border border-neutral-200 border-t-[1.5px] border-t-opus-red bg-white shadow-[0_16px_50px_rgba(0,0,0,0.06)] lg:grid-cols-4">
          <article class="h-full bg-white p-7 lg:border-r lg:border-neutral-200">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">PROBLÈME</p>
            <p class="mt-4 text-sm leading-7 text-neutral-700">
              Projets ralentis, responsabilités floues, décisions non documentées.
            </p>
          </article>

          <article class="h-full border border-neutral-200 bg-white p-8 shadow-sm">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">RÉPONSE</p>
            <p class="mt-4 text-sm leading-7 text-neutral-700">
              Cadrage exécutif, architecture opérable et delivery piloté par la preuve.
            </p>
          </article>

          <article class="h-full border border-neutral-200 bg-white p-8 shadow-sm">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">PREUVES</p>
            <p class="mt-4 text-sm leading-7 text-neutral-700">
              Livrables lisibles, décisions tracées, documentation exploitable par vos équipes.
            </p>
          </article>

          <article class="h-full border border-neutral-200 bg-white p-8 shadow-sm">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">CTA</p>
            <a href="/contact" class="mt-4 inline-flex min-h-11 items-center justify-center border border-opus-dark bg-opus-dark px-5 text-sm font-medium text-white transition hover:bg-black">
              Parler de votre projet →
            </a>
          </article>
        </div>
      </div>
    </section>

    <HomeServicesHub />

    <section class="home-section-pad bg-white">
      <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.02fr_.98fr] lg:items-end">
          <div>
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">QUAND OPUS INTERVIENT</p>
            <h2 class="mt-5 max-w-[14ch] text-[clamp(2.2rem,4.4vw,4rem)] font-black leading-[0.94] tracking-[-0.04em] text-opus-dark">
              Quand il faut décider vite sans perdre en rigueur.
            </h2>
          </div>

          <div class="max-w-[64ch]">
            <p class="text-base leading-8 text-neutral-700 md:text-[1.02rem]">
              OPUS intervient pour remettre de la clarté sur le périmètre, les priorités et l’exécution: avant un programme critique, pendant un redressement ou pour industrialiser un passage à l’échelle.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/services" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black">
                Voir les services →
              </a>
              <a href="/phoenixx-opus" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">
                Comprendre Phoenixx ↔ OPUS →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <MicroBand
      src={bandServices}
      alt="Execution band"
      height={340}
      slogan="La théorie ne vaut rien sans l’exécution."
      class="my-2"
    />

    <HomeCaseStudiesTeaser />

    <MicroBand
      src={bandTrust}
      alt="Trust band"
      height={340}
      slogan="Des résultats documentés. Une confiance vérifiée."
      class="my-2"
    />

    <FeaturedInsight />
  </main>
</BaseLayout>
