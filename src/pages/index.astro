---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import MicroBand from "../components/MicroBand.astro";
import HomeCaseStudiesTeaser from "../components/HomeCaseStudiesTeaser.astro";
import ExecutionModel from "../components/ExecutionModel.astro";

import bandServices from "../assets/bands/opus-band-services.png";

const pageTitle = "OPUS Technology - Architecture, IA, intégration et exécution";
const pageDescription =
  "OPUS transforme des contextes complexes en trajectoires exécutables : cadrage clair, delivery gouverné, preuves lisibles et confiance renforcée.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <Hero />

    <section aria-label="Tension, preuve et mécanisme OPUS" class="relative z-20 bg-white py-8 md:py-10">
      <div class="mx-auto max-w-[1720px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 overflow-hidden border border-neutral-200 border-t-[1.5px] border-t-opus-red bg-white shadow-[0_16px_50px_rgba(0,0,0,0.06)] lg:grid-cols-4">
          <article class="h-full bg-white p-5 lg:border-r lg:border-neutral-200">
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">TENSION</p>
            <p class="mt-3 max-w-[24ch] text-sm leading-6 text-neutral-700">
              Quand périmètre, rôles et preuves se désalignent.
            </p>
          </article>

          <article class="h-full border border-neutral-200 bg-white p-5 shadow-sm">
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">PREUVE</p>
            <p class="mt-3 max-w-[22ch] text-sm leading-6 text-neutral-700">
              Décisions traçables, delivery défendable.
            </p>
          </article>

          <article class="h-full border border-neutral-200 bg-white p-5 shadow-sm">
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">MÉCANISME</p>
            <p class="mt-3 max-w-[24ch] text-sm leading-6 text-neutral-700">
              Cadrer, arbitrer, exécuter avec preuve.
            </p>
          </article>

          <article class="h-full border border-neutral-200 bg-white p-5 shadow-sm">
            <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">SUITE</p>
            <p class="mt-3 max-w-[22ch] text-sm leading-6 text-neutral-700">
              Vérifier sur des cas réels.
            </p>
            <a href="/ressources#case-studies" class="mt-4 inline-flex min-h-10 items-center justify-center border border-opus-dark bg-opus-dark px-4 text-sm font-medium text-white transition hover:bg-black">
              Voir les cas
            </a>
          </article>
        </div>
      </div>
    </section>

    <HomeCaseStudiesTeaser />

    <ExecutionModel />

    <MicroBand
      src={bandServices}
      alt="Bande exécution"
      height={260}
      compact
      class="my-1"
    >
      <span>Ce qui compte n'est pas l'intention.</span><br />
      <span>C'est ce qui devient pilotable.</span>
    </MicroBand>

    <section class="bg-white border-t border-neutral-200 py-16 md:py-20">
      <div class="mx-auto max-w-[1720px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[.82fr_1.18fr] lg:items-end">
          <div>
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">SUITE</p>
            <h2 class="mt-4 max-w-[13ch] text-[clamp(2rem,3.7vw,3.45rem)] font-black leading-[0.96] tracking-[-0.04em] text-opus-dark">
              Remettre le sujet en état d'avancer.
            </h2>
          </div>

          <div class="max-w-[58ch]">
            <p class="text-base leading-8 text-neutral-700">
              OPUS intervient quand un sujet important reste trop flou pour être arbitré, gouverné ou exécuté proprement. La prochaine étape : qualifier le besoin et le premier point à remettre au clair.
            </p>
            <div class="mt-7 flex flex-wrap gap-3">
              <a href="/contact" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black">
                Soumettre un besoin
              </a>
              <a href="/ressources#case-studies" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">
                Voir les cas
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
