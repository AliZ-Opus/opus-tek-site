---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import MicroBand from "../components/MicroBand.astro";
import HomeCaseStudiesTeaser from "../components/HomeCaseStudiesTeaser.astro";
import ExecutionModel from "../components/ExecutionModel.astro";

import bandServices from "../assets/bands/opus-band-services.png";
import bandTrust from "../assets/bands/opus-band-trust.png";

const pageTitle = "OPUS Technology - Architecture, IA, intégration et exécution";
const pageDescription =
  "OPUS transforme des contextes complexes en trajectoires exécutables : cadrage clair, delivery gouverné, preuves lisibles et confiance renforcée.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <Hero />

    <section aria-label="Preuves OPUS" class="relative z-20 mt-10 bg-white pt-10 md:pt-12">
      <div class="mx-auto max-w-[1720px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 overflow-hidden border border-neutral-200 border-t-[1.5px] border-t-opus-red bg-white shadow-[0_16px_50px_rgba(0,0,0,0.06)] lg:grid-cols-4">
          <article class="h-full bg-white p-7 lg:border-r lg:border-neutral-200">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">TENSION</p>
            <p class="mt-4 max-w-[24ch] text-sm leading-7 text-neutral-700">
              Les programmes ralentissent quand le périmètre, les rôles et les preuves ne tiennent plus ensemble.
            </p>
          </article>

          <article class="h-full border border-neutral-200 bg-white p-8 shadow-sm">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">PREUVE</p>
            <p class="mt-4 max-w-[24ch] text-sm leading-7 text-neutral-700">
              Lecture propre, décisions traçables, delivery plus défendable.
            </p>
          </article>

          <article class="h-full border border-neutral-200 bg-white p-8 shadow-sm">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">MÉCANISME</p>
            <p class="mt-4 max-w-[26ch] text-sm leading-7 text-neutral-700">
              Cadrage, architecture, intégration, gouvernance et exécution sélective de l'intelligence.
            </p>
          </article>

          <article class="h-full border border-neutral-200 bg-white p-8 shadow-sm">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">CTA</p>
            <a href="/contact" class="mt-4 inline-flex min-h-11 items-center justify-center border border-opus-dark bg-opus-dark px-5 text-sm font-medium text-white transition hover:bg-black">
              Soumettre un besoin
            </a>
          </article>
        </div>
      </div>
    </section>

    <HomeCaseStudiesTeaser />

    <MicroBand
      src={bandServices}
      alt="Bande exécution"
      height={340}
      class="my-2"
    >
      <span>Ce qui compte n'est pas l'intention.</span><br />
      <span>C'est ce qui devient pilotable.</span>
    </MicroBand>

    <ExecutionModel />

    <section class="home-section-pad bg-white border-t border-neutral-200">
      <div class="mx-auto max-w-[1720px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1.02fr_.98fr] lg:items-end">
          <div>
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">NEXT STEP</p>
            <h2 class="mt-5 max-w-[14ch] text-[clamp(2.2rem,4.4vw,4rem)] font-black leading-[0.94] tracking-[-0.04em] text-opus-dark">
              Quand il faut remettre du cadre sans ralentir davantage.
            </h2>
          </div>

          <div class="max-w-[64ch]">
            <p class="text-base leading-8 text-neutral-700 md:text-[1.02rem]">
              Nous intervenons avant un programme critique, pendant une zone de friction ou quand l'exécution doit redevenir lisible pour les décideurs comme pour le delivery.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/contact" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black">
                Soumettre un besoin
              </a>
              <a href="/ressources#case-studies" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">
                Voir les cas
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <MicroBand
      src={bandTrust}
      alt="Bande confiance"
      height={340}
      class="my-2"
    >
      <span>Une exécution défendable</span><br />
      <span>produit une confiance vérifiable.</span>
    </MicroBand>
  </main>
</BaseLayout>
