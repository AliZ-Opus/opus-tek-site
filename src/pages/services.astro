---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeServicesHub from "../components/HomeServicesHub.astro";
import heroImage from "../assets/hero/opus-services.png";

const pageTitle = "Services — OPUS Technology";
const pageDescription =
  "Naviguer par domaines, décider avec preuves, livrer avec contrôle. Explorez les domaines de services OPUS : architecture, ingénierie et intelligence.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Services OPUS" class="relative isolate overflow-clip bg-white">
      <div class="mx-auto w-full grid min-h-[80svh] max-h-[760px] max-w-[1680px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[40%_60%] xl:grid-cols-[40%_60%] xl:px-10">
        <div class="relative z-20 flex min-w-0 items-center">
          <div class="relative w-full max-w-[800px] py-8 lg:py-12 lg:pr-12 xl:pr-24">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-y-0 -left-8 right-[-38%] z-0"
              style="
                background: linear-gradient(to right, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0) 100%);
                -webkit-mask-image: linear-gradient(to right, black 42%, transparent 100%);
                mask-image: linear-gradient(to right, black 42%, transparent 100%);
                -webkit-mask-repeat: no-repeat;
                mask-repeat: no-repeat;
                -webkit-mask-size: 100% 100%;
                mask-size: 100% 100%;
              "
            ></div>

            <div class="relative z-10">
              <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500 sm:text-xs">
                SERVICES
              </p>

              <h1 class="max-w-[26ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
                Naviguer par domaines, décider avec preuves, livrer avec contrôle.
              </h1>

              <p class="mt-6 max-w-[60ch] text-base leading-8 text-neutral-700 md:text-[1.05rem]">
                OPUS structure ses services pour rendre les capacités lisibles, les décisions plus claires
                et l’exécution plus maîtrisée. L’objectif n’est pas d’ajouter du bruit, mais d’offrir un
                cadre simple, crédible et immédiatement exploitable.
              </p>

              <div class="mt-7 h-[2px] w-24 bg-opus-red"></div>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-full min-h-[400px] sm:min-h-[520px] lg:min-h-[560px] xl:mt-0 xl:min-h-[640px]">
          <Image
            src={heroImage}
            alt="Visuel architectural illustrant les domaines de services OPUS"
            widths={[960, 1280, 1600, 1920]}
            sizes="(max-width: 1023px) 100vw, 60vw"
            format="avif"
            quality={92}
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-center"
            style="opacity: 1 !important;"
          />
        </div>
      </div>
    </section>

    <div class="relative z-30 -mt-overlap-force">
      <HomeServicesHub />
    </div>
  </main>
</BaseLayout>