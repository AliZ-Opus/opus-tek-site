---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeServicesHub from "../components/HomeServicesHub.astro";
import heroImage from "../assets/hero/opus-services.png";

const pageTitle = "Services - OPUS Technology";
const pageDescription =
  "Trois lignes d'intervention OPUS pour qualifier un blocage, choisir le bon niveau d'action et orienter la suite.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Services OPUS" class="relative isolate overflow-clip border-b border-neutral-200 bg-white">
      <div class="mx-auto grid min-h-[80svh] max-w-[1720px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[50%_50%] xl:px-10">
        <div class="relative z-20 flex min-w-0 items-center">
          <div class="relative w-full max-w-[900px] py-8 lg:py-10 lg:pr-8 xl:pr-16">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-y-0 -left-8 right-[-28%] z-0"
              style="background: linear-gradient(to right, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.08) 82%, rgba(255,255,255,0) 100%);"
            ></div>

            <div class="relative z-10">
              <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500 sm:text-xs">SERVICES</p>
              <h1 class="max-w-[16ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
                Identifier le bon niveau d'intervention.
              </h1>
              <p class="mt-6 max-w-[42ch] text-base leading-8 text-neutral-700 md:text-[1.05rem]">
                Savoir s'il faut refonder le socle, remettre l'exécution en ligne, ou activer les données et l'IA sans perdre le contrôle.
              </p>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-full min-h-[380px] sm:min-h-[500px] lg:min-h-[540px] xl:mt-0 xl:min-h-[620px]">
          <img
            src={heroImage.src}
            alt="Visuel architectural illustrant les domaines de services OPUS"
            width={heroImage.width}
            height={heroImage.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-center"
            style="opacity: 1 !important;"
          />
        </div>
      </div>
    </section>

    <section aria-label="Orientation Services" class="border-b border-neutral-200 bg-neutral-50 py-8 md:py-10">
      <div class="mx-auto w-full max-w-[1720px] px-4 md:px-8 xl:px-10">
        <p class="max-w-[68ch] text-sm leading-7 text-neutral-700 md:text-base md:leading-8">
          Trois lignes d'intervention : refonder le socle, remettre l'exécution en ligne, ou activer les données et l'IA sous contrôle.
        </p>
      </div>
    </section>

    <section class="relative z-30">
      <HomeServicesHub />
    </section>

    <section class="border-t border-neutral-200 bg-white py-14 md:py-16">
      <div class="mx-auto w-full max-w-[1720px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.05fr_.95fr]">
          <article class="border border-neutral-200 bg-white p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">PREUVE / CAS</p>
            <h2 class="mt-4 max-w-[15ch] text-[clamp(1.7rem,2.8vw,2.7rem)] font-semibold leading-[1] tracking-[-0.03em] text-opus-dark">
              Du diagnostic à la matérialisation.
            </h2>
            <p class="mt-5 text-sm leading-8 text-neutral-700 md:text-[0.98rem]">
              Les cas montrent comment une ligne choisie devient arbitrages, mécanismes de delivery et capacités gouvernées.
            </p>
          </article>
          <article class="border border-neutral-200 bg-neutral-50 p-8 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">SUITE LOGIQUE</p>
            <h2 class="mt-4 max-w-[16ch] text-[clamp(1.55rem,2.2vw,2.25rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-opus-dark">
              Engager le besoin ou confirmer par les cas.
            </h2>
            <p class="mt-5 text-sm leading-8 text-neutral-700 md:text-[0.98rem]">
              Besoin identifié : soumettre. Matérialisation à confirmer : voir les cas.
            </p>
            <div class="mt-6 flex flex-wrap gap-3 border-t border-neutral-200 pt-6">
              <a href="/contact" class="inline-flex min-h-11 items-center justify-center border border-opus-dark bg-opus-dark px-5 text-sm font-medium text-white transition hover:bg-black">
                Soumettre un besoin
              </a>
              <a href="/ressources#case-studies" class="inline-flex min-h-11 items-center justify-center border border-neutral-300 bg-white px-5 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">
                Voir les cas
              </a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
