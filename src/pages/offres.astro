---
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/hero/opus-offres.png";

const pageTitle = "Offres - OPUS Technology";
const pageDescription =
  "Trois offres, un même principe : structurer avant d'accélérer. Découvrez les offres OPUS en architecture, ingénierie et intelligence.";

const offers = [
  {
    label: "01",
    title: "Architecture",
    body:
      "Cadrer les fondations, sécuriser les choix structurants et rendre les trajectoires technologiques lisibles avant toute accélération.",
  },
  {
    label: "02",
    title: "Ingénierie",
    body:
      "Transformer une vision validée en dispositifs concrets, intégrés et livrables, avec une discipline d'exécution claire.",
  },
  {
    label: "03",
    title: "Intelligence",
    body:
      "Mettre les données, les signaux et l'IA au service de décisions plus nettes, d'une gouvernance plus forte et d'une exécution plus pertinente.",
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Offres OPUS" class="relative isolate overflow-clip bg-white">
      <div class="mx-auto w-full grid min-h-[80svh] max-h-[760px] max-w-[1680px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[45%_55%] xl:px-10">
        <div class="relative z-20 flex min-w-0 items-center">
          <div class="relative w-full max-w-[800px] py-8 lg:py-12 lg:pr-12 xl:pr-24">
            <div class="relative z-10">
              <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500 sm:text-xs">
                OFFRES
              </p>
              <h1 class="max-w-[20ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
                Trois offres, un même principe : structurer avant d'accélérer.
              </h1>
              <p class="mt-6 max-w-[62ch] text-base leading-8 text-neutral-700 md:text-[1.05rem]">
                Les offres OPUS donnent une lecture simple : clarifier le socle, reconnecter l'exécution, puis activer l'intelligence quand le cadre tient.
              </p>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-full min-h-[400px] sm:min-h-[520px] lg:min-h-[560px] xl:mt-0 xl:min-h-[640px]">
          <img
            src={heroImage.src}
            alt="Visuel architectural illustrant les offres OPUS"
            width={heroImage.width}
            height={heroImage.height}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-center"
            style="opacity: 1 !important;"
          />
        </div>
      </div>
    </section>

    <section class="relative z-30 -mt-[96px] md:-mt-[110px] lg:-mt-[120px]">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="w-full border border-neutral-200 bg-white shadow-[0_18px_50px_rgba(0,0,0,0.08)]">
          <div class="w-full grid grid-cols-1 divide-y divide-neutral-200 md:grid-cols-3 md:divide-x md:divide-y-0">
            {offers.map((offer) => (
              <article class="p-6 md:p-7">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">{offer.label}</p>
                <div class="mt-3 h-[2px] w-12 bg-opus-red"></div>
                <h2 class="mt-4 text-[1.05rem] font-semibold leading-6 text-opus-dark">{offer.title}</h2>
                <p class="mt-3 text-sm leading-7 text-neutral-700 md:text-[0.98rem]">{offer.body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
