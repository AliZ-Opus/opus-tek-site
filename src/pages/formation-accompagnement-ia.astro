    </section>
    <section class="border-t border-neutral-200 bg-white py-16 md:py-20">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="max-w-[920px]">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">APRÈS LE SONDAGE</p>
          <h2 class="mt-4 max-w-[14ch] text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">Une lecture de marché, puis un déploiement progressif.</h2>
          <p class="mt-6 text-base leading-8 text-neutral-700">Le sondage ne sert pas à décorer la page. Il permet de qualifier la demande, de consolider les retours et de structurer une offre formation + accompagnement à partir d'un socle déjà réel.</p>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-4">
          {afterSurveySteps.map((step, index) => (
            <article class="border border-neutral-200 bg-neutral-50 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
              <p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Étape {index + 1}</p>
              <h3 class="mt-4 text-[1.08rem] font-semibold leading-7 text-opus-dark">{step.title}</h3>
              <p class="mt-4 text-sm leading-7 text-neutral-700">{step.body}</p>
            </article>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#sondage" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white shadow-[0_10px_24px_rgba(0,0,0,0.08)] transition hover:border-black hover:bg-black">Répondre au sondage</a>
          <a href="/contact" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">Soumettre un besoin</a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const form = document.getElementById("formation-ia-survey");
      const feedback = document.getElementById("formation-survey-feedback");
      if (!(form instanceof HTMLFormElement) || !(feedback instanceof HTMLElement)) return;
      const submitButton = form.querySelector('button[type="submit"]');
      const successPanel = document.getElementById("formation-survey-success");
      const rankingPanel = document.getElementById("course-ranking-panel");
      const barrierOtherWrap = document.getElementById("registration-barrier-other-wrap");
      const barrierOtherInput = document.getElementById("registration_barrier_other");
      const courseMap = JSON.parse(form.dataset.courseMap || "{}");

      const getRadioValue = (name) => {
        const field = form.querySelector(`input[name="${name}"]:checked`);
        return field instanceof HTMLInputElement ? field.value : "";
      };

      const getCheckedValues = (name) =>
        Array.from(form.querySelectorAll(`input[name="${name}"]:checked`))
          .filter((field) => field instanceof HTMLInputElement)
          .map((field) => field.value);

      const getSelectValues = (name) =>
        Array.from(form.querySelectorAll(`select[name="${name}"]`))
          .filter((field) => field instanceof HTMLSelectElement)
          .map((field) => field.value)
          .filter(Boolean);

      const refreshBarrierField = () => {
        const show = getRadioValue("registration_barrier") === "Autre (préciser)";
        if (barrierOtherWrap instanceof HTMLElement) barrierOtherWrap.hidden = !show;
        if (!show && barrierOtherInput instanceof HTMLInputElement) barrierOtherInput.value = "";
      };

      const refreshRankingPanel = () => {
        const selectedMba = getRadioValue("selected_mba");
        const selects = Array.from(form.querySelectorAll("select[data-course-rank]"));
        const courses = Array.isArray(courseMap[selectedMba]) ? courseMap[selectedMba] : [];

        if (!(rankingPanel instanceof HTMLElement)) return;
        rankingPanel.hidden = !selectedMba;

        selects.forEach((select) => {
          if (!(select instanceof HTMLSelectElement)) return;
          const previous = select.value;
          select.innerHTML = '<option value="">Choisir un cours</option>';

          courses.forEach((course) => {
            const option = document.createElement("option");
            option.value = course;
            option.textContent = course;
            if (course === previous) option.selected = true;
            select.append(option);
          });

          if (previous && !courses.includes(previous)) select.value = "";
        });
      };

      const validate = () => {
        const requiredRadios = [
          "interest_global",
          "opening_intent",
          "offer_interest",
          "single_option",
          "mba_recognition",
          "international_factor",
          "stage_attractiveness",
          "stage_interest",
          "mba_price_reaction",
          "academy_price_reaction",
          "financing_need",
          "financing_duration",
          "financed_mba_reaction",
          "preferred_format",
          "enrollment_interest",
          "registration_barrier",
        ];

        const missingRadios = requiredRadios.some((name) => !getRadioValue(name));
        if (missingRadios) return "Merci de compléter toutes les questions obligatoires du sondage.";

        const barrier = getRadioValue("registration_barrier");
        const barrierOther = barrierOtherInput instanceof HTMLInputElement ? barrierOtherInput.value.trim() : "";
        if (barrier === "Autre (préciser)" && !barrierOther) {
          return "Merci de préciser le frein principal lorsque vous choisissez “Autre (préciser)”.";
        }

        const selectedMba = getRadioValue("selected_mba");
        const rankedCourses = getSelectValues("ranked_courses");
        const uniqueRankedCourses = [...new Set(rankedCourses)];
        if (selectedMba && rankedCourses.length !== 5) {
          return "Merci de classer les 5 cours du MBA sélectionné ou de laisser cette section optionnelle vide.";
        }
        if (rankedCourses.length > 0 && uniqueRankedCourses.length !== rankedCourses.length) {
          return "Merci de classer 5 cours distincts sans doublon.";
        }
        if (!selectedMba && rankedCourses.length > 0) {
          return "Merci de choisir d’abord l’un des deux MBA avant de classer les cours.";
        }

        return "";
      };

      form.addEventListener("change", (event) => {
        const target = event.target;
        if (target instanceof HTMLInputElement && target.name === "registration_barrier") refreshBarrierField();
        if (target instanceof HTMLInputElement && target.name === "selected_mba") refreshRankingPanel();
      });

      refreshBarrierField();
      refreshRankingPanel();

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const validationMessage = validate();
        if (validationMessage) {
          feedback.textContent = validationMessage;
          return;
        }

        const data = new FormData(form);
        const payload = {
          interest_global: getRadioValue("interest_global"),
          opening_intent: getRadioValue("opening_intent"),
          offer_interest: getRadioValue("offer_interest"),
          single_option: getRadioValue("single_option"),
          mba_recognition: getRadioValue("mba_recognition"),
          international_factor: getRadioValue("international_factor"),
          stage_attractiveness: getRadioValue("stage_attractiveness"),
          stage_interest: getRadioValue("stage_interest"),
          mba_price_reaction: getRadioValue("mba_price_reaction"),
          academy_price_reaction: getRadioValue("academy_price_reaction"),
          financing_need: getRadioValue("financing_need"),
          financing_duration: getRadioValue("financing_duration"),
          financed_mba_reaction: getRadioValue("financed_mba_reaction"),
          preferred_format: getRadioValue("preferred_format"),
          enrollment_interest: getRadioValue("enrollment_interest"),
          program_interests: getCheckedValues("program_interests"),
          selected_mba: getRadioValue("selected_mba"),
          ranked_courses: getSelectValues("ranked_courses"),
          registration_barrier: getRadioValue("registration_barrier"),
          registration_barrier_other: String(data.get("registration_barrier_other") || "").trim(),
          comments: String(data.get("comments") || "").trim(),
          website: String(data.get("website") || "").trim(),
        };

        feedback.textContent = "Envoi en cours...";
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

        try {
          const response = await fetch("/api/airtable/formation-accompagnement-ia", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const result = await response.json().catch(() => ({}));

          if (response.ok && result?.ok) {
            feedback.hidden = true;
            if (successPanel instanceof HTMLElement) successPanel.hidden = false;
            form.querySelectorAll("input, select, textarea, button, a").forEach((element) => {
              if (element instanceof HTMLInputElement || element instanceof HTMLSelectElement || element instanceof HTMLTextAreaElement || element instanceof HTMLButtonElement) {
                element.disabled = true;
              }
            });
            form.reset();
            refreshBarrierField();
            refreshRankingPanel();
            return;
          }

          if (result?.error === "missing_barrier_other") {
            feedback.textContent = "Merci de préciser le frein principal lorsque vous choisissez “Autre (préciser)”.";
            return;
          }

          if (result?.error === "missing_selected_mba") {
            feedback.textContent = "Merci de choisir d’abord l’un des deux MBA avant de classer les cours.";
            return;
          }

          if (result?.error === "invalid_ranking") {
            feedback.textContent = "Merci de classer les 5 cours du MBA sélectionné sans doublon.";
            return;
          }

          feedback.textContent = "Impossible d'envoyer le sondage pour le moment. Vous pouvez aussi écrire à contact@opus-tek.ca.";
        } catch {
          feedback.textContent = "Erreur réseau. Réessayez dans quelques instants ou écrivez à contact@opus-tek.ca.";
        } finally {
          if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        }
      });
    })();
  </script>

</BaseLayout>






