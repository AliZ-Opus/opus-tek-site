---
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/hero/opus-formation-ia-executive.png";
import {
  accompanimentTracks,
  afterSurveySteps,
  credibilityMetrics,
  credibilityNotes,
  formationAxes,
  formationHero,
  formatOptions,
  interestOptions,
  levelOptions,
  mbaPrograms,
  operatingStates,
  partnershipFrame,
  profileOptions,
  surveyFraming,
  surveyProgress,
  timelineOptions,
  topicOptions,
} from "../data/formationAi";
---

<BaseLayout title={formationHero.pageTitle} description={formationHero.pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Formation et accompagnement IA" class="relative isolate overflow-clip border-b border-neutral-200 bg-white">
      <div class="mx-auto grid min-h-[74svh] max-w-[1720px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[58%_42%] xl:px-10">
        <div class="relative z-20 flex min-w-0 items-center">
          <div class="relative w-full max-w-[980px] py-8 lg:py-10 lg:pr-8 xl:pr-14">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-y-0 -left-8 right-[-24%] z-0"
              style="background: linear-gradient(to right, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0.08) 82%, rgba(255,255,255,0) 100%);"
            ></div>

            <div class="relative z-10">
              <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">{formationHero.kicker}</p>
              <h1 class="max-w-[13ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">{formationHero.title}</h1>
              <p class="mt-6 max-w-[72ch] text-base leading-8 text-neutral-700 md:text-[1.04rem]">{formationHero.intro}</p>

              <div class="mt-8 flex flex-wrap gap-3">
                <a href="#sondage" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white shadow-[0_10px_24px_rgba(0,0,0,0.08)] transition hover:border-black hover:bg-black">RÃ©pondre au sondage</a>
                <a href="#mba-programmes" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">Voir les MBA</a>
                <a href="/contact" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">Soumettre un besoin</a>
              </div>

              <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
                <div class="border border-neutral-200 bg-white px-4 py-4 shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
                  <p class="text-[0.66rem] font-semibold uppercase tracking-[0.2em] text-neutral-500">DÃ‰JÃ€ OPÃ‰RÃ‰</p>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">Deux MBA IA dÃ©jÃ  opÃ©rÃ©s au BrÃ©sil via Phoenixx.</p>
                </div>
                <div class="border border-neutral-200 bg-white px-4 py-4 shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
                  <p class="text-[0.66rem] font-semibold uppercase tracking-[0.2em] text-neutral-500">EN STRUCTURATION</p>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">Extension formation + accompagnement structurÃ©e par OPUS et Phoenixx.</p>
                </div>
                <div class="border border-neutral-200 bg-white px-4 py-4 shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
                  <p class="text-[0.66rem] font-semibold uppercase tracking-[0.2em] text-neutral-500">POINT D'ENTRÃ‰E</p>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">Le sondage sert Ã  qualifier la demande avant de dÃ©ployer davantage.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-full min-h-[360px] sm:min-h-[460px] lg:mt-0 lg:min-h-[560px] xl:min-h-[620px]">
          <img src={heroImage.src} alt="Équipe et environnement de travail illustrant le volet formation et accompagnement IA" width={heroImage.width} height={heroImage.height} loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover object-center" style="opacity: 1 !important;" />
        </div>
      </div>
    </section>

    <section class="relative z-30 mt-6 md:mt-8 lg:mt-10">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="border border-neutral-200 bg-white shadow-[0_18px_50px_rgba(0,0,0,0.08)]">
          <div class="grid grid-cols-1 divide-y divide-neutral-200 xl:grid-cols-[1.1fr_.9fr] xl:divide-x xl:divide-y-0">
            <div class="px-6 py-6 md:px-7 md:py-7">
              <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">BLOC DE CRÃ‰DIBILITÃ‰</p>
              <h2 class="mt-4 max-w-[14ch] text-[clamp(1.9rem,3.6vw,3.1rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">Une base dÃ©jÃ  rÃ©elle, pas une promesse abstraite.</h2>
              <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-4">
                {credibilityMetrics.map((item) => (
                  <article class="border border-neutral-200 bg-white px-4 py-5">
                    <p class="text-[1.75rem] font-semibold leading-none tracking-[-0.04em] text-opus-red">{item.value}</p>
                    <p class="mt-3 text-sm leading-6 text-neutral-700">{item.label}</p>
                  </article>
                ))}
              </div>
            </div>

            <div class="px-6 py-6 md:px-7 md:py-7">
              <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">CE QUE CETTE PREUVE PORTE</p>
              <div class="mt-6 space-y-4">
                {credibilityNotes.map((item) => (
                  <div class="flex gap-3 border-b border-neutral-200 pb-4 last:border-b-0 last:pb-0">
                    <span class="mt-[0.8rem] h-[2px] w-4 shrink-0 bg-opus-red"></span>
                    <p class="text-sm leading-7 text-neutral-700">{item}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-14 md:py-18">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="max-w-[920px]">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">LECTURE DE POSITIONNEMENT</p>
          <h2 class="mt-4 max-w-[15ch] text-[clamp(1.9rem,3.8vw,3.3rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">Ce qui est dÃ©jÃ  rÃ©el, ce qui se structure maintenant, ce qui dÃ©pend encore du marchÃ©.</h2>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-3">
          {operatingStates.map((item) => (
            <article class="border border-neutral-200 bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">{item.label}</p>
              <div class="mt-4 h-[2px] w-12 bg-opus-red"></div>
              <h3 class="mt-4 text-[1.16rem] font-semibold leading-7 text-opus-dark">{item.title}</h3>
              <p class="mt-4 text-sm leading-7 text-neutral-700">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-neutral-200 bg-neutral-50 py-14 md:py-18">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="max-w-[920px]">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">NOS AXES DE FORMATION</p>
          <h2 class="mt-4 max-w-[15ch] text-[clamp(1.9rem,3.8vw,3.3rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">Une offre lisible, sans confondre l'existant, le structurable et le futur.</h2>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-5">
          {formationAxes.map((item) => (
            <article class="border border-neutral-200 bg-white p-5 shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
              <p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-opus-red">{item.label}</p>
              <h3 class="mt-4 text-[1.02rem] font-semibold leading-6 text-opus-dark">{item.title}</h3>
              <p class="mt-3 text-sm leading-7 text-neutral-700">{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="mba-programmes" class="border-t border-neutral-200 bg-white py-16 md:py-20">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-8 xl:grid-cols-[minmax(0,1fr)_minmax(360px,460px)] xl:items-center">
          <div class="max-w-[920px]">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">DEUX MBA DÃ‰JÃ€ OPÃ‰RATIONNELS</p>
            <h2 class="mt-4 max-w-[14ch] text-[clamp(2rem,4vw,3.5rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">Deux programmes dÃ©jÃ  opÃ©rÃ©s au BrÃ©sil, prÃ©sentÃ©s comme preuves concrÃ¨tes.</h2>
          </div>
          <div class="xl:justify-self-end">
            <div class="max-w-[46ch] border border-neutral-200 bg-neutral-50 px-6 py-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)] md:px-7">
              <p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">LECTURE DE PREUVE</p>
              <div class="mt-4 h-[2px] w-12 bg-opus-red"></div>
              <p class="mt-4 text-base leading-8 text-neutral-700">Les programmes ne sont pas exposÃ©s comme des maquettes acadÃ©miques. Ils sont prÃ©sentÃ©s comme des formats dÃ©jÃ  opÃ©rÃ©s, utiles pour montrer le niveau de maturitÃ© et la nature de la proposition.</p>
            </div>
          </div>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 xl:grid-cols-2">
          {mbaPrograms.map((program) => (
            <article class="border border-neutral-200 bg-white p-7 shadow-[0_12px_34px_rgba(0,0,0,0.04)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">MBA OPÃ‰RÃ‰ AU BRÃ‰SIL</p>
              <div class="mt-4 h-[2px] w-14 bg-opus-red"></div>
              <h3 class="mt-5 text-[1.5rem] font-semibold leading-tight text-opus-dark">{program.title}</h3>
              <p class="mt-3 text-[1rem] leading-7 text-neutral-700">{program.subtitle}</p>

              <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
                <div>
                  <p class="text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-neutral-500">POSITIONNEMENT</p>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">{program.positioning}</p>
                </div>
                <div>
                  <p class="text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-neutral-500">PUBLIC CIBLE</p>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">{program.audience}</p>
                </div>
              </div>

              <div class="mt-6 border-t border-neutral-200 pt-6">
                <p class="text-[0.66rem] font-semibold uppercase tracking-[0.18em] text-neutral-500">COMPETENCES DEVELOPPEES</p>
                <ul class="mt-4 space-y-3 text-neutral-700">
                  {program.skills.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-[0.85rem] h-[2px] w-4 shrink-0 bg-opus-red"></span>
                      <span class="text-sm leading-7">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-3">
                <div class="border border-neutral-200 bg-neutral-50 px-4 py-4">
                  <p class="text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-neutral-500">TECHNOLOGIES</p>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">{program.technologies}</p>
                </div>
                <div class="border border-neutral-200 bg-neutral-50 px-4 py-4">
                  <p class="text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-neutral-500">BENEFICE CARRIERE</p>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">{program.career}</p>
                </div>
                <div class="border border-neutral-200 bg-neutral-50 px-4 py-4">
                  <p class="text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-neutral-500">FORMAT & RECONNAISSANCE</p>
                  <p class="mt-2 text-sm leading-7 text-neutral-700">{program.format} {program.recognition}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="accompagnement" class="border-t border-neutral-200 bg-neutral-50 py-16 md:py-20">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[.95fr_1.05fr]">
          <div class="max-w-[720px]">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">ACCOMPAGNEMENT</p>
            <h2 class="mt-4 max-w-[14ch] text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">Une logique qui ne s'arrÃªte pas Ã  la formation acadÃ©mique.</h2>
            <p class="mt-6 text-base leading-8 text-neutral-700">OPUS peut accompagner des entreprises, des Ã©quipes TI, des leaders et des organisations en transformation quand il faut monter en compÃ©tence, cadrer des usages IA, structurer un parcours ou rendre un dispositif plus exÃ©cutable.</p>
            <div class="mt-8 border-l-2 border-opus-red pl-5">
              <p class="text-sm leading-7 text-neutral-700">La continuitÃ© recherchÃ©e est simple : formation, employabilitÃ©, accompagnement et transformation appliquÃ©e doivent tenir dans une seule logique lisible.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            {accompanimentTracks.map((item) => (
              <article class="border border-neutral-200 bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
                <h3 class="text-[1.08rem] font-semibold leading-7 text-opus-dark">{item.title}</h3>
                <p class="mt-4 text-sm leading-7 text-neutral-700">{item.body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-neutral-200 bg-white py-16 md:py-20">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="max-w-[920px]">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">PARTENARIATS STRATÃ‰GIQUES</p>
          <h2 class="mt-4 max-w-[14ch] text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">{partnershipFrame.title}</h2>
          <p class="mt-6 text-base leading-8 text-neutral-700">{partnershipFrame.intro}</p>
        </div>

        <div class="mt-8 border border-neutral-200 bg-neutral-50 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)] md:p-7">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">PREUVE OPÃ‰RATIONNELLE</p>
          <h3 class="mt-4 text-[1.2rem] font-semibold leading-7 text-opus-dark">Phoenixx, point d'appui rÃ©el du dispositif</h3>
          <p class="mt-4 text-sm leading-7 text-neutral-700">{partnershipFrame.phoenixx}</p>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-2">
          {partnershipFrame.partners.map((item) => (
            <article class="border border-neutral-200 bg-white p-7 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">{item.name}</p>
              <div class="mt-4 h-[2px] w-14 bg-opus-red"></div>
              <h3 class="mt-5 text-[1.2rem] font-semibold leading-7 text-opus-dark">{item.title}</h3>
              <p class="mt-4 text-sm leading-7 text-neutral-700">{item.body}</p>
            </article>
          ))}
        </div>

        <p class="mt-8 max-w-[72ch] text-base leading-8 text-neutral-700">{partnershipFrame.synthesis}</p>
      </div>
    </section>

    <section id="sondage" class="border-t border-neutral-200 bg-neutral-50 py-16 md:py-20">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-8 xl:grid-cols-[.86fr_1.14fr]">
          <div class="max-w-[720px]">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">SONDAGE / Ã‰TUDE DE MARCHÃ‰</p>
            <h2 class="mt-4 max-w-[14ch] text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">{surveyFraming.title}</h2>
            <p class="mt-6 text-base leading-8 text-neutral-700">{surveyFraming.intro}</p>

            <div class="mt-8 space-y-4">
              {surveyFraming.bullets.map((item) => (
                <div class="flex gap-3 border-b border-neutral-200 pb-4 last:border-b-0 last:pb-0">
                  <span class="mt-[0.85rem] h-[2px] w-4 shrink-0 bg-opus-red"></span>
                  <p class="text-sm leading-7 text-neutral-700">{item}</p>
                </div>
              ))}
            </div>

            <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4">
              {surveyProgress.map((item, index) => (
                <div class="border border-neutral-200 bg-white px-4 py-4 text-center shadow-[0_8px_24px_rgba(0,0,0,0.03)]">
                  <p class="text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-neutral-500">Ã‰tape {index + 1}</p>
                  <p class="mt-2 text-sm leading-6 text-opus-dark">{item}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="border border-neutral-200 bg-white p-6 shadow-[0_18px_50px_rgba(0,0,0,0.08)] md:p-8 xl:p-10">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">FORMULAIRE DE QUALIFICATION</p>
            <h3 class="mt-4 text-[clamp(1.5rem,2.8vw,2.4rem)] font-semibold leading-[1.02] text-opus-dark">Qualifier la demande avant de structurer l'offre.</h3>
            <p class="mt-4 text-sm leading-7 text-neutral-700 md:text-[0.98rem]">Le formulaire est branchÃ© Ã  une route API exploitable. La surface est finale, et la capture est dÃ©jÃ  structurÃ©e pour consolidation de marchÃ©.</p>

            <form id="formation-ia-survey" class="mt-8 space-y-8" novalidate>
              <section class="space-y-5">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Ã‰TAPE 1 - PROFIL</p>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                  <div><label for="full_name" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Nom complet</label><input id="full_name" name="full_name" type="text" required class="min-h-12 w-full border border-neutral-200 bg-neutral-50 px-4 text-sm text-opus-dark outline-none transition focus:border-opus-red" placeholder="Nom et prÃ©nom" /></div>
                  <div><label for="email" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Courriel</label><input id="email" name="email" type="email" required class="min-h-12 w-full border border-neutral-200 bg-neutral-50 px-4 text-sm text-opus-dark outline-none transition focus:border-opus-red" placeholder="vous@organisation.com" /></div>
                </div>
                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                  <div><label for="country_region" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Pays / region</label><input id="country_region" name="country_region" type="text" required class="min-h-12 w-full border border-neutral-200 bg-neutral-50 px-4 text-sm text-opus-dark outline-none transition focus:border-opus-red" placeholder="Tunisie, Quebec, Bresil, Afrique du Nord..." /></div>
                  <div><label for="profile_type" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Profil professionnel</label><select id="profile_type" name="profile_type" required class="min-h-12 w-full border border-neutral-200 bg-neutral-50 px-4 text-sm text-opus-dark outline-none transition focus:border-opus-red"><option value="">Selectionner un profil</option>{profileOptions.map((item) => <option value={item}>{item}</option>)}</select></div>
                </div>
                <div><label for="current_level" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Niveau actuel en IA / data / cloud</label><select id="current_level" name="current_level" required class="min-h-12 w-full border border-neutral-200 bg-neutral-50 px-4 text-sm text-opus-dark outline-none transition focus:border-opus-red"><option value="">Selectionner un niveau</option>{levelOptions.map((item) => <option value={item}>{item}</option>)}</select></div>
              </section>

              <section class="space-y-5 border-t border-neutral-200 pt-8">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Ã‰TAPE 2 - INTÃ‰RÃŠTS</p>
                <fieldset>
                  <legend class="mb-3 text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Interet principal</legend>
                  <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-3">
                    {interestOptions.map((item) => (
                      <label class="flex cursor-pointer items-start gap-3 border border-neutral-200 bg-white px-4 py-4 text-sm leading-7 text-neutral-700 transition hover:border-opus-dark/30">
                        <input type="radio" name="interest_main" value={item} class="mt-1 h-4 w-4 accent-[var(--color-opus-red)]" required />
                        <span>{item}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>

                <fieldset>
                  <legend class="mb-3 text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">ThÃ©matiques prioritaires</legend>
                  <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
                    {topicOptions.map((item) => (
                      <label class="flex cursor-pointer items-start gap-3 border border-neutral-200 bg-white px-4 py-4 text-sm leading-7 text-neutral-700 transition hover:border-opus-dark/30">
                        <input type="checkbox" name="priority_topics" value={item} class="mt-1 h-4 w-4 accent-[var(--color-opus-red)]" />
                        <span>{item}</span>
