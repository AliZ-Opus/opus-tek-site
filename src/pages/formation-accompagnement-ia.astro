  <script is:inline>
    (() => {
      const form = document.getElementById("formation-ia-survey");
      const feedback = document.getElementById("formation-survey-feedback");
      if (!(form instanceof HTMLFormElement) || !(feedback instanceof HTMLElement)) return;
      const submitButton = form.querySelector('button[type="submit"]');
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      const parseName = (fullName) => {
        const value = fullName.trim().replace(/\s+/g, " ");
        if (!value) return { firstName: "", lastName: "" };
        const parts = value.split(" ");
        if (parts.length === 1) return { firstName: parts[0], lastName: "" };
        return { firstName: parts.slice(0, -1).join(" "), lastName: parts.slice(-1).join(" ") };
      };

      const getRadioValue = (name) => {
        const field = form.querySelector(`input[name="${name}"]:checked`);
        return field instanceof HTMLInputElement ? field.value : "";
      };

      const getCheckedValues = (name) =>
        Array.from(form.querySelectorAll(`input[name="${name}"]:checked`))
          .filter((field) => field instanceof HTMLInputElement)
          .map((field) => field.value);

      const validate = () => {
        const data = new FormData(form);
        const requiredText = ["full_name", "email", "country_region", "profile_type", "current_level"];
        const missingText = requiredText.some((name) => !String(data.get(name) || "").trim());
        const missingRadios = ["interest_main", "format_preference", "start_timeline"].some((name) => !getRadioValue(name));
        const missingTopics = getCheckedValues("priority_topics").length === 0;
        const email = String(data.get("email") || "").trim();
        const invalidEmail = email ? !emailRegex.test(email) : false;

        if (invalidEmail) {
          feedback.textContent = "Merci de fournir une adresse courriel valide.";
          return false;
        }

        return !(missingText || missingRadios || missingTopics);
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        if (!validate()) {
          feedback.textContent = "Merci de complÃ©ter les champs requis et de choisir au moins une thÃ©matique prioritaire.";
          return;
        }

        const data = new FormData(form);
        const { firstName, lastName } = parseName(String(data.get("full_name") || ""));
        const payload = {
          first_name: firstName,
          last_name: lastName,
          email: String(data.get("email") || "").trim(),
          country_region: String(data.get("country_region") || "").trim(),
          profile_type: String(data.get("profile_type") || "").trim(),
          current_level: String(data.get("current_level") || "").trim(),
          interest_main: getRadioValue("interest_main"),
          priority_topics: getCheckedValues("priority_topics"),
          format_preference: getRadioValue("format_preference"),
          start_timeline: getRadioValue("start_timeline"),
          comments: String(data.get("comments") || "").trim(),
          website: String(data.get("website") || "").trim(),
        };

        feedback.textContent = "Envoi en cours...";
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

        try {
          const response = await fetch("/api/airtable/formation-accompagnement-ia", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const result = await response.json().catch(() => ({}));

          if (response.ok && result?.ok) {
            feedback.textContent = "Sondage envoye. Les retours seront consolides pour structurer la suite du dispositif.";
            form.reset();
            return;
          }

          if (result?.error === "invalid_email") {
            feedback.textContent = "Merci de fournir une adresse courriel valide.";
            return;
          }

          if (result?.error === "missing_topics") {
            feedback.textContent = "Choisissez au moins une thÃ©matique prioritaire.";
            return;
          }

          feedback.textContent = "Impossible d'envoyer le sondage pour le moment. Vous pouvez aussi Ã©crire Ã  contact@opus-tek.ca.";
        } catch {
          feedback.textContent = "Erreur rÃ©seau. RÃ©essayez dans quelques instants ou Ã©crivez Ã  contact@opus-tek.ca.";
        } finally {
          if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        }
      });
    })();
  </script>
</BaseLayout>



