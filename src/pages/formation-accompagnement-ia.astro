        <div class="max-w-[920px]">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">APRÃˆS LE SONDAGE</p>
          <h2 class="mt-4 max-w-[14ch] text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">Une lecture de marchÃ©, puis un dÃ©ploiement progressif.</h2>
          <p class="mt-6 text-base leading-8 text-neutral-700">Le sondage ne sert pas Ã  dÃ©corer la page. Il permet de qualifier la demande, de consolider les retours et de structurer une offre formation + accompagnement Ã  partir d'un socle dÃ©jÃ  rÃ©el.</p>
        </div>

        <div class="mt-8 grid grid-cols-1 gap-5 lg:grid-cols-4">
          {afterSurveySteps.map((step, index) => (
            <article class="border border-neutral-200 bg-neutral-50 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
              <p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Ã‰tape {index + 1}</p>
              <h3 class="mt-4 text-[1.08rem] font-semibold leading-7 text-opus-dark">{step.title}</h3>
              <p class="mt-4 text-sm leading-7 text-neutral-700">{step.body}</p>
            </article>
          ))}
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#sondage" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white shadow-[0_10px_24px_rgba(0,0,0,0.08)] transition hover:border-black hover:bg-black">RÃ©pondre au sondage</a>
          <a href="/contact" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">Soumettre un besoin</a>
        </div>
