                  </div>
                </fieldset>

                <fieldset>
                  <legend class="mb-3 text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Horizon de dÃ©marrage</legend>
                  <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
                    {timelineOptions.map((item) => (
                      <label class="flex cursor-pointer items-start gap-3 border border-neutral-200 bg-white px-4 py-4 text-sm leading-7 text-neutral-700 transition hover:border-opus-dark/30">
                        <input type="radio" name="start_timeline" value={item} class="mt-1 h-4 w-4 accent-[var(--color-opus-red)]" required />
                        <span>{item}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              </section>

              <section class="space-y-5 border-t border-neutral-200 pt-8">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Ã‰TAPE 4 - COMMENTAIRE</p>
                <div><label for="comments" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Commentaires libres / attentes / besoins</label><textarea id="comments" name="comments" rows="6" class="w-full border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm leading-7 text-opus-dark outline-none transition placeholder:text-neutral-400 focus:border-opus-red" placeholder="DÃ©crivez vos attentes, votre contexte, votre besoin de formation ou d'accompagnement."></textarea></div>
              </section>

              <div class="hidden" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>

              <p id="formation-survey-feedback" role="status" aria-live="polite" class="rounded-none border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700">Reponse courte, puis consolidation des retours pour structurer la suite.</p>

              <div class="flex flex-wrap gap-3">
                <button type="submit" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white shadow-[0_10px_24px_rgba(0,0,0,0.08)] transition hover:border-black hover:bg-black">RÃ©pondre au sondage</button>
                <a href="#accompagnement" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">Voir l'accompagnement</a>
