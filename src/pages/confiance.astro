---
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/hero/opus-confiance.png";

const pageTitle = "Confiance - OPUS Technology";
const pageDescription =
  "Confidentialité, propriété intellectuelle, gouvernance et facturation : un cadre lisible pour réduire le risque perçu.";

const sections = [
  {
    id: "confidentialite",
    eyebrow: "GARANTIE",
    title: "Confidentialité",
    intro:
      "L'information sensible circule au bon niveau, pour la bonne utilité, sans exposition inutile.",
    cards: [
      { label: "CADRE", title: "Diffusion limitée", body: "Les éléments sensibles, livrables de cadrage et arbitrages ne circulent pas par défaut. L'accès reste utile, ciblé et défendable." },
      { label: "EFFET", title: "Moins d'exposition inutile", body: "Le client sait mieux qui voit quoi, quand et pourquoi. La confidentialité devient une discipline de travail, pas une formule." },
    ],
  },
  {
    id: "ip",
    eyebrow: "GARANTIE",
    title: "IP",
    intro:
      "Ce qui est livré, réutilisable ou préexistant reste distingué dès le mandat.",
    cards: [
      { label: "CADRE", title: "Livrables lisibles", body: "OPUS distingue les livrables client, artefacts de mission, composants réutilisables et savoir-faire propre." },
      { label: "EFFET", title: "Droits plus soutenables", body: "La suite du mandat se comprend mieux : usage, transfert, modification et continuité restent dans un cadre explicite." },
    ],
  },
  {
    id: "gouvernance",
    eyebrow: "GARANTIE",
    title: "Gouvernance",
    intro:
      "Les arbitrages, validations et changements restent visibles sans ajouter de lourdeur.",
    cards: [
      { label: "CADRE", title: "Décisions traçables", body: "Qui arbitre, qui valide et comment un changement est absorbé ne restent pas implicites." },
      { label: "EFFET", title: "Moins de rework", body: "La gouvernance réduit les malentendus et garde l'exécution cohérente quand les priorités évoluent." },
    ],
  },
  {
    id: "facturation",
    eyebrow: "GARANTIE",
    title: "Facturation",
    intro:
      "Le cadre économique suit la logique réelle du mandat et reste compréhensible.",
    cards: [
      { label: "CADRE", title: "Modalités explicites", body: "Type d'engagement, rythme, livrables de référence et ajustements possibles sont clarifiés sans surcharger le mandat." },
      { label: "EFFET", title: "Moins de friction financière", body: "Le client comprend ce qui est facturé, pourquoi et selon quelle logique. La relation reste plus stable." },
    ],
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Confiance OPUS" class="relative isolate overflow-clip border-b border-neutral-200 bg-white">
      <div class="mx-auto grid min-h-[80svh] max-h-[760px] max-w-[1680px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[45%_55%] xl:px-10">
        <div class="relative z-20 flex min-w-0 items-center">
          <div class="relative w-full max-w-[800px] py-8 lg:py-12 lg:pr-12 xl:pr-24">
            <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 -left-8 right-[-38%] z-0" style="background: linear-gradient(to right, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0) 100%); -webkit-mask-image: linear-gradient(to right, black 42%, transparent 100%); mask-image: linear-gradient(to right, black 42%, transparent 100%); -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-size: 100% 100%; mask-size: 100% 100%;"></div>

            <div class="relative z-10">
              <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">CONFIANCE</p>
              <h1 class="max-w-[18ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
                La confiance tient d'abord à la discipline de travail.
              </h1>
              <p class="mt-6 max-w-[60ch] text-base leading-8 text-neutral-700 md:text-[1.02rem]">
                Confidentialité, droits, gouvernance et cadre économique : quatre garanties tenues sobrement pour réduire le risque perçu.
              </p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href="/contact" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black">Soumettre un besoin</a>
                <a href="/ressources#case-studies" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">Voir les cas</a>
              </div>
              <div class="mt-6 h-[2px] w-20 bg-opus-red"></div>
              <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-neutral-600">
                <span class="inline-flex items-center gap-2"><span class="h-[2px] w-4 bg-opus-red"></span>Diffusion contrôlée</span>
                <span class="inline-flex items-center gap-2"><span class="h-[2px] w-4 bg-opus-red"></span>Rigueur documentaire</span>
                <span class="inline-flex items-center gap-2"><span class="h-[2px] w-4 bg-opus-red"></span>Arbitrages traçables</span>
              </div>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-full min-h-[400px] sm:min-h-[520px] lg:min-h-[560px] xl:mt-0 xl:min-h-[640px]">
          <img src={heroImage.src} alt="Visuel architectural illustrant la confiance, la gouvernance et la discipline d'exécution" width={heroImage.width} height={heroImage.height} loading="eager" fetchpriority="high" decoding="async" class="absolute inset-0 h-full w-full object-cover object-center" style="opacity: 1 !important;" />
        </div>
      </div>
    </section>

    <section class="relative z-30 -mt-[64px] border-t border-neutral-200 bg-white py-8 md:-mt-[76px] md:py-10 lg:-mt-[84px]">
      <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
          <article class="border border-neutral-200 bg-white p-4 shadow-[0_10px_30px_rgba(0,0,0,0.03)]"><p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">CONFIDENTIALITÉ</p><h2 class="mt-3 text-[1rem] font-semibold leading-6 text-opus-dark">Diffusion limitée</h2><p class="mt-2 text-sm leading-6 text-neutral-700">Les informations sensibles restent dans le bon circuit.</p></article>
          <article class="border border-neutral-200 bg-white p-4 shadow-[0_10px_30px_rgba(0,0,0,0.03)]"><p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">IP</p><h2 class="mt-3 text-[1rem] font-semibold leading-6 text-opus-dark">Droits clarifiés</h2><p class="mt-2 text-sm leading-6 text-neutral-700">Livrables, artefacts et savoir-faire restent distingués.</p></article>
          <article class="border border-neutral-200 bg-white p-4 shadow-[0_10px_30px_rgba(0,0,0,0.03)]"><p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">GOUVERNANCE</p><h2 class="mt-3 text-[1rem] font-semibold leading-6 text-opus-dark">Arbitrages traçables</h2><p class="mt-2 text-sm leading-6 text-neutral-700">Décisions et changements restent lisibles.</p></article>
          <article class="border border-neutral-200 bg-white p-4 shadow-[0_10px_30px_rgba(0,0,0,0.03)]"><p class="text-[0.66rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">FACTURATION</p><h2 class="mt-3 text-[1rem] font-semibold leading-6 text-opus-dark">Cadre économique net</h2><p class="mt-2 text-sm leading-6 text-neutral-700">Rythme, livrables et ajustements restent compréhensibles.</p></article>
        </div>
      </div>
    </section>

    <section class="border-t border-neutral-200 bg-white py-10 md:py-12">
      <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
          {sections.map((section) => (
            <article id={section.id} class="scroll-mt-32 border border-neutral-200 bg-white p-5 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">{section.eyebrow}</p>
              <h2 class="mt-3 text-[1.18rem] font-semibold leading-7 text-opus-dark">{section.title}</h2>
              <p class="mt-3 text-sm leading-7 text-neutral-700">{section.intro}</p>
              <div class="mt-5 space-y-4 border-t border-neutral-200 pt-5">
                {section.cards.map((card) => (
                  <div>
                    <p class="text-[0.66rem] font-semibold uppercase tracking-[0.2em] text-neutral-500">{card.label}</p>
                    <h3 class="mt-2 text-[0.98rem] font-semibold leading-6 text-opus-dark">{card.title}</h3>
                    <p class="mt-2 text-sm leading-6 text-neutral-700">{card.body}</p>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-neutral-200 bg-neutral-50 py-8 md:py-10">
      <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-[.9fr_1.1fr]">
          <div class="max-w-[680px]">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">CONTINUITÉ</p>
            <h2 class="mt-3 max-w-[18ch] text-[clamp(1.45rem,2vw,2rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-opus-dark">
              Un cadre stable, une exécution attribuable.
            </h2>
          </div>

          <p class="max-w-[70ch] text-sm leading-7 text-neutral-700 md:text-[0.98rem]">
            Un point d'entrée lisible, un cadre commercial stable et un delivery attribuable réduisent la zone grise entre engagement et exécution.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-neutral-200 bg-white py-10 md:py-12">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-[1.1fr_.9fr]">
          <article class="border border-neutral-200 bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">SUITE</p>
            <h2 class="mt-3 max-w-[18ch] text-[clamp(1.45rem,2vw,2rem)] font-semibold leading-[1.05] tracking-[-0.03em] text-opus-dark">Réduire le risque perçu avant engagement.</h2>
            <p class="mt-4 max-w-[58ch] text-sm leading-7 text-neutral-700 md:text-[0.98rem]">Diffusion, droits, arbitrages et cadre économique rendent la collaboration plus défendable.</p>
            <div class="mt-5 flex flex-wrap gap-3">
              <a href="/contact" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black">Soumettre un besoin</a>
              <a href="/ressources#case-studies" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">Voir les cas</a>
            </div>
          </article>

          <article class="border border-neutral-200 bg-neutral-50 p-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">APPROFONDISSEMENT</p>
            <p class="mt-3 text-sm leading-7 text-neutral-700 md:text-[0.98rem]">Pour densifier une discussion déjà engagée.</p>
            <div class="mt-5 border-t border-neutral-200 pt-5">
              <a href="/ressources/capability-pack" class="inline-flex min-h-11 items-center justify-center border border-neutral-300 bg-white px-5 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">Recevoir le capability pack</a>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
