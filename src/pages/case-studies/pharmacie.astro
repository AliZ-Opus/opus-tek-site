---
import BaseLayout from "../../layouts/BaseLayout.astro";

const pageTitle = "Pharmacie — Étude de cas — OPUS Technology";
const pageDescription =
  "Comment OPUS a structuré une trajectoire d’exécution plus nette dans un contexte santé exigeant.";

const kpis = [
  { value: "≈ 100 k$", label: "Valeur estimée" },
  { value: "+50 %", label: "Gain ciblé" },
  { value: "+80 %", label: "Performance renforcée" },
  { value: "+40 %", label: "Progression opérationnelle" },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section class="bg-white py-24 md:py-28">
      <div class="mx-auto w-full max-w-[900px] px-4 md:px-8">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
          ÉTUDE DE CAS
        </p>

        <h1 class="mt-5 text-4xl font-black tracking-tight text-opus-dark md:text-5xl">
          Pharmacie — Faire passer l’innovation santé d’une intention à une exécution mesurable
        </h1>

        <p class="mt-8 text-[1rem] leading-[1.8] text-neutral-700">
          Le contexte exigeait une exécution structurée dans un environnement sensible, avec un besoin élevé de fiabilité,
          de lisibilité et de valeur mesurable.
        </p>

        <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {kpis.map((kpi) => (
            <article class="border border-neutral-200 bg-white p-5 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
                Verified
              </p>
              <p class="mt-4 text-[clamp(1.8rem,3vw,2.4rem)] font-semibold leading-none tracking-[-0.04em] text-opus-red">
                {kpi.value}
              </p>
              <p class="mt-3 text-sm leading-6 text-neutral-700">
                {kpi.label}
              </p>
            </article>
          ))}
        </div>

        <div class="mt-14 overflow-x-auto">
          <table class="w-full border border-neutral-200 text-left">
            <thead>
              <tr class="bg-neutral-100">
                <th class="p-4 text-sm font-semibold uppercase tracking-[0.18em] text-neutral-600">
                  Avant OPUS
                </th>
                <th class="border-l border-neutral-200 p-4 text-sm font-semibold uppercase tracking-[0.18em] text-opus-dark">
                  Après OPUS
                </th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-t border-neutral-200">
                <td class="p-4 leading-[1.8] text-neutral-700">
                  Faible structuration des mécanismes d’exécution et lecture partielle de la valeur produite.
                </td>
                <td class="border-l border-neutral-200 p-4 font-medium leading-[1.8] text-opus-dark">
                  Cadre d’exécution plus net, plus mesurable et plus simple à piloter.
                </td>
              </tr>
              <tr class="border-t border-neutral-200">
                <td class="p-4 leading-[1.8] text-neutral-700">
                  Visibilité limitée sur les priorités critiques et sur la cohérence du delivery.
                </td>
                <td class="border-l border-neutral-200 p-4 font-medium leading-[1.8] text-opus-dark">
                  Lecture plus claire des priorités et meilleure cohérence entre besoins et exécution.
                </td>
              </tr>
              <tr class="border-t border-neutral-200">
                <td class="p-4 leading-[1.8] text-neutral-700">
                  Difficulté à démontrer la valeur dans un environnement sensible.
                </td>
                <td class="border-l border-neutral-200 p-4 font-medium leading-[1.8] text-opus-dark">
                  Valeur plus facile à démontrer, trajectoire plus crédible et meilleure capacité à passer à l’échelle.
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="mt-14">
          <h2 class="text-2xl font-semibold tracking-tight text-opus-dark">
            Levier technique
          </h2>

          <p class="mt-5 leading-[1.8] text-neutral-700">
            OPUS a organisé l’intervention autour d’un socle de gouvernance, de structuration du delivery et
            d’exploitation disciplinée des capacités pour rendre la trajectoire défendable dans un contexte santé.
          </p>

          <p class="mt-5 leading-[1.8] text-neutral-700">
            L’approche a permis de transformer une intention d’innovation en exécution mesurable, avec une meilleure
            lisibilité sur les priorités, les résultats et les leviers d’amélioration.
          </p>
        </div>

        <div class="mt-16 h-28 w-[2px] bg-opus-red"></div>
      </div>
    </section>
  </main>
</BaseLayout>