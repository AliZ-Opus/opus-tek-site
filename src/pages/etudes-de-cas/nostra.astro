---
// src/pages/etudes-de-cas/nostra.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Étude de cas — NOSTRA (calcul intensif)"
  description="Optimisation de la décision financière via calcul intensif : calcul nocturne, volumétrie massive, taux de réussite élevé."
  ogImage="/og/opus-hero-cgi.png"
>
  <main id="main" class="site-main">
    <section class="case-detail">
      <div class="wrap">
        <div class="case-detail-inner">
          <a class="split-hero-link" href="/etudes-de-cas">← Études de cas</a>

          <div class="page-kicker">ÉTUDE DE CAS</div>
          <h1 class="page-title">Optimisation de la décision financière via calcul intensif</h1>
          <p class="page-lead">
            Déploiement et exploitation de <strong>NOSTRA</strong> : plateforme de calcul massif exécutée de nuit, résultats exploitables dès le matin.
          </p>

          <div class="case-detail-grid">
            <div>
              <div class="case-block">
                <h2>Contexte</h2>
                <p>
                  Besoin d’exécuter des calculs volumineux et complexes sur de très grands ensembles de données, avec une fenêtre nocturne
                  de traitement et une exigence de résultats consolidés disponibles dès le matin.
                </p>
              </div>

              <div class="case-block">
                <h2>Approche</h2>
                <ul>
                  <li>Déploiement et exploitation d’une plateforme de calcul intensif (exécution principalement de nuit).</li>
                  <li>Industrialisation des runs : fiabilité, reprise, validation et consolidation des résultats.</li>
                  <li>Optimisation de la chaîne data (volumétrie, performance, stabilité).</li>
                </ul>
              </div>

              <div class="case-block">
                <h2>Repères</h2>
                <ul>
                  <li>Taux de réussite &gt; 80%.</li>
                  <li>&gt; 8h de calcul nocturne.</li>
                  <li>~400M points de données analysés/jour.</li>
                  <li>&gt; 3M$ R&amp;D.</li>
                </ul>
              </div>

              <div class="case-block">
                <h2>Résultat</h2>
                <p>
                  Résultats consolidés disponibles dès le matin pour guider les décisions, avec une exécution stable, répétable et adaptée
                  à un contexte de performance élevée.
                </p>
              </div>
            </div>

            <aside class="case-aside" aria-label="Facts">
              <h2>Facts</h2>

              <div class="case-meta" aria-label="Métadonnées">
                <span class="case-tag">Calcul intensif</span>
                <span class="case-tag">Data</span>
                <span class="case-tag">Finance</span>
              </div>

              <div class="case-facts" aria-label="Faits clés">
                <div class="case-fact"><strong>Client</strong><span>Cabinet financier</span></div>
                <div class="case-fact"><strong>Industrie</strong><span>Finance</span></div>
                <div class="case-fact"><strong>Service</strong><span>Calcul avancé</span></div>
                <div class="case-fact"><strong>Volumétrie</strong><span>~400M points/jour</span></div>
                <div class="case-fact"><strong>Fenêtre</strong><span>&gt;8h nocturnes</span></div>
                <div class="case-fact"><strong>R&amp;D</strong><span>&gt;3M$</span></div>
              </div>
            </aside>
          </div>

          <div class="hero-cta" style="margin-top:22px;">
            <a class="btn btn-primary" href="/contact">Soumettre un besoin →</a>
            <a class="btn btn-secondary" href="/etudes-de-cas">Retour aux études de cas →</a>
          </div>

          <div class="breadcrumb">
            <a href="/">Accueil</a> <span>→</span> <a href="/etudes-de-cas">Études de cas</a> <span>→</span> <span>NOSTRA</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>