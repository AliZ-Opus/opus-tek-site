---
// src/pages/etudes-de-cas/appels-offres-ia.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Étude de cas — Appels d’offres IA"
  description="Ciblage intelligent des appels d’offres par IA : automatisation, priorisation, gains temps et augmentation du volume."
  ogImage="/og/opus-hero-cgi.png"
>
  <main id="main" class="site-main">
    <section class="case-detail">
      <div class="wrap">
        <div class="case-detail-inner">
          <a class="split-hero-link" href="/etudes-de-cas">← Études de cas</a>

          <div class="page-kicker">ÉTUDE DE CAS</div>
          <h1 class="page-title">Ciblage intelligent des appels d’offres par IA</h1>
          <p class="page-lead">
            Automatisation de la recherche, analyse et priorisation des appels d’offres selon la probabilité de succès,
            avec une interface explicable des facteurs.
          </p>

          <div class="case-detail-grid">
            <div>
              <div class="case-block">
                <h2>Contexte</h2>
                <p>
                  Volumétrie élevée d’appels d’offres, faible capacité à filtrer rapidement et à prioriser les opportunités.
                  L’objectif était de réduire le bruit, d’augmenter la qualité du ciblage et de concentrer l’effort sur les dossiers
                  présentant un potentiel réel.
                </p>
              </div>

              <div class="case-block">
                <h2>Approche</h2>
                <ul>
                  <li>Collecte et centralisation des appels d’offres (sources multiples).</li>
                  <li>Analyse IA des critères : adéquation, contraintes, signaux de risque, éléments discriminants.</li>
                  <li>Scoring et priorisation avec justification explicable des facteurs.</li>
                  <li>Interface simple de consultation et tri des opportunités.</li>
                  <li>Phase 2 (prévue) : assistance à l’adaptation / rédaction des réponses.</li>
                </ul>
              </div>

              <div class="case-block">
                <h2>Résultats</h2>
                <ul>
                  <li>~12h/semaine économisées.</li>
                  <li>+30% d’appels d’offres déposés.</li>
                  <li>Économies annuelles estimées ~50 000$.</li>
                </ul>
              </div>
            </div>

            <aside class="case-aside" aria-label="Facts">
              <h2>Facts</h2>

              <div class="case-meta" aria-label="Métadonnées">
                <span class="case-tag">IA</span>
                <span class="case-tag">Automatisation</span>
                <span class="case-tag">Appels d’offres</span>
              </div>

              <div class="case-facts" aria-label="Faits clés">
                <div class="case-fact"><strong>Client</strong><span>Construction Saguenay</span></div>
                <div class="case-fact"><strong>Industrie</strong><span>Construction</span></div>
                <div class="case-fact"><strong>Service</strong><span>IA &amp; Automatisation</span></div>
                <div class="case-fact"><strong>Impact</strong><span>~12h/sem • +30% AO • ~50k$/an</span></div>
              </div>
            </aside>
          </div>

          <div class="hero-cta" style="margin-top:22px;">
            <a class="btn btn-primary" href="/contact">Soumettre un besoin →</a>
            <a class="btn btn-secondary" href="/etudes-de-cas">Retour aux études de cas →</a>
          </div>

          <div class="breadcrumb">
            <a href="/">Accueil</a> <span>→</span> <a href="/etudes-de-cas">Études de cas</a> <span>→</span> <span>Appels d’offres IA</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>