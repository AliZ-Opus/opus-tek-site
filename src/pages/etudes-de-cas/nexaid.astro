---
// src/pages/etudes-de-cas/nexaid.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Étude de cas — NEXAID (ops IA réglementé)"
  description="Optimisation des opérations par IA en contexte réglementé : réduction tâches administratives, traçabilité, économies annuelles."
  ogImage="/og/opus-hero-cgi.png"
>
  <main id="main" class="site-main">
    <section class="case-detail">
      <div class="wrap">
        <div class="case-detail-inner">
          <a class="split-hero-link" href="/etudes-de-cas">← Études de cas</a>

          <div class="page-kicker">ÉTUDE DE CAS</div>
          <h1 class="page-title">Optimisation des opérations par IA (contexte réglementé)</h1>
          <p class="page-lead">
            Diagnostic des frictions et déploiement de solutions IA intégrées aux outils existants,
            adoption rapide et transfert de connaissances.
          </p>

          <div class="case-detail-grid">
            <div>
              <div class="case-block">
                <h2>Contexte</h2>
                <p>
                  Contexte réglementé, exigences de traçabilité et de fiabilité élevées. Objectif : réduire les tâches administratives,
                  fiabiliser l’exécution et augmenter la visibilité opérationnelle.
                </p>
              </div>

              <div class="case-block">
                <h2>Approche</h2>
                <ul>
                  <li>Diagnostic rapide des frictions et priorisation des leviers à fort impact.</li>
                  <li>Intégration aux outils existants, interfaces simples et adoption rapide.</li>
                  <li>Transfert de connaissances pour rendre l’équipe autonome.</li>
                </ul>
              </div>

              <div class="case-block">
                <h2>Résultats</h2>
                <ul>
                  <li>Réduction significative des tâches administratives.</li>
                  <li>Meilleure fiabilité et traçabilité.</li>
                  <li>Économies estimées ~100 000$/an.</li>
                </ul>
              </div>
            </div>

            <aside class="case-aside" aria-label="Facts">
              <h2>Facts</h2>

              <div class="case-meta" aria-label="Métadonnées">
                <span class="case-tag">IA</span>
                <span class="case-tag">Ops</span>
                <span class="case-tag">Conformité</span>
              </div>

              <div class="case-facts" aria-label="Faits clés">
                <div class="case-fact"><strong>Client</strong><span>Pharmacie Uniprix</span></div>
                <div class="case-fact"><strong>Industrie</strong><span>Santé</span></div>
                <div class="case-fact"><strong>Service</strong><span>IA &amp; Ops</span></div>
                <div class="case-fact"><strong>Impact</strong><span>~100k$/an (est.)</span></div>
              </div>
            </aside>
          </div>

          <div class="hero-cta" style="margin-top:22px;">
            <a class="btn btn-primary" href="/contact">Soumettre un besoin →</a>
            <a class="btn btn-secondary" href="/etudes-de-cas">Retour aux études de cas →</a>
          </div>

          <div class="breadcrumb">
            <a href="/">Accueil</a> <span>→</span> <a href="/etudes-de-cas">Études de cas</a> <span>→</span> <span>NEXAID</span>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>