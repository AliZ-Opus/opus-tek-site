---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/hero/opus-contact.png";

const pageTitle = "Contact — OPUS Technology";
const pageDescription =
  "Parlez-nous de votre contexte. Nous revenons vers vous avec une réponse claire, structurée et rapide.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Contact OPUS" class="relative isolate overflow-clip bg-white">
      <div class="mx-auto w-full grid min-h-[76svh] max-h-[760px] max-w-[1680px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[45%_55%] xl:px-10">
        <div class="relative z-20 flex min-w-0 items-center">
          <div class="relative w-full max-w-[800px] py-8 lg:py-12 lg:pr-12 xl:pr-24">
            <div class="relative z-10">
              <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500 sm:text-xs">CONTACT</p>
              <h1 class="max-w-[18ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
                Un échange simple. Une réponse utile.
              </h1>
              <p class="mt-6 max-w-[58ch] text-base leading-8 text-neutral-700 md:text-[1.05rem]">
                Décrivez votre besoin en quelques lignes. Notre équipe revient vers vous avec une première orientation claire.
              </p>
              <div class="mt-6 space-y-1 text-sm leading-7 text-neutral-700">
                <p><strong>Email :</strong> contact@opus-tek.ca</p>
                <p><strong>Web :</strong> www.opus-tek.com</p>
                <p><strong>Présence :</strong> Canada · Tunisie · Brésil</p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-full min-h-[360px] sm:min-h-[480px] lg:min-h-[540px] xl:mt-0 xl:min-h-[620px]">
          <Image
            src={heroImage}
            alt="Visuel institutionnel illustrant le point d’entrée OPUS"
            widths={[960, 1280, 1600, 1920]}
            sizes="(max-width: 1023px) 100vw, 55vw"
            format="avif"
            quality={92}
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-center"
            style="opacity: 1 !important;"
          />
        </div>
      </div>
    </section>

    <section class="relative z-30 -mt-[90px] md:-mt-[110px] lg:-mt-[120px]">
      <div class="mx-auto w-full max-w-[1080px] px-4 md:px-8 xl:px-10">
        <div class="border border-neutral-200 bg-white p-6 shadow-[0_18px_50px_rgba(0,0,0,0.08)] md:p-8 xl:p-10">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">FORMULAIRE</p>
          <h2 class="mt-4 text-[clamp(1.5rem,2.8vw,2.4rem)] font-semibold leading-[1.02] text-opus-dark">
            Donnez le contexte, nous cadrons la suite.
          </h2>
          <p class="mt-4 text-sm leading-7 text-neutral-700 md:text-[0.98rem]">
            Les champs ci-dessous sont alignés avec notre point d’entrée technique <code>/api/contact</code>.
          </p>

          <form id="contact-form" class="mt-8 space-y-5" method="post" action="/api/contact" novalidate>
            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
              <div>
                <label for="name" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Nom</label>
                <input id="name" name="name" type="text" autocomplete="name" required class="min-h-12 w-full border border-neutral-200 bg-neutral-50 px-4 text-sm text-opus-dark outline-none transition placeholder:text-neutral-400 focus:border-opus-red" placeholder="Votre nom" />
              </div>

              <div>
                <label for="email" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Email</label>
                <input id="email" name="email" type="email" autocomplete="email" required class="min-h-12 w-full border border-neutral-200 bg-neutral-50 px-4 text-sm text-opus-dark outline-none transition placeholder:text-neutral-400 focus:border-opus-red" placeholder="vous@organisation.com" />
              </div>
            </div>

            <div>
              <label for="company" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Organisation</label>
              <input id="company" name="company" type="text" autocomplete="organization" class="min-h-12 w-full border border-neutral-200 bg-neutral-50 px-4 text-sm text-opus-dark outline-none transition placeholder:text-neutral-400 focus:border-opus-red" placeholder="Nom de votre organisation" />
            </div>

            <div>
              <label for="message" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">Message</label>
              <textarea id="message" name="message" rows="6" required class="w-full border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm leading-7 text-opus-dark outline-none transition placeholder:text-neutral-400 focus:border-opus-red" placeholder="Décrivez brièvement le besoin, le timing et les contraintes."></textarea>
            </div>

            <div class="hidden" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <p id="contact-feedback" role="status" aria-live="polite" class="rounded-none border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700">
              Réponse initiale sous 24h ouvrées.
            </p>

            <button type="submit" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white shadow-[0_10px_24px_rgba(0,0,0,0.08)] transition hover:border-black hover:bg-black">
              Envoyer la demande →
            </button>
          </form>
        </div>
      </div>
    </section>

    <script is:inline>
      (() => {
        const form = document.getElementById("contact-form");
        const feedback = document.getElementById("contact-feedback");

        if (!(form instanceof HTMLFormElement) || !(feedback instanceof HTMLElement)) return;

        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          const data = new FormData(form);
          const payload = {
            name: String(data.get("name") || "").trim(),
            email: String(data.get("email") || "").trim(),
            company: String(data.get("company") || "").trim(),
            message: String(data.get("message") || "").trim(),
            website: String(data.get("website") || "").trim(),
          };

          if (!payload.name || !payload.email || !payload.message) {
            feedback.textContent = "Merci de compléter les champs requis (nom, email, message).";
            return;
          }

          feedback.textContent = "Envoi en cours…";

          try {
            const response = await fetch("/api/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(payload),
            });

            const result = await response.json();

            if (response.ok && result?.ok) {
              feedback.textContent = "Message envoyé. Nous revenons vers vous rapidement.";
              form.reset();
              return;
            }

            feedback.textContent = "Impossible d’envoyer le message pour le moment. Essayez à nouveau ou écrivez à contact@opus-tek.ca.";
          } catch {
            feedback.textContent = "Erreur réseau. Réessayez dans quelques instants ou écrivez à contact@opus-tek.ca.";
          }
        });
      })();
    </script>
  </main>
</BaseLayout>
