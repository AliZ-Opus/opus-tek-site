---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PolicyCard from "../components/PolicyCard.astro";
import heroImage from "../assets/hero/opus-contact.png";

const pageTitle = "Contact — OPUS Technology";
const pageDescription =
  "Un point d’entrée unique. Une réponse structurée. Choisissez votre mode de contact : chaque demande est traitée avec la même discipline documentaire.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Contact OPUS" class="relative isolate overflow-clip bg-white">
      <div class="mx-auto w-full grid min-h-[80svh] max-h-[760px] max-w-[1680px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[40%_60%] xl:grid-cols-[40%_60%] xl:px-10">
        <div class="relative z-20 flex min-w-0 items-center">
          <div class="relative w-full max-w-[800px] py-8 lg:py-12 lg:pr-12 xl:pr-24">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-y-0 -left-8 right-[-38%] z-0"
              style="
                background: linear-gradient(to right, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0) 100%);
                -webkit-mask-image: linear-gradient(to right, black 42%, transparent 100%);
                mask-image: linear-gradient(to right, black 42%, transparent 100%);
                -webkit-mask-repeat: no-repeat;
                mask-repeat: no-repeat;
                -webkit-mask-size: 100% 100%;
                mask-size: 100% 100%;
              "
            ></div>

            <div class="relative z-10">
              <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500 sm:text-xs">
                CONTACT
              </p>

              <h1 class="max-w-[18ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
                Un point d’entrée unique. Une réponse structurée.
              </h1>

              <p class="mt-6 max-w-[60ch] text-base leading-8 text-neutral-700 md:text-[1.05rem]">
                Choisissez votre mode de contact. Chaque demande est traitée avec la même discipline documentaire.
              </p>

              <div class="mt-7 h-[2px] w-24 bg-opus-red"></div>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-full min-h-[400px] sm:min-h-[520px] lg:min-h-[560px] xl:mt-0 xl:min-h-[640px]">
          <Image
            src={heroImage}
            alt="Visuel institutionnel illustrant le point d’entrée OPUS"
            widths={[960, 1280, 1600, 1920]}
            sizes="(max-width: 1023px) 100vw, 60vw"
            format="avif"
            quality={92}
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-center"
            style="opacity: 1 !important;"
          />
        </div>
      </div>
    </section>

    <section class="relative z-30 -mt-overlap-force">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="w-full border border-neutral-200 bg-white shadow-[0_18px_50px_rgba(0,0,0,0.08)]">
          <div class="w-full grid grid-cols-1 gap-8 p-6 md:p-8 lg:grid-cols-[1fr_1.5fr] lg:gap-10 xl:p-10">
            <div class="space-y-6">
              <div class="max-w-[48ch]">
                <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
                  CONTACT HUB
                </p>

                <h2 class="mt-4 text-[clamp(1.8rem,3vw,3rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">
                  Des coordonnées lisibles, un canal simple, une prise en charge sérieuse.
                </h2>

                <p class="mt-5 text-base leading-8 text-neutral-700">
                  Utilisez l’email direct pour un premier échange ou transmettez votre besoin via le questionnaire. Le cadre reste le même : clarté, structure et réponse professionnelle.
                </p>
              </div>

              <div class="w-full grid grid-cols-1 gap-6">
                <PolicyCard
                  label="EMAIL"
                  title="contact@opus-tek.ca"
                  body="Point d’entrée principal pour les demandes de services, de cadrage, de collaboration ou de mise en relation."
                />

                <PolicyCard
                  label="BUREAUX"
                  title="Québec / Tunisie"
                  body="Présence côté Québec pour la relation d’affaires et la proximité marché, avec un hub de delivery structuré en Tunisie."
                />
              </div>
            </div>

            <div class="min-w-0">
              <div class="border border-neutral-100 bg-white p-6 shadow-xl md:p-8">
                <div class="max-w-[54ch]">
                  <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
                    QUESTIONNAIRE
                  </p>

                  <h2 class="mt-4 text-[clamp(1.6rem,2.8vw,2.6rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">
                    Décrivez votre besoin avec précision.
                  </h2>

                  <p class="mt-4 text-sm leading-7 text-neutral-700 md:text-[0.98rem]">
                    Quelques éléments suffisent pour orienter la suite : priorité, contexte et point de contact.
                  </p>
                </div>

                <form class="mt-8 space-y-6" method="post" action="/api/contact">
                  <div>
                    <p class="mb-3 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">
                      Étape 1 — Quel est votre défi prioritaire ?
                    </p>

                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                      <label class="flex cursor-pointer items-center gap-3 border border-neutral-200 bg-neutral-50 px-4 py-4 text-sm text-opus-dark transition has-[:checked]:border-opus-red has-[:checked]:bg-white">
                        <input type="radio" name="priority" value="architecture" class="h-4 w-4 accent-[var(--color-opus-red)]" checked />
                        <span>Architecture</span>
                      </label>

                      <label class="flex cursor-pointer items-center gap-3 border border-neutral-200 bg-neutral-50 px-4 py-4 text-sm text-opus-dark transition has-[:checked]:border-opus-red has-[:checked]:bg-white">
                        <input type="radio" name="priority" value="execution-ia" class="h-4 w-4 accent-[var(--color-opus-red)]" />
                        <span>Exécution IA</span>
                      </label>

                      <label class="flex cursor-pointer items-center gap-3 border border-neutral-200 bg-neutral-50 px-4 py-4 text-sm text-opus-dark transition has-[:checked]:border-opus-red has-[:checked]:bg-white">
                        <input type="radio" name="priority" value="gouvernance" class="h-4 w-4 accent-[var(--color-opus-red)]" />
                        <span>Gouvernance</span>
                      </label>
                    </div>
                  </div>

                  <div>
                    <p class="mb-3 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">
                      Étape 2 — Coordonnées
                    </p>

                    <div class="w-full grid grid-cols-1 gap-5 md:grid-cols-2">
                      <div>
                        <label for="name" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">
                          Nom
                        </label>
                        <input
                          id="name"
                          name="name"
                          type="text"
                          autocomplete="name"
                          required
                          class="min-h-12 w-full border border-neutral-200 bg-neutral-50 px-4 text-sm text-opus-dark outline-none transition placeholder:text-neutral-400 focus:border-opus-red"
                          placeholder="Votre nom"
                        />
                      </div>

                      <div>
                        <label for="email" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">
                          Email
                        </label>
                        <input
                          id="email"
                          name="email"
                          type="email"
                          autocomplete="email"
                          required
                          class="min-h-12 w-full border border-neutral-200 bg-neutral-50 px-4 text-sm text-opus-dark outline-none transition placeholder:text-neutral-400 focus:border-opus-red"
                          placeholder="vous@organisation.com"
                        />
                      </div>
                    </div>
                  </div>

                  <div>
                    <label for="message" class="mb-2 block text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-neutral-500">
                      Contexte
                    </label>
                    <textarea
                      id="message"
                      name="message"
                      rows="6"
                      class="w-full border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm leading-7 text-opus-dark outline-none transition placeholder:text-neutral-400 focus:border-opus-red"
                      placeholder="Décrivez brièvement votre contexte, votre objectif et les contraintes principales."
                    ></textarea>
                  </div>

                  <div class="rounded-none border border-opus-red/20 bg-neutral-50 px-4 py-4 text-sm leading-6 text-neutral-700">
                    Traitement en cours. Un accusé de réception structuré vous sera transmis sous 24h.
                  </div>

                  <div class="flex flex-wrap gap-3 pt-1">
                    <button
                      type="submit"
                      class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
                    >
                      Soumettre un besoin →
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>