---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../assets/hero/opus-phoenixx-opus.png";

const pageTitle = "Phoenixx ↔ OPUS — Rôles et gouvernance";
const pageDescription =
  "Phoenixx structure le cadre d’affaires, OPUS conduit l’exécution technologique: un partenariat lisible et crédible pour les décideurs.";

const outcomes = [
  {
    label: "Pour le client",
    text: "Un interlocuteur clair, un cadre contractuel stable, et une exécution pilotée sur des résultats mesurables.",
  },
  {
    label: "Pour le delivery",
    text: "Rôles explicites, priorités alignées, décisions tracées entre gouvernance d’affaires et delivery technique.",
  },
  {
    label: "Pour la confiance",
    text: "Continuité relationnelle côté Phoenixx, responsabilité d’exécution côté OPUS, sans zone grise.",
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Phoenixx et OPUS" class="relative isolate overflow-clip bg-white">
      <div class="mx-auto grid min-h-[78svh] max-w-[1680px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[45%_55%] xl:px-10">
        <div class="relative z-20 flex min-w-0 items-center">
          <div class="relative w-full max-w-[800px] py-10 lg:py-12 lg:pr-12 xl:pr-24">
            <div class="relative z-10">
              <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">PHOENIXX ↔ OPUS</p>
              <h1 class="max-w-[18ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
                Un partenariat lisible : Phoenixx structure, OPUS exécute.
              </h1>
              <p class="mt-6 max-w-[60ch] text-base leading-8 text-neutral-700 md:text-[1.02rem]">
                Phoenixx apporte le cadre d’affaires et la continuité contractuelle. OPUS porte l’architecture, l’intégration et l’exécution opérationnelle, avec responsabilité claire sur le delivery.
              </p>

              <div class="mt-8 flex flex-wrap gap-3">
                <a href="/contact" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white shadow-[0_10px_24px_rgba(0,0,0,0.08)] transition hover:border-black hover:bg-black">
                  Parler de votre projet →
                </a>
                <a href="https://phoenixx.ca/" target="_blank" rel="noreferrer" class="inline-flex min-h-12 items-center justify-center border border-neutral-400 bg-white px-6 text-sm font-medium text-opus-dark shadow-[0_10px_24px_rgba(0,0,0,0.04)] transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">
                  Découvrir Phoenixx →
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="relative mt-6 h-full min-h-[400px] sm:min-h-[520px] lg:min-h-[580px] xl:mt-0 xl:min-h-[660px]">
          <Image
            src={heroImage}
            alt="Visuel architectural illustrant le modèle Phoenixx et OPUS"
            widths={[960, 1280, 1600, 1920]}
            sizes="(max-width: 1023px) 100vw, 55vw"
            format="avif"
            quality={92}
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 h-full w-full object-cover object-center"
            style="opacity: 1 !important;"
          />
        </div>
      </div>
    </section>

    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
          {outcomes.map((item) => (
            <article class="border border-neutral-200 bg-white p-7 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">{item.label}</p>
              <p class="mt-4 text-sm leading-7 text-neutral-700">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
