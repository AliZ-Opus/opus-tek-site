---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Propriété intellectuelle - OPUS Technology";
const pageDescription =
  "Les modèles opérationnels et méthodologies documentaires présentés par OPUS Technology sont la propriété exclusive de l'organisation, sauf mention contraire.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Propriété intellectuelle" class="bg-white">
      <div class="mx-auto w-full max-w-[1680px] px-4 pb-20 pt-24 md:px-8 md:pb-24 md:pt-28 xl:px-10">
        <div class="max-w-[900px]">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
            CADRE LÉGAL
          </p>

          <h1 class="mt-5 max-w-[18ch] text-[clamp(2rem,4vw,3.8rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">
            Propriété intellectuelle
          </h1>

          <div class="mt-7 h-[2px] w-24 bg-opus-red"></div>

          <div class="mt-10 space-y-8 text-[1rem] leading-8 text-neutral-700">
            <p>Les modèles opérationnels, méthodologies documentaires, cadres de lecture, structures de delivery, logiques de gouvernance et contenus rédactionnels présentés sur ce site sont, sauf mention contraire explicite, la propriété exclusive d'OPUS Technology.</p>
            <p>Ces éléments sont fournis à titre d'information, de cadrage et de démonstration de capacité. Ils ne peuvent être copiés, reproduits, adaptés, diffusés, réutilisés ou exploités sans autorisation écrite préalable d'OPUS Technology.</p>
            <p>Cette protection couvre notamment les pages du site, les études de cas, les repères stratégiques et les supports associés.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
