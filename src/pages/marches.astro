---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "Marchés - OPUS Technology";
const description = "Présence structurée en Amérique du Nord, en Afrique et en Amérique latine, avec un cadre de delivery tenu d'un contexte à l'autre.";
---

<BaseLayout title={title} description={description}>
  <section class="surface pad-lg">
    <div class="kicker">PRÉSENCE</div>
    <h1 class="h2" style="font-size:44px;">Amérique du Nord · Afrique · Amérique latine</h1>
    <p class="lead">
      Une présence structurée et une exécution gouvernée. OPUS peut intervenir dans des contextes multiculturels sans diluer les standards de qualité, de sécurité, de conformité et de traçabilité.
    </p>

    <div class="divider"></div>

    <div class="grid-3">
      <div class="surface pad-md">
        <h3 class="card-title">Cadre</h3>
        <p class="card-text">Standards communs, gouvernance claire et qualité mesurable.</p>
      </div>
      <div class="surface pad-md">
        <h3 class="card-title">Langues</h3>
        <p class="card-text">Français, anglais, arabe, espagnol et portugais selon les contextes.</p>
      </div>
      <div class="surface pad-md">
        <h3 class="card-title">Exécution</h3>
        <p class="card-text">Équipes hybrides, coordination serrée et livrables lisibles.</p>
      </div>
    </div>

    <div class="divider"></div>

    <a class="btn btn-accent" href="/contact">Soumettre un besoin</a>
  </section>
</BaseLayout>
