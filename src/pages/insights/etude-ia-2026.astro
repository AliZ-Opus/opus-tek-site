---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MicroBand from "../../components/MicroBand.astro";
import bandTrust from "../../assets/bands/opus-band-trust.png";

const pageTitle = "Observatoire des compétences IA 2026 - Étude de marché";
const pageDescription =
  "Étude de marché sur l'éducation globale en IA, les MBA internationaux, les certifications professionnelles et les stages au Canada.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section class="relative border-b border-neutral-200 bg-white py-16 md:py-20">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="max-w-[760px]">
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">INSIGHTS</p>
          <h1 class="mt-5 max-w-[12ch] text-[clamp(2.4rem,4.6vw,4.8rem)] font-black leading-[0.94] tracking-[-0.04em] text-opus-dark">
            Observatoire des compétences IA 2026
          </h1>
          <p class="mt-6 max-w-[64ch] text-base leading-8 text-neutral-700 md:text-[1.02rem]">
            Cette étude de marché évalue l'intérêt pour une plateforme de formation en intelligence artificielle et data, combinant MBA internationaux, certifications professionnelles et stages au Canada.
          </p>
        </div>
      </div>
    </section>

    <MicroBand
      src={bandTrust}
      alt="Bande observatoire"
      height={360}
      slogan="Une étude de terrain pour comprendre l'éducation IA de demain."
    />

    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
        <div class="max-w-[760px] space-y-6">
          <p class="text-base leading-8 text-neutral-700">
            Le questionnaire détaillé reste branché au flux d'étude existant. La page a été nettoyée sur le plan linguistique et éditorial pour que le haut de page, les libellés et les messages visibles restent cohérents avec le reste du site.
          </p>
          <a href="/formation-accompagnement-ia#sondage" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black">
            Répondre au sondage
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
