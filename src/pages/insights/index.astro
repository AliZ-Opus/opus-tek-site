---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MicroBand from "../../components/MicroBand.astro";
import bandServices from "../../assets/bands/opus-band-services.png";

const pageTitle = "Insights - OPUS Technology";
const pageDescription =
  "Observatoire, briefings exécutifs et signaux de marché structurés par OPUS Technology pour décideurs, sponsors et partenaires.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section class="relative isolate overflow-hidden border-b border-neutral-200 bg-white">
      <div class="relative mx-auto max-w-[1680px] px-4 py-12 md:px-8 md:py-14 xl:px-10 xl:py-16">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,0.88fr)_minmax(420px,0.92fr)] lg:gap-10 xl:gap-14">
          <div class="max-w-[700px] self-center">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">INSIGHTS</p>
            <h1 class="mt-5 max-w-[7.4ch] text-[clamp(2.6rem,4.4vw,4.6rem)] font-black leading-[0.9] tracking-[-0.06em] text-opus-dark">
              Recherche utile. Signaux lisibles. Capture exploitable.
            </h1>
            <p class="mt-6 max-w-[57ch] text-[0.98rem] leading-8 text-neutral-700">
              Insights n'est pas un blog. C'est un hub de lecture stratégique. OPUS y publie des artefacts conçus pour soutenir une décision, qualifier un marché et transformer un signal en matière exploitable.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="/insights/etude-ia-2026" class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black">Participer à l'étude IA 2026</a>
              <a href="/ressources" class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white">Voir les ressources</a>
            </div>
          </div>

          <div class="relative self-center lg:pl-4 xl:pl-8">
            <article class="border border-neutral-200 bg-white p-6 shadow-[0_18px_50px_rgba(0,0,0,0.06)]">
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">DELIVERY SIGNAL</p>
              <h2 class="mt-4 text-[1.4rem] font-semibold leading-tight text-opus-dark">
                Hub de lecture structuré pour signaux, études et restitution exploitable.
              </h2>
              <p class="mt-4 text-sm leading-8 text-neutral-700">
                Capture terrain, qualification du besoin, lecture de marché et restitution sous forme de sorties courtes, denses et directement activables.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <MicroBand
      src={bandServices}
      alt="Bande insights"
      height={300}
      slogan="Un signal n'a de valeur que s'il devient lisible."
      class="my-2"
    />
  </main>
</BaseLayout>
