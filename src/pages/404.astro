---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "404 — OPUS Technology";
const pageDescription =
  "Trajectoire interrompue. La ressource demandée est hors de portée.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main id="main-content" class="bg-white">
    <section aria-label="Erreur 404" class="relative isolate overflow-hidden bg-white">
      <div class="mx-auto w-full max-w-[1680px] px-4 py-20 md:px-8 md:py-28 xl:px-10">
        <div class="grid w-full grid-cols-1 items-center gap-12 lg:grid-cols-[40%_60%]">
          <div class="relative z-10 max-w-[760px]">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
              ERROR 404
            </p>

            <h1 class="mt-5 max-w-[18ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
              Trajectoire interrompue.
            </h1>

            <p class="mt-6 max-w-[58ch] text-base leading-8 text-neutral-700 md:text-[1.05rem]">
              La ressource demandée est hors de portée.
            </p>

            <div class="mt-7 h-[2px] w-24 bg-opus-red"></div>

            <div class="mt-8">
              <a
                href="/"
                class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
              >
                Retour à la base →
              </a>
            </div>
          </div>

          <div class="relative min-h-[300px] overflow-hidden border border-neutral-200 bg-neutral-50 shadow-[0_18px_50px_rgba(0,0,0,0.05)] md:min-h-[420px]">
            <div
              aria-hidden="true"
              class="absolute inset-0"
              style="
                background:
                  linear-gradient(90deg, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0.2) 40%, rgba(255,255,255,0) 100%),
                  linear-gradient(135deg, rgba(5,5,5,0.03) 0%, rgba(5,5,5,0.01) 100%);
              "
            ></div>

            <div class="absolute inset-0 flex items-center justify-center">
              <div class="relative h-[72%] w-[78%]">
                <div class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-neutral-300"></div>
                <div class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-neutral-300"></div>
                <div class="absolute left-[12%] top-[18%] h-3 w-3 rounded-full bg-opus-red"></div>
                <div class="absolute right-[18%] top-[32%] h-2.5 w-2.5 rounded-full border border-neutral-400 bg-white"></div>
                <div class="absolute bottom-[20%] left-[24%] h-2.5 w-2.5 rounded-full border border-neutral-400 bg-white"></div>
                <div class="absolute bottom-[16%] right-[14%] h-3 w-3 rounded-full bg-opus-red"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>