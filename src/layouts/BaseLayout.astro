---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import S1Underline from "../components/nav/S1Underline.astro";
import BrandLogo from "../components/brand/BrandLogo.astro";
import { motherPhrase } from "../data/corpus";

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "OPUS Technology",
  description = motherPhrase,
  ogImage = "/og/opus-og.png",
} = Astro.props;

const navItems: NavItem[] = [
  { label: "Accueil", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Ressources", href: "/ressources" },
  { label: "Confiance", href: "/confiance" },
  { label: "Contact", href: "/contact" },
];

const defaultFooterNavItems: NavItem[] = [
  { label: "Accueil", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Ressources", href: "/ressources" },
  { label: "Confiance", href: "/confiance" },
  { label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
const canonical = Astro.url.href;
const siteName = "OPUS Technology";

const footerNavItems: NavItem[] =
  currentPath === "/" || currentPath === "/services"
    ? navItems
    : defaultFooterNavItems;

const isHomePage = currentPath === "/";
const isServicesPage = currentPath === "/services";
const hasCompactFooter = isHomePage || isServicesPage;

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
};

const resolvedOgImage = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="fr" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <ClientRouter />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no, date=no, email=no, address=no" />
    <meta name="robots" content="index,follow" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content="OPUS Technology - visuel architectural" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <style is:global>
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 320ms;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      }

      ::view-transition-old(root) {
        animation-name: opus-fade-out;
      }

      ::view-transition-new(root) {
        animation-name: opus-fade-in;
      }

      @keyframes opus-fade-out {
        from { opacity: 1; }
        to { opacity: 0; }
      }

      @keyframes opus-fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      [data-reveal] {
        opacity: 0;
        transform: translateY(18px);
        transition:
          opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
          transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
        will-change: opacity, transform;
      }

      [data-reveal].is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation-duration: 1ms;
        }

        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
      }
    </style>
  </head>

  <body class="min-h-full bg-white font-[Inter,sans-serif] text-opus-dark antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[120] focus:inline-flex focus:min-h-11 focus:items-center focus:justify-center focus:bg-white focus:px-4 focus:text-sm focus:font-medium focus:text-opus-dark focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-[rgba(255,0,0,.45)]"
    >
      Aller au contenu principal
    </a>

    <header class="sticky top-0 z-[100] border-b border-black/6 bg-white/88 backdrop-blur-md supports-[backdrop-filter]:bg-white/82">
      <div class="mx-auto w-full max-w-[1720px] px-4 py-2 md:px-8 md:py-4 xl:px-10">
        <div class="grid w-full grid-cols-1 items-center gap-5 xl:grid-cols-[22rem_minmax(0,1fr)]">
          <div class="flex min-w-0 items-center justify-between gap-4">
            <div class="flex min-w-0 items-center gap-3">
              <a
                href="/"
                class="inline-flex min-w-0 items-center transition-opacity hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
                aria-label="Accueil OPUS Technology"
              >
                <BrandLogo theme="dark" className="h-14! w-auto md:h-12! xl:h-14!" />
              </a>

              <span class="hidden border-l border-neutral-200 pl-3 text-[0.6rem] font-semibold uppercase tracking-[0.16em] text-neutral-500 2xl:inline-flex">
                cadrer · arbitrer · exécuter
              </span>
            </div>

            <button
              type="button"
              aria-expanded="false"
              aria-controls="mobile-drawer"
              data-mobile-menu-toggle
              class="inline-flex min-h-11 min-w-11 items-center justify-center border border-neutral-200 bg-white px-4 text-sm font-medium text-opus-dark transition hover:border-opus-dark xl:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
            >
              Menu
            </button>
          </div>

          <div class="hidden min-w-0 items-center gap-4 xl:flex">
            <div class="min-w-0 flex-1 overflow-hidden">
              <S1Underline selector='[data-s1-item]' active='[aria-current="page"]'>
                <nav aria-label="Navigation principale" class="flex min-w-0 items-center justify-end gap-4 2xl:gap-5">
                  {navItems.map((item) => (
                    <a
                      href={item.href}
                      data-s1-item
                      aria-current={isActive(item.href) ? "page" : undefined}
                      class:list={[
                        "inline-flex shrink-0 min-h-10 items-center pb-3 text-[0.72rem] font-medium uppercase tracking-[0.12em] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]",
                        isActive(item.href)
                          ? "text-opus-dark"
                          : "text-neutral-500 hover:text-opus-dark",
                      ]}
                    >
                      {item.label}
                    </a>
                  ))}
                </nav>
              </S1Underline>
            </div>

            <div class="shrink-0">
              <a
                href="/contact"
                class="inline-flex min-h-12 items-center justify-center whitespace-nowrap border border-opus-dark bg-opus-dark px-4 text-[0.8rem] font-medium text-white shadow-[0_10px_24px_rgba(0,0,0,0.08)] transition hover:border-black hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)] 2xl:px-5"
              >
                Soumettre un besoin
              </a>
            </div>
          </div>
        </div>
      </div>

      <div
        id="mobile-drawer"
        data-mobile-drawer
        hidden
        class="border-t border-neutral-200 bg-white xl:hidden"
      >
        <div class="mx-auto w-full max-w-[1720px] px-4 py-5 md:px-8">
          <nav aria-label="Navigation mobile" class="flex flex-col">
            {navItems.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "border-b border-neutral-200 py-4 text-sm font-medium uppercase tracking-[0.14em] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]",
                  isActive(item.href)
                    ? "text-opus-dark"
                    : "text-neutral-500 hover:text-opus-dark",
                ]}
              >
                {item.label}
              </a>
            ))}

            <a
              href="/contact"
              class="mt-5 inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-5 text-sm font-medium text-white transition hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
            >
              Soumettre un besoin
            </a>
          </nav>
        </div>
      </div>
    </header>

    <slot />

    <footer class="relative border-t border-neutral-200 bg-white">
      <div
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-opus-red/80 via-opus-red/55 to-transparent"
      ></div>

      <div class:list={[
        "mx-auto grid w-full max-w-[1720px] grid-cols-1 px-4 md:px-8 lg:grid-cols-[1.15fr_.9fr_.95fr] xl:px-10",
        hasCompactFooter ? "gap-8 py-9 md:py-10" : "gap-10 py-12 md:py-14",
      ]}>
        <div class="max-w-[56ch]">
          <a
            href="/"
            class="inline-flex items-center transition-opacity hover:opacity-80 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
            aria-label="Accueil OPUS Technology"
          >
            <BrandLogo theme="dark" className="h-8 w-auto" />
          </a>

          <p class:list={[
            "text-sm leading-7 text-neutral-700 md:text-[0.98rem]",
            hasCompactFooter ? "mt-4" : "mt-5",
          ]}>
            {motherPhrase}
          </p>

          <p class:list={[
            "text-sm leading-7 text-neutral-700",
            hasCompactFooter ? "mt-4" : "mt-5",
          ]}>
            contact@opus-tek.ca · +1 418-717-9653 · +216 98 519 889
          </p>

          <p class="mt-3 text-sm leading-7 text-neutral-500">
            Canada (Québec) · Tunisie (Sousse) · <a href="https://www.opus-tek.com" class="underline-offset-2 hover:underline">www.opus-tek.com</a>
          </p>

          <p class:list={[
            "text-sm leading-7 text-neutral-500",
            hasCompactFooter ? "mt-4" : "mt-5",
          ]}>
            © 2026 OPUS Technology. Tous droits réservés.
          </p>
        </div>

        <div>
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
            Navigation
          </p>

          <ul class:list={[
            "mt-4",
            hasCompactFooter ? "space-y-2" : "space-y-3",
          ]}>
            {footerNavItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm leading-6 text-neutral-700 transition hover:text-opus-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
            Légal & social
          </p>

          <ul class:list={[
            "mt-4",
            hasCompactFooter ? "space-y-2" : "space-y-3",
          ]}>
            <li>
              <a
                href="/propriete-intellectuelle"
                class="text-sm leading-6 text-neutral-700 transition hover:text-opus-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
              >
                Propriété intellectuelle
              </a>
            </li>
            <li>
              <a
                href="/confidentialite"
                class="text-sm leading-6 text-neutral-700 transition hover:text-opus-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
              >
                Politique de confidentialité
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com/company/opus-tek/?viewAsMember=true"
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 text-sm leading-6 text-neutral-700 transition hover:text-opus-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="M8 11v5" />
                  <path d="M8 8h.01" />
                  <path d="M12 13.5V16" />
                  <path d="M12 11v5" />
                  <path d="M12 13.5a2.5 2.5 0 0 1 5 0V16" />
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                </svg>
                <span>LinkedIn</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        function initBaseLayout() {
          const toggle = document.querySelector("[data-mobile-menu-toggle]");
          const drawer = document.querySelector("[data-mobile-drawer]");

          if (!(toggle instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
          if (toggle.dataset.baseReady === "true") return;
          toggle.dataset.baseReady = "true";

          const openMenu = () => {
            drawer.hidden = false;
            toggle.setAttribute("aria-expanded", "true");
            document.body.classList.add("overflow-hidden");
          };

          const closeMenu = () => {
            drawer.hidden = true;
            toggle.setAttribute("aria-expanded", "false");
            document.body.classList.remove("overflow-hidden");
          };

          toggle.addEventListener("click", () => {
            const expanded = toggle.getAttribute("aria-expanded") === "true";
            if (expanded) closeMenu();
            else openMenu();
          });

          drawer.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
          });

          window.addEventListener("keydown", (event) => {
            if (event.key === "Escape") closeMenu();
          });

          window.addEventListener("resize", () => {
            if (window.innerWidth >= 1280) closeMenu();
          });
        }

        function initReveal() {
          const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const targets = Array.from(
            document.querySelectorAll("[data-revealable], main > section, h1, h2")
          );

          if (!targets.length) return;

          if (reduceMotion) {
            targets.forEach((el) => {
              el.setAttribute("data-reveal", "");
              el.classList.add("is-visible");
            });
            return;
          }

          targets.forEach((el) => {
            if (!el.hasAttribute("data-reveal")) {
              el.setAttribute("data-reveal", "");
            }
          });

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            {
              rootMargin: "0px 0px -10% 0px",
              threshold: 0.12,
            }
          );

          targets.forEach((el) => {
            if (!el.classList.contains("is-visible")) observer.observe(el);
          });
        }

        initBaseLayout();
        initReveal();

        document.addEventListener("astro:page-load", () => {
          initBaseLayout();
          initReveal();
        });
      })();
    </script>
  </body>
</html>
