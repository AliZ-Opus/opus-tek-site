---
import "../styles/global.css";
import { ViewTransitions } from "astro:transitions";
import S1Underline from "../components/nav/S1Underline.astro";
import Cursor from "../components/Cursor.astro";

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "OPUS Technology",
  description = "OPUS Technology accompagne les organisations dans l’architecture, l’intégration, les plateformes et l’intelligence artificielle.",
  ogImage = "/og/opus-hero-cgi-hq.jpg",
} = Astro.props;

const navItems: NavItem[] = [
  { label: "Services", href: "/services" },
  { label: "Offres", href: "/offres" },
  { label: "Confiance", href: "/confiance" },
  { label: "Phoenixx", href: "/phoenixx-opus" },
  { label: "Ressources", href: "/ressources" },
  { label: "Équipe", href: "/equipe" },
  { label: "Contact", href: "/contact" },
];

const footerNavItems: NavItem[] = [
  { label: "Services", href: "/services" },
  { label: "Offres", href: "/offres" },
  { label: "Confiance", href: "/confiance" },
  { label: "Phoenixx", href: "/phoenixx-opus" },
  { label: "Ressources", href: "/ressources" },
  { label: "Équipe", href: "/equipe" },
];

const currentPath = Astro.url.pathname;
const canonical = Astro.url.href;
const siteName = "OPUS Technology";

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
};

const resolvedOgImage = ogImage.startsWith("http")
  ? ogImage
  : new URL(ogImage, Astro.site ?? Astro.url).href;

const faviconSvg = `
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <rect width="64" height="64" fill="#050505"/>
  <path d="M32 14c11.046 0 20 8.954 20 20s-8.954 20-20 20-20-8.954-20-20 8.954-20 20-20Zm0 6c-7.732 0-14 6.268-14 14s6.268 14 14 14 14-6.268 14-14-6.268-14-14-14Z" fill="#FFFFFF"/>
  <circle cx="48" cy="16" r="4" fill="#FF0000"/>
</svg>
`.trim();

const faviconHref = `data:image/svg+xml;charset=UTF-8,${encodeURIComponent(faviconSvg)}`;
---

<!doctype html>
<html lang="fr" class="h-full scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <ViewTransitions />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no, date=no, email=no, address=no" />
    <meta name="robots" content="index,follow" />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content="OPUS Technology — visuel architectural premium" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
  </head>

  <body class="min-h-full bg-white font-[Inter,sans-serif] text-opus-dark antialiased">
    <Cursor />

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[120] focus:inline-flex focus:min-h-11 focus:items-center focus:justify-center focus:bg-white focus:px-4 focus:text-sm focus:font-medium focus:text-opus-dark focus:outline focus:outline-2 focus:outline-offset-2 focus:outline-[rgba(255,0,0,.45)]"
    >
      Aller au contenu principal
    </a>

    <header class="sticky top-0 z-[100] border-b border-black/6 bg-white/78 backdrop-blur-md supports-[backdrop-filter]:bg-white/72">
      <div class="mx-auto w-full max-w-[1680px] flex items-center justify-between gap-6 px-4 py-4 md:px-8 xl:px-10">
        <a
          href="/"
          class="inline-flex shrink-0 items-center gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
          aria-label="Accueil OPUS Technology"
        >
          <span class="inline-flex items-center text-[0.95rem] font-semibold uppercase tracking-[0.28em] text-opus-dark">
            <span>OPUS</span>
            <span class="mx-2 inline-block h-[0.52rem] w-[0.52rem] rounded-full bg-opus-red"></span>
            <span class="text-neutral-500">Technology</span>
          </span>
        </a>

        <div class="hidden min-w-0 flex-1 items-center justify-center xl:flex">
          <S1Underline selector='[data-s1-item]' active='[aria-current="page"]'>
            <nav aria-label="Navigation principale" class="flex min-w-0 items-center gap-7">
              {navItems.map((item) => (
                <a
                  href={item.href}
                  data-s1-item
                  aria-current={isActive(item.href) ? "page" : undefined}
                  class:list={[
                    "inline-flex min-h-10 items-center pb-3 text-[0.77rem] font-medium uppercase tracking-[0.16em] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]",
                    isActive(item.href)
                      ? "text-opus-dark"
                      : "text-neutral-500 hover:text-opus-dark",
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </S1Underline>
        </div>

        <div class="hidden shrink-0 items-center gap-3 xl:flex">
          <a
            href="/contact"
            class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-5 text-sm font-medium text-white transition hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
          >
            Soumettre un besoin →
          </a>
        </div>

        <button
          type="button"
          aria-expanded="false"
          aria-controls="mobile-drawer"
          data-mobile-menu-toggle
          class="inline-flex min-h-11 min-w-11 items-center justify-center border border-neutral-200 bg-white px-4 text-sm font-medium text-opus-dark transition hover:border-opus-dark xl:hidden focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
        >
          Menu
        </button>
      </div>

      <div
        id="mobile-drawer"
        data-mobile-drawer
        hidden
        class="border-t border-neutral-200 bg-white xl:hidden"
      >
        <div class="mx-auto w-full max-w-[1680px] px-4 py-5 md:px-8">
          <nav aria-label="Navigation mobile" class="flex flex-col">
            {navItems.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "border-b border-neutral-200 py-4 text-sm font-medium uppercase tracking-[0.14em] transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]",
                  isActive(item.href)
                    ? "text-opus-dark"
                    : "text-neutral-500 hover:text-opus-dark",
                ]}
              >
                {item.label}
              </a>
            ))}

            <a
              href="/contact"
              class="mt-5 inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-5 text-sm font-medium text-white transition hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
            >
              Soumettre un besoin →
            </a>
          </nav>
        </div>
      </div>
    </header>

    <slot />

    <footer class="relative border-t border-neutral-200 bg-white">
      <div
        aria-hidden="true"
        class="absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-opus-red via-opus-red/70 to-transparent"
      ></div>

      <div class="mx-auto w-full max-w-[1680px] grid grid-cols-1 gap-10 px-4 py-12 md:px-8 md:py-14 lg:grid-cols-[1.15fr_.9fr_.95fr] xl:px-10">
        <div class="max-w-[56ch]">
          <div class="inline-flex items-center text-[0.92rem] font-semibold uppercase tracking-[0.28em] text-opus-dark">
            <span>OPUS</span>
            <span class="mx-2 inline-block h-[0.5rem] w-[0.5rem] rounded-full bg-opus-red"></span>
            <span class="text-neutral-500">Technology</span>
          </div>

          <p class="mt-5 text-sm leading-7 text-neutral-700 md:text-[0.98rem]">
            Exécution claire. Gouvernance lisible.
          </p>

          <p class="mt-5 text-sm leading-7 text-neutral-500">
            © 2026 OPUS Technology. Tous droits réservés. Les modèles opérationnels et méthodologies documentaires présentés sont la propriété exclusive de l’organisation.
          </p>
        </div>

        <div>
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
            Navigation
          </p>

          <ul class="mt-4 space-y-3">
            {footerNavItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm leading-6 text-neutral-700 transition hover:text-opus-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
            Légal & Social
          </p>

          <ul class="mt-4 space-y-3">
            <li>
              <a
                href="/propriete-intellectuelle"
                class="text-sm leading-6 text-neutral-700 transition hover:text-opus-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
              >
                Propriété Intellectuelle
              </a>
            </li>
            <li>
              <a
                href="/confidentialite"
                class="text-sm leading-6 text-neutral-700 transition hover:text-opus-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
              >
                Politique de Confidentialité
              </a>
            </li>
            <li>
              <a
                href="https://www.linkedin.com"
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 text-sm leading-6 text-neutral-700 transition hover:text-opus-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="M8 11v5" />
                  <path d="M8 8h.01" />
                  <path d="M12 13.5V16" />
                  <path d="M12 11v5" />
                  <path d="M12 13.5a2.5 2.5 0 0 1 5 0V16" />
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                </svg>
                <span>LinkedIn</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </footer>

    <script>
      function initBaseLayout() {
        const toggle = document.querySelector("[data-mobile-menu-toggle]");
        const drawer = document.querySelector("[data-mobile-drawer]");
        if (!(toggle instanceof HTMLButtonElement) || !(drawer instanceof HTMLElement)) return;
        if (toggle.dataset.baseReady === "true") return;
        toggle.dataset.baseReady = "true";

        const openMenu = () => {
          drawer.hidden = false;
          toggle.setAttribute("aria-expanded", "true");
          document.body.classList.add("overflow-hidden");
        };

        const closeMenu = () => {
          drawer.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
          document.body.classList.remove("overflow-hidden");
        };

        toggle.addEventListener("click", () => {
          const expanded = toggle.getAttribute("aria-expanded") === "true";
          if (expanded) closeMenu();
          else openMenu();
        });

        drawer.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", closeMenu);
        });

        window.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeMenu();
        });

        window.addEventListener("resize", () => {
          if (window.innerWidth >= 1280) closeMenu();
        });
      }

      function initReveal() {
        if (document.documentElement.dataset.revealReady === "true") return;
        document.documentElement.dataset.revealReady = "true";

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const targets = Array.from(document.querySelectorAll("section, h1, h2"));

        if (!targets.length) return;

        if (reduceMotion) {
          targets.forEach((el) => {
            el.setAttribute("data-reveal", "");
            el.classList.add("is-visible");
          });
          return;
        }

        targets.forEach((el) => {
          el.setAttribute("data-reveal", "");
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            rootMargin: "0px 0px -10% 0px",
            threshold: 0.12,
          }
        );

        targets.forEach((el) => observer.observe(el));
      }

      initBaseLayout();
      initReveal();

      document.addEventListener("astro:page-load", () => {
        initBaseLayout();
        document.documentElement.dataset.revealReady = "false";
        initReveal();
      });
    </script>
  </body>
</html>