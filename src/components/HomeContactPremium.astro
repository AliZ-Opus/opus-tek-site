---
const services = [
  "Architecture",
  "Ingénierie",
  "Intelligence",
  "Delivery TI & intégration",
  "Renfort & équipes flexibles",
  "IA & automatisation pragmatique",
];
---

<section class="home-contact" id="contact-final" aria-label="Contact premium">
  <div class="wrap">
    <div class="home-contact__shell">
      <div class="home-contact__intro">
        <div class="home-contact__kicker">CONTACT</div>
        <h2 class="home-contact__title">Parler à un expert, sans friction.</h2>
        <p class="home-contact__lead">
          Décrivez votre contexte en quelques lignes. Nous revenons rapidement avec un cadrage initial, une trajectoire et les prochaines étapes possibles.
        </p>

        <div class="home-contact__proofs" aria-label="Signaux de réassurance">
          <span>Réponse rapide</span>
          <span>Cadrage clair</span>
          <span>Exécution gouvernée</span>
          <span>NDA-safe</span>
        </div>

        <div class="home-contact__aside card-lite">
          <div class="card-lite__label">CONTACT DIRECT</div>
          <p><strong>contact@opus-tek.ca</strong></p>
          <p>Phoenixx + OPUS, delivery senior, structuré et traçable.</p>
        </div>
      </div>

      <div class="home-contact__panel" aria-labelledby="contact-form-title">
        <div class="home-contact__panel-inner">
          <div class="home-contact__panel-head">
            <h3 id="contact-form-title">Soumettre un besoin</h3>
            <p>Nom, courriel, service visé, message. Validation visuelle immédiate.</p>
          </div>

          <form class="contact-premium-form" data-contact-premium novalidate>
            <div class="cpf-grid">
              <div class="cpf-field">
                <label for="cpf-name">Nom <span aria-hidden="true">*</span></label>
                <input id="cpf-name" name="name" type="text" autocomplete="name" required />
                <small class="cpf-error" data-error-for="name"></small>
              </div>

              <div class="cpf-field">
                <label for="cpf-email">Courriel <span aria-hidden="true">*</span></label>
                <input id="cpf-email" name="email" type="email" autocomplete="email" required />
                <small class="cpf-error" data-error-for="email"></small>
              </div>
            </div>

            <div class="cpf-field">
              <label for="cpf-service">Service visé</label>
              <select id="cpf-service" name="service">
                <option value="">Sélectionner un service</option>
                {services.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>

            <div class="cpf-field">
              <label for="cpf-message">Message <span aria-hidden="true">*</span></label>
              <textarea id="cpf-message" name="message" rows="6" required placeholder="Contexte, urgence, objectif, contraintes..."></textarea>
              <small class="cpf-error" data-error-for="message"></small>
            </div>

            <div class="cpf-actions">
              <button class="btn btn-primary btn-laser" type="submit">Envoyer la demande</button>
              <a class="btn btn-secondary" href="/contact">Version complète</a>
            </div>

            <div class="cpf-status" role="status" aria-live="polite" data-status></div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    const root = document.currentScript?.closest('.home-contact') as HTMLElement | null;
    const form = root?.querySelector('[data-contact-premium]') as HTMLFormElement | null;
    const status = root?.querySelector('[data-status]') as HTMLElement | null;
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const setFieldState = (
      field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null,
      kind: '' | 'error' | 'valid',
      message = ''
    ) => {
      if (!field) return;
      const wrapper = field.closest('.cpf-field') as HTMLElement | null;
      wrapper?.classList.remove('is-error', 'is-valid');
      if (kind) wrapper?.classList.add(kind === 'error' ? 'is-error' : 'is-valid');
      const errorSlot = wrapper?.querySelector(`[data-error-for="${field.name}"]`) as HTMLElement | null;
      if (errorSlot) errorSlot.textContent = message;
    };

    const setStatus = (kind: string, text: string) => {
      if (!status) return;
      status.textContent = text || '';
      status.dataset.kind = kind || '';
    };

    const validateField = (
      field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null
    ) => {
      if (!field) return true;
      const value = (field.value || '').trim();
      if (field.required && !value) {
        setFieldState(field, 'error', 'Ce champ est requis.');
        return false;
      }
      if (field.name === 'email' && value && !emailRegex.test(value)) {
        setFieldState(field, 'error', 'Adresse courriel invalide.');
        return false;
      }
      setFieldState(field, value ? 'valid' : '');
      return true;
    };

    form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select').forEach((el) => {
      el.addEventListener('blur', () => validateField(el));
      el.addEventListener('input', () => {
        if (el.closest('.cpf-field')?.classList.contains('is-error')) validateField(el);
      });
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      setStatus('', '');
      const fields = Array.from(
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input[name], textarea[name], select[name]')
      );
      const targets = fields.filter((f) => ['name','email','message'].includes(f.name));
      const ok = targets.map(validateField).every(Boolean);
      if (!ok) {
        setStatus('error', 'Merci de corriger les champs requis avant l’envoi.');
        targets.find((f) => f.closest('.cpf-field')?.classList.contains('is-error'))?.focus();
        return;
      }
      setStatus('success', 'Demande prête. Branchez ce formulaire à /api/contact pour l’envoi réel.');
      form.reset();
      form.querySelectorAll<HTMLElement>('.cpf-field').forEach((f) => f.classList.remove('is-valid'));
    });
  </script>

  <style>
    .home-contact{ background:#fff; padding: clamp(34px,4vw,54px) 0 60px; border-top:1px solid rgba(var(--line),1); }
    .home-contact__shell{
      display:grid; grid-template-columns: minmax(0,1.05fr) minmax(0,1fr); gap: clamp(16px,2.2vw,28px);
      align-items:start;
    }
    .home-contact__kicker{ font-size:12px; font-weight:900; letter-spacing:.18em; text-transform:uppercase; color: rgba(var(--muted),.95); }
    .home-contact__title{
      margin: 10px 0 0; font-family: ui-serif, Georgia, "Times New Roman", Times, serif;
      font-size: clamp(30px, 3vw, 42px); line-height:1.08; letter-spacing:-.02em;
    }
    .home-contact__lead{ margin: 12px 0 0; max-width: 60ch; color: rgba(var(--ink),.84); line-height:1.8; font-size:15px; }
    .home-contact__proofs{ margin-top: 16px; display:flex; flex-wrap:wrap; gap:8px; }
    .home-contact__proofs span{
      border:1px solid rgba(var(--line),1); border-radius:999px; background: rgba(0,0,0,.012);
      padding: 6px 10px; font-size:12px; font-weight:800; color: rgba(var(--ink),.86);
    }
    .card-lite{
      margin-top: 16px; border:1px solid rgba(var(--line),1); border-radius: 14px; background: rgba(0,0,0,.01);
      padding: 14px; box-shadow: 0 4px 12px rgba(17,19,23,.02);
    }
    .card-lite__label{ font-size:11px; font-weight:900; letter-spacing:.17em; text-transform:uppercase; color: rgba(var(--muted),.95); }
    .card-lite p{ margin: 8px 0 0; color: rgba(var(--ink),.82); line-height:1.65; font-size:14px; }
    .home-contact__panel{
      border:1px solid rgba(var(--line),1);
      border-radius: 18px;
      background: linear-gradient(180deg, rgba(255,255,255,.96), rgba(255,255,255,.9));
      box-shadow: 0 10px 28px rgba(17,19,23,.04);
      position: relative;
      overflow:hidden;
    }
    .home-contact__panel::before{
      content:""; position:absolute; left:0; top:0; right:0; height:1.75px;
      background: linear-gradient(90deg, rgba(var(--red),.7), rgba(var(--red),0));
      opacity:.85;
      pointer-events:none;
    }
    .home-contact__panel-inner{ padding: 18px; }
    .home-contact__panel-head h3{ margin:0; font-size: 20px; line-height:1.2; font-weight: 950; }
    .home-contact__panel-head p{ margin: 6px 0 0; color: rgba(var(--ink),.78); font-size: 14px; line-height:1.6; }
    .contact-premium-form{ margin-top: 14px; display:grid; gap: 12px; }
    .cpf-grid{ display:grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .cpf-field{ display:grid; gap: 6px; }
    .cpf-field label{ font-size: 12px; font-weight: 850; color: rgba(var(--ink),.9); letter-spacing:.01em; }
    .cpf-field label span{ color: rgb(var(--red)); }
    .cpf-field input, .cpf-field select, .cpf-field textarea{
      width:100%; border-radius: 12px; border: 1px solid rgba(var(--line),1);
      background:#fff; color: rgb(var(--ink)); padding: 11px 12px; font: inherit;
      transition: border-color .16s ease, box-shadow .16s ease, background .16s ease;
    }
    .cpf-field textarea{ resize: vertical; min-height: 132px; }
    .cpf-field input:focus, .cpf-field select:focus, .cpf-field textarea:focus{
      outline: none; border-color: rgba(var(--ink),.25); box-shadow: 0 0 0 3px rgba(17,19,23,.05);
    }
    .cpf-error{ min-height: 1em; font-size: 11px; color: rgba(var(--red),.92); }
    .cpf-field.is-error input, .cpf-field.is-error select, .cpf-field.is-error textarea{
      border-color: rgba(var(--red),.55); box-shadow: 0 0 0 3px rgba(var(--red),.08);
    }
    .cpf-field.is-valid input, .cpf-field.is-valid textarea{
      border-color: rgba(17,19,23,.2);
      background: linear-gradient(180deg, rgba(255,255,255,1), rgba(0,0,0,.004));
    }
    .cpf-actions{ display:flex; gap: 10px; flex-wrap:wrap; padding-top: 2px; }
    .btn-laser{
      background: #0f1115;
      color:#fff;
      border: 1px solid rgba(15,17,21,.92);
      box-shadow: 0 8px 18px rgba(17,19,23,.08);
      position:relative;
      overflow:hidden;
      transition: background .3s ease, color .3s ease, border-color .3s ease, box-shadow .3s ease;
    }
    .btn-laser::after{
      content:""; position:absolute; inset:0; opacity:0;
      background: linear-gradient(90deg, rgba(var(--red),0), rgba(var(--red),.22), rgba(var(--red),0));
      transition: opacity .16s ease;
      pointer-events:none;
    }
    .btn-laser:hover::after, .btn-laser:focus-visible::after{ opacity: 1; }
    .btn-laser:hover, .btn-laser:focus-visible{
      background: rgb(var(--red));
      color:#fff;
      border-color: rgba(var(--red),.92);
      box-shadow: 0 10px 20px rgba(var(--red),.18), 0 8px 18px rgba(17,19,23,.08);
    }
    .cpf-status{
      min-height: 22px; border-radius: 10px; padding: 0; font-size: 13px; line-height:1.45;
      color: rgba(var(--ink),.78);
    }
    .cpf-status[data-kind="success"]{
      padding: 10px 12px; border:1px solid rgba(var(--line),1); background: rgba(0,0,0,.012); color: rgba(var(--ink),.9);
    }
    .cpf-status[data-kind="error"]{
      padding: 10px 12px; border:1px solid rgba(var(--red),.3); background: rgba(var(--red),.04); color: rgba(var(--ink),.92);
    }
    @media (max-width: 980px){
      .home-contact__shell{ grid-template-columns: 1fr; }
      .home-contact__panel{ order: 2; }
      .cpf-grid{ grid-template-columns: 1fr; }
    }
  </style>
</section>
