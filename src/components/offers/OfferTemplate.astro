---
import OfferAnchors from './OfferAnchors.astro';
const { offer } = Astro.props;
const anchorItems = [
  { id: 'overview', label: 'Overview' },
  { id: 'method', label: 'Method' },
  { id: 'proof', label: 'Proof' },
  { id: 'trust', label: 'Trust' },
];
---
<section class="offer-hero page">
  <div class="wrap">
    <div class="page-inner offer-page-inner">
      <div class="page-kicker">OFFRE • {offer.domain.toUpperCase()}</div>
      <h1 class="page-title">{offer.title}</h1>
      <p class="page-lead">{offer.tagline}</p>
      <div class="hero-cta offer-hero__cta">
        <a class="btn btn-primary" href="/contact">Soumettre un besoin →</a>
        <a class="btn btn-secondary" href="/offres">Retour aux offres →</a>
      </div>
      <OfferAnchors items={anchorItems} />
    </div>
  </div>
</section>

<section id="overview" class="offer-section">
  <div class="wrap offer-grid-2">
    <div class="offer-copy card card-soft">
      <h2>Overview</h2>
      {offer.overview.map((p) => <p>{p}</p>)}
      <div class="offer-mini-proof">
        <span class="label">Mini preuve</span>
        <span class="value">{offer.proof[0].value}</span>
        <span class="text">{offer.proof[0].label} structuré pour démarrer vite et propre.</span>
      </div>
    </div>
    <div class="offer-aside card card-soft">
      <h3>Pains adressés</h3>
      <ul class="offer-list">
        {offer.pains.map((item) => <li>{item}</li>)}
      </ul>
      <h3>Livrables (7)</h3>
      <ul class="offer-list offer-list--compact">
        {offer.deliverables.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<section id="method" class="offer-section offer-section--alt">
  <div class="wrap">
    <div class="offer-section-head">
      <div class="page-kicker">METHOD</div>
      <h2 class="offer-h2">Architecture First — preuve dans le flux</h2>
      <p class="page-lead">Chaque étape produit une décision, un livrable et une preuve observable. Pas de récit sans trace.</p>
    </div>
    <div class="offer-method-grid">
      {offer.method.map((step, idx) => (
        <article class="offer-method-card">
          <div class="offer-step-index">0{idx + 1}</div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
          <div class="offer-proof-chip">{step.proof}</div>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="proof" class="offer-section">
  <div class="wrap">
    <div class="offer-section-head">
      <div class="page-kicker">PROOF</div>
      <h2 class="offer-h2">Preuves intégrées au récit</h2>
      <p class="page-lead">Règle 3/6/9 : 3 domaines, 6 piliers de delivery, 9 points de preuve. Les chiffres sont visibles, le reste reste sobre.</p>
    </div>
    <div class="offer-proof-grid">
      {offer.proof.map((p) => (
        <article class="offer-proof-card">
          <div class="offer-proof-card__label">{p.label}</div>
          <div class="offer-proof-card__value">{p.value}</div>
          <p>{p.note}</p>
        </article>
      ))}
      {Array.from({ length: 6 }).map((_,i) => (
        <article class="offer-proof-node">
          <div class="node-title">Preuve #{i+4}</div>
          <p>Décision, livrable ou validation relié(e) au backlog et aux critères d’acceptation.</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="trust" class="offer-section offer-section--alt">
  <div class="wrap">
    <div class="offer-section-head">
      <div class="page-kicker">TRUST</div>
      <h2 class="offer-h2">Confiance opérationnelle</h2>
      <p class="page-lead">La confiance n’est pas un slogan : elle est construite via contrôles, responsabilités et handover exploitable.</p>
    </div>
    <div class="trust-cards-2x2">
      {offer.trust.map((t) => (
        <article class="trust-card">
          <h3>{t.title}</h3>
          <p>{t.text}</p>
        </article>
      ))}
    </div>
    <div class="hero-cta" style="margin-top:20px;">
      <a class="btn btn-primary" href="/contact">Soumettre un besoin →</a>
      <a class="btn btn-secondary" href="/confiance">Voir le hub Confiance →</a>
    </div>
  </div>
</section>
