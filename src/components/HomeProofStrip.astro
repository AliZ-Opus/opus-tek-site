---
import S1Underline from "./nav/S1Underline.astro";

interface ProofBadge {
  label: string;
  icon: "delivery" | "senior" | "nda";
}

interface ProofCard {
  value: string;
  label: "Documented" | "Verified";
  title: string;
  text: string;
}

interface Props {
  badges?: ProofBadge[];
  cards?: ProofCard[];
  authorityLine?: string;
}

const {
  badges = [
    { label: "Delivery-ready", icon: "delivery" },
    { label: "Senior-led", icon: "senior" },
    { label: "NDA-safe", icon: "nda" },
  ],
  cards = [
    {
      value: "12+",
      label: "Documented",
      title: "Delivery disciplines",
      text: "Architecture, intégration, plateformes, IA et cadrage exécutif structurés.",
    },
    {
      value: "100%",
      label: "Verified",
      title: "Traceable outputs",
      text: "Décisions, livrables et échanges organisés dans un cadre lisible et crédible.",
    },
  ],
  authorityLine = "Des résultats traçables, structurés et soutenus par une discipline d’exécution senior.",
} = Astro.props;

const iconClass = "h-4 w-4 text-opus-dark";
---

<section aria-label="Preuves OPUS" class="relative z-30 w-full">
  <div class="w-full border border-neutral-200 bg-white shadow-[0_18px_50px_rgba(0,0,0,0.08)]">
    <div class="w-full grid grid-cols-1 lg:grid-cols-[1.05fr_1.2fr_.9fr]">
      <div class="order-1 border-b border-neutral-200 p-6 md:p-7 lg:order-2 lg:border-b-0 lg:border-x">
        <div class="w-full grid grid-cols-1 gap-4 sm:grid-cols-2">
          {cards.map((card) => (
            <S1Underline selector='[data-s1-item]' active='[data-s1-item]'>
              <article
                data-s1-item
                tabindex="0"
                class="group relative h-full min-h-[220px] border border-neutral-200 bg-white p-5 transition hover:border-neutral-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
              >
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
                  {card.label}
                </p>

                <p class="mt-4 text-[clamp(2rem,4vw,3rem)] font-semibold leading-none tracking-[-0.04em] text-opus-red">
                  {card.value}
                </p>

                <h2 class="mt-4 text-base font-semibold leading-6 text-opus-dark">
                  {card.title}
                </h2>

                <p class="mt-3 text-sm leading-6 text-neutral-700">
                  {card.text}
                </p>
              </article>
            </S1Underline>
          ))}
        </div>
      </div>

      <div class="order-2 border-b border-neutral-200 p-6 md:p-7 lg:order-1 lg:border-b-0">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
          Delivery posture
        </p>

        <div class="mt-4 space-y-3">
          {badges.map((badge) => (
            <div class="flex items-center gap-3 border border-neutral-200 bg-white px-4 py-3">
              <span class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-neutral-200 bg-neutral-50">
                {
                  badge.icon === "delivery" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
                      <path d="M4 12h6l2-3 3 6 2-3h3" />
                      <path d="M4 6h16" />
                      <path d="M4 18h16" />
                    </svg>
                  )
                }
                {
                  badge.icon === "senior" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
                      <circle cx="12" cy="8" r="3" />
                      <path d="M5 19c1.5-3 4-4.5 7-4.5s5.5 1.5 7 4.5" />
                      <path d="M19 5l1.5 1.5L23 4" />
                    </svg>
                  )
                }
                {
                  badge.icon === "nda" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class={iconClass} aria-hidden="true">
                      <path d="M7 11V8a5 5 0 0 1 10 0v3" />
                      <rect x="5" y="11" width="14" height="9" rx="2" />
                      <path d="M12 15v2" />
                    </svg>
                  )
                }
              </span>

              <div>
                <p class="text-sm font-medium leading-5 text-opus-dark">{badge.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="order-3 p-6 md:p-7">
        <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
          Proof discipline
        </p>

        <div class="mt-3 h-[2px] w-12 bg-opus-red"></div>

        <p class="mt-5 text-[1.05rem] leading-8 text-opus-dark md:text-[1.1rem]">
          {authorityLine}
        </p>

        <p class="mt-5 text-sm leading-6 text-neutral-700">
          Chaque engagement est cadré pour rendre les avancées visibles, justifiables et exploitables, sans bruit inutile.
        </p>
      </div>
    </div>
  </div>
</section>