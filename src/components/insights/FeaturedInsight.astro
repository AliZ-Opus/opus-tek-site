---
interface Props {
  title?: string;
  body?: string;
  href?: string;
}

const {
  title = "Observatoire des Compétences IA 2026",
  body = "Participez à l’étude de marché sur l’éducation globale en IA, les MBA internationaux, les certifications professionnelles et les stages au Canada.",
  href = "/insights/etude-ia-2026",
} = Astro.props;
---

<section aria-label="Hub Insights" class="relative border-t border-neutral-200 bg-white py-20 md:py-24">
  <div class="mx-auto w-full max-w-[1680px] px-4 md:px-8 xl:px-10">
    <div class="mb-10 max-w-[760px]">
      <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
        INSIGHTS
      </p>

      <h2 class="mt-5 max-w-[11ch] text-[clamp(2rem,4vw,4.2rem)] font-black leading-[0.94] tracking-[-0.04em] text-opus-dark">
        Recherche, capture et vitalité éditoriale.
      </h2>

      <p class="mt-6 max-w-[62ch] text-base leading-8 text-neutral-700 md:text-[1.02rem]">
        OPUS publie des artefacts utiles : études de terrain, briefings exécutifs et annonces ciblées.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.2fr_.8fr]">
      <article class="group relative min-h-[440px] overflow-hidden border border-neutral-200 bg-white shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-[1.06fr_.94fr]">
          <div class="relative p-8 md:p-10 lg:p-12">
            <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">
              FEATURED INSIGHT
            </p>

<h3 class="mt-5 max-w-[12ch] text-[clamp(2.2rem,4.3vw,4.5rem)] font-black leading-[0.96] tracking-[-0.04em] text-opus-dark">
  {title}
</h3>

            <p class="mt-6 max-w-[60ch] text-base leading-8 text-neutral-700 md:text-[1.02rem]">
              {body}
            </p>

            <div class="mt-7 h-[2px] w-16 bg-opus-red"></div>

            <div class="mt-8">
              <a
                href={href}
                class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white shadow-sm transition hover:border-black hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
              >
                Participer à l'étude de marché →
              </a>
            </div>
          </div>

          <div class="relative min-h-[280px] overflow-hidden bg-neutral-100">
            <div
              class="absolute inset-0 opacity-95"
              style="background:
                radial-gradient(circle at 18% 26%, rgba(255,255,255,0.95), transparent 28%),
                radial-gradient(circle at 72% 40%, rgba(255,255,255,0.6), transparent 24%),
                linear-gradient(135deg, #f5f5f5 0%, #dddddd 48%, #f7f7f7 100%);
                mix-blend-mode: luminosity;"
              aria-hidden="true"
            ></div>

            <div class="absolute inset-0 flex items-end p-8 md:p-10">
              <div class="max-w-[420px] border border-white/50 bg-white/80 p-5 shadow-sm backdrop-blur-md">
                <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
                  RESEARCH LAB
                </p>
                <p class="mt-3 text-sm leading-7 text-neutral-700">
                  Étude de terrain sur les attentes réelles autour des MBA IA, certifications data et stages internationaux.
                </p>
              </div>
            </div>
          </div>
        </div>
      </article>

      <div class="grid grid-cols-1 gap-6">
        <article class="border border-neutral-200 bg-white p-7 shadow-sm">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
            EXECUTIVE BRIEFING
          </p>

          <div class="mt-3 h-[2px] w-12 bg-opus-red"></div>

          <h3 class="mt-4 text-[1.2rem] font-semibold leading-7 text-opus-dark">
            Briefing IA 2026
          </h3>

          <p class="mt-4 text-sm leading-7 text-neutral-700">
            Une lecture courte, dense et exploitable pour décideurs, partenaires et sponsors de programme.
          </p>

          <div class="mt-6">
            <a
              href="/ressources/executive-one-pager"
              class="inline-flex min-h-11 items-center justify-center border border-neutral-300 bg-white px-5 text-sm font-medium text-opus-dark transition hover:border-opus-dark hover:bg-opus-dark hover:text-white"
            >
              Consulter le briefing →
            </a>
          </div>
        </article>

        <article class="border border-neutral-200 bg-white p-7 shadow-sm">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">
            ACTUALITÉS
          </p>

          <div class="mt-3 h-[2px] w-12 bg-opus-red"></div>

          <div class="mt-4 space-y-4">
            <div>
              <p class="text-[1rem] font-semibold leading-6 text-opus-dark">
                OPUS × Phoenixx
              </p>
              <p class="mt-1 text-sm leading-7 text-neutral-700">
                Delivery lead, gouvernance lisible et capacité d’exécution renforcée.
              </p>
            </div>

            <div class="border-t border-neutral-100 pt-4">
              <p class="text-[1rem] font-semibold leading-6 text-opus-dark">
                Observatoire IA 2026
              </p>
              <p class="mt-1 text-sm leading-7 text-neutral-700">
                Le premier artefact de capture et de recherche est maintenant actif.
              </p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
