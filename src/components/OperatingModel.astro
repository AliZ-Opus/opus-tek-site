---
interface ProofNode { label: string; text: string; }
interface Props { phoenixxTitle?: string; phoenixxBody?: string; opusTitle?: string; opusBody?: string; proofNodes?: ProofNode[]; }
const { phoenixxTitle = "Phoenixx", phoenixxBody = "Fondation canadienne, cadre commercial, continuité de relation, structure de gouvernance et ancrage marché.", opusTitle = "OPUS Technology", opusBody = "Unité d’exécution agile, expertise technologique, delivery ciblé, intégration, architecture et capacité d’accélération.", proofNodes = [{label:'Established in Canada',text:'Présence et cadre d’affaires établis côté canadien.'},{label:'Structured Governance',text:'Mode opératoire clair, traçable et encadré.'}] } = Astro.props;
---
<section class="relative bg-white py-16 md:py-24">
  <div class="mx-auto max-w-[1680px] px-4 md:px-8 xl:px-10">
    <div class="max-w-[920px]"><p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">OPERATING MODEL</p><h2 class="mt-4 text-[clamp(2rem,4vw,3.8rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">L’agilité d’exécution, soutenue par une fondation canadienne solide.</h2><p class="mt-5 max-w-[68ch] text-base leading-8 text-neutral-700 md:text-[1.02rem]">Le modèle Phoenixx ↔ OPUS sépare clairement le rôle de soutien structurel du rôle de delivery. Cette clarté renforce la confiance, la lisibilité commerciale et la capacité d’exécution.</p></div>
    <div class="mt-14 grid grid-cols-1 items-center gap-8 lg:grid-cols-[1fr_140px_1fr]">
      <article class="border border-neutral-200 bg-white p-7 shadow-[0_16px_45px_rgba(0,0,0,0.05)] md:p-8"><p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">CANADIAN BACKING</p><div class="mt-3 h-[1.75px] w-12 bg-opus-red"></div><h3 class="mt-4 text-[1.2rem] font-semibold leading-7 text-opus-dark">{phoenixxTitle}</h3><p class="mt-4 text-sm leading-7 text-neutral-700 md:text-[0.98rem]">{phoenixxBody}</p></article>
      <div class="relative flex h-24 items-center justify-center lg:h-full"><div class="absolute left-0 right-0 top-1/2 hidden h-px -translate-y-1/2 bg-neutral-300 lg:block"></div><div class="absolute bottom-0 left-1/2 top-0 w-px -translate-x-1/2 bg-neutral-300 lg:hidden"></div><div class="relative z-10 flex items-center justify-center"><span class="block h-3.5 w-3.5 rounded-full bg-opus-red"></span></div></div>
      <article class="border border-opus-dark/10 bg-[rgb(250,250,250)] p-7 shadow-[0_18px_50px_rgba(0,0,0,0.06)] md:p-8"><p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">EXECUTION LEAD</p><div class="mt-3 h-[1.75px] w-12 bg-opus-red"></div><h3 class="mt-4 text-[1.2rem] font-semibold leading-7 text-opus-dark">{opusTitle}</h3><p class="mt-4 text-sm leading-7 text-neutral-700 md:text-[0.98rem]">{opusBody}</p></article>
    </div>
    <div class="mt-10 grid max-w-[900px] grid-cols-1 gap-4 md:grid-cols-2">{proofNodes.map((node) => <aside class="border border-neutral-200 bg-white/85 px-5 py-4 shadow-[0_8px_24px_rgba(0,0,0,0.04)] backdrop-blur-sm"><p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">{node.label}</p><div class="mt-2 h-[2px] w-10 bg-opus-red"></div><p class="mt-3 text-sm leading-6 text-neutral-700">{node.text}</p></aside>)}</div>
  </div>
</section>
