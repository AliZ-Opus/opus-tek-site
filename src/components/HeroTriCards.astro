---
type Card = {
  title: string;
  desc: string;
  href: string;
  chips: string[];
  icon: "bulb" | "gear" | "puzzle";
  cta: string;
};

const cards: Card[] = [
  {
    title: "Ressources",
    desc: "Repères, études de cas et cadres de delivery pour structurer vos décisions et réduire les zones grises.",
    href: "/ressources",
    chips: ["Études de cas", "Repères", "FAQ"],
    icon: "bulb",
    cta: "Voir les ressources",
  },
  {
    title: "Services",
    desc: "Cadrage, conception, sécurisation et exécution d'architectures et de plateformes stratégiques.",
    href: "/services",
    chips: ["Architecture", "Données", "IA", "Modernisation"],
    icon: "gear",
    cta: "Voir les services",
  },
  {
    title: "Solutions",
    desc: "Actifs et briques technologiques pour accélérer l'automatisation, la gouvernance et la traçabilité.",
    href: "/solutions",
    chips: ["Automation", "Gouvernance", "AI Engine", "Data Platform"],
    icon: "puzzle",
    cta: "Voir les solutions",
  },
];
---

<section class="tri" aria-label="Ressources, services et solutions">
  <div class="tri__grid" role="list">
    {cards.map((c) => (
      <a class="tri__card" href={c.href} role="listitem" aria-label={`${c.title} - ${c.cta}`}>
        <div class="tri__icon" aria-hidden="true">
          {c.icon === "bulb" && (
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M9 21h6M10 18h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path
                d="M7.8 13.2A6.5 6.5 0 1 1 17 13.2c-1 1-1.6 1.9-1.9 2.8H9.7c-.3-.9-.9-1.8-1.9-2.8Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
          {c.icon === "gear" && (
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" stroke="currentColor" stroke-width="1.8"/>
              <path
                d="M19.4 15a7.9 7.9 0 0 0 .1-2l2-1.5-2-3.5-2.4.7a8 8 0 0 0-1.7-1L15 4h-6l-.4 3.7a8 8 0 0 0-1.7 1L4.5 8l-2 3.5L4.5 13a8.2 8.2 0 0 0 0 2l-2 1.5 2 3.5 2.4-.7a8 8 0 0 0 1.7 1L9 22h6l.4-3.7a8 8 0 0 0 1.7-1l2.4.7 2-3.5-2.1-1.5Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
          {c.icon === "puzzle" && (
            <svg viewBox="0 0 24 24" fill="none">
              <path
                d="M4 7a3 3 0 0 1 3-3h3v6H7a3 3 0 0 1-3-3Zm10-3h3a3 3 0 0 1 3 3 3 3 0 0 1-3 3h-3V4Zm-4 10v6H7a3 3 0 0 1 0-6h3Zm4 0h3a3 3 0 0 1 0 6h-3v-6Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </div>

        <div class="tri__head">
          <h2 class="tri__title">{c.title}</h2>
          <span class="tri__arrow" aria-hidden="true">+</span>
        </div>

        <p class="tri__desc">{c.desc}</p>

        <div class="tri__chips" aria-hidden="true">
          {c.chips.map((label) => (
            <span class="tri__chip">{label}</span>
          ))}
        </div>

        <div class="tri__cta" aria-hidden="true">{c.cta}</div>
      </a>
    ))}
  </div>
</section>

<style>
  .tri{
    background:#fff;
    border-top: 1px solid rgba(var(--line),1);
    border-bottom: 1px solid rgba(var(--line),1);
  }
  .tri__grid{
    display:grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
  }
  .tri__card{
    padding: 16px 16px 14px;
    text-decoration:none;
    color: rgba(var(--ink),1);
    position: relative;
    background:#fff;
    min-height: 164px;
    transition: transform .14s ease, box-shadow .14s ease, background .14s ease, border-color .14s ease;
    outline: none;
  }
  .tri__card:not(:first-child)::before{
    content:"";
    position:absolute;
    left:0;
    top:10px;
    bottom:10px;
    width:1px;
    background: rgba(var(--line),1);
  }
  .tri__icon{
    width: 28px;
    height: 28px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border: 1px solid rgba(var(--line),1);
    border-radius: 12px;
    color: rgba(var(--ink),.86);
    margin-bottom: 4px;
    transition: border-color .14s ease, transform .14s ease;
  }
  .tri__icon svg{ width:100%;height:100%; }
  .tri__head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap: 12px;
    margin-bottom: 4px;
  }
  .tri__title{
    margin:0;
    font-size: 16px;
    font-weight: 900;
    letter-spacing: -0.01em;
  }
  .tri__arrow{
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity .14s ease, transform .14s ease;
    color: rgba(var(--ink),.72);
  }
  .tri__desc{
    margin:0;
    color: rgba(var(--ink),.80);
    font-size: 11px;
    line-height: 1.45;
    max-width: 48ch;
  }
  .tri__chips{
    margin-top: 8px;
    display:flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tri__chip{
    font-size: 11px;
    line-height: 1;
    padding: 5px 8px;
    border-radius: 999px;
    border: 1px solid rgba(var(--line),1);
    color: rgba(var(--ink),.84);
    background: #fff;
    user-select: none;
  }
  .tri__cta{
    margin-top: 8px;
    font-size: 12px;
    font-weight: 900;
    color: rgba(var(--ink),.86);
  }
  .tri__card:hover{
    background: rgba(0,0,0,0.008);
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(17,24,39,0.035);
  }
  .tri__card:hover .tri__arrow{
    opacity: 1;
    transform: translateX(0);
  }
  .tri__card:hover .tri__icon{
    border-color: rgba(var(--ink),0.22);
    transform: translateY(-1px);
  }
  .tri__card:focus-visible{
    outline: 3px solid rgba(var(--red),0.35);
    outline-offset: -2px;
  }
  @media (max-width: 980px){
    .tri__grid{ grid-template-columns: 1fr; }
    .tri__card:not(:first-child)::before{ display:none; }
    .tri__card{ border-top: 1px solid rgba(var(--line),1); }
    .tri__card:first-child{ border-top:none; }
  }
</style>
