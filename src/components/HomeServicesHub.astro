---
const domains = [
  {
    label: "Architecture",
    eyebrow: "SOCLE / ARBITRAGES / TRAJECTOIRE",
    title: "Quand le socle manque et que les arbitrages bloquent la trajectoire.",
    body: "Architecture fixe le cadre avant l'exécution : socle, décisions structurantes, trajectoire défendable.",
    bullets: [
      "Socle cible arrêté",
      "Arbitrages rendus explicites",
      "Trajectoire prête à décider",
    ],
  },
  {
    label: "Ingénierie",
    eyebrow: "SYSTÈMES / DELIVERY / OPÉRATIONS",
    title: "Quand systèmes, flux et opérations freinent le delivery.",
    body: "Ingénierie remet le mécanisme en prise : interfaces, responsabilités, flux critiques et opérabilité.",
    bullets: [
      "Flux critiques remis en ligne",
      "Interfaces clarifiées",
      "Delivery observable",
    ],
  },
  {
    label: "Intelligence",
    eyebrow: "GOUVERNANCE / TRAÇABILITÉ / CONTRÔLE",
    title: "Quand l'activation doit rester utile, explicable et maîtrisée.",
    body: "Intelligence cadre les usages, la preuve, la responsabilité et les parcours de montée en compétence avant activation : rien d'opaque, rien d'ornemental.",
    bullets: [
      "Usages utiles cadrés",
      "Preuve traçable",
      "Activation sous contrôle",
    ],
  },
];
---

<section aria-label="Qualification des services OPUS" class="bg-white py-14 md:py-18">
  <div class="mx-auto w-full max-w-[1720px] px-4 md:px-8 xl:px-10">
    <div class="max-w-[980px]">
      <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">LIGNES D'INTERVENTION</p>
      <h2 class="mt-4 max-w-[14ch] text-[clamp(1.8rem,3.2vw,3.1rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">
        Trois lignes, trois blocages.
      </h2>
      <p class="mt-5 max-w-[52ch] text-base leading-8 text-neutral-700 md:text-[1.02rem]">
        Socle, delivery, intelligence : chaque ligne répond à un blocage différent.
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-5 xl:grid-cols-3">
      {domains.map((domain) => (
        <article class="flex h-full flex-col border border-neutral-200 bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">{domain.eyebrow}</p>
          <div class="mt-4 h-[2px] w-14 bg-opus-red"></div>
          <p class="mt-5 text-[0.78rem] font-medium uppercase tracking-[0.18em] text-neutral-500">{domain.label}</p>
          <h3 class="mt-3 text-[1.2rem] font-semibold leading-7 text-opus-dark">{domain.title}</h3>
          <p class="mt-4 text-sm leading-7 text-neutral-700">{domain.body}</p>
          <ul class="mt-6 space-y-3 border-t border-neutral-200 pt-6 text-sm leading-7 text-neutral-700">
            {domain.bullets.map((bullet) => (
              <li class="flex gap-3">
                <span class="mt-[0.85rem] h-[2px] w-4 shrink-0 bg-opus-red"></span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
