---
const domains = [
  {
    label: "Architecture",
    eyebrow: "QUAND ENGAGER OPUS",
    title: "Quand le sujet manque de socle, d'arbitrages et de trajectoire claire.",
    body: "OPUS intervient pour clarifier le périmètre, remettre les dépendances en cohérence et poser les décisions structurantes avant qu'un programme ne se disperse davantage.",
    bullets: [
      "Cadrage senior du sujet et des dépendances",
      "Arbitrages structurants remis à plat",
      "Trajectoire cible plus défendable pour les décideurs",
    ],
  },
  {
    label: "Ingénierie",
    eyebrow: "QUAND ENGAGER OPUS",
    title: "Quand les systèmes, le delivery et les opérations ne tiennent plus ensemble.",
    body: "OPUS reconnecte les flux, les responsabilités et les mécanismes d'exécution quand l'accumulation de friction rend le delivery plus lent, plus fragile ou plus opaque.",
    bullets: [
      "Interfaces et flux critiques remis en ligne",
      "Exécution plus lisible pour les équipes et la direction",
      "Moins de friction entre architecture, delivery et exploitation",
    ],
  },
  {
    label: "Intelligence",
    eyebrow: "QUAND ENGAGER OPUS",
    title: "Quand l'activation des données ou de l'IA doit rester gouvernable.",
    body: "OPUS n'active que ce qui peut être expliqué, encadré et soutenu dans le temps. L'objectif n'est pas l'effet d'annonce, mais une capacité utile, traçable et exécutable.",
    bullets: [
      "Usages clarifiés avant activation",
      "Règles de preuve et de responsabilité explicites",
      "Capacités utiles sans perdre la maîtrise du risque",
    ],
  },
];
---

<section aria-label="Qualification des services OPUS" class="bg-white py-18 md:py-22">
  <div class="mx-auto w-full max-w-[1720px] px-4 md:px-8 xl:px-10">
    <div class="max-w-[980px]">
      <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">LIGNES D'INTERVENTION</p>
      <h2 class="mt-4 max-w-[13ch] text-[clamp(2rem,4vw,3.7rem)] font-semibold leading-[0.98] tracking-[-0.03em] text-opus-dark">
        Trois lignes pour savoir quand engager OPUS et sur quel type de blocage.
      </h2>
      <p class="mt-5 max-w-[78ch] text-base leading-8 text-neutral-700 md:text-[1.02rem]">
        Services ne rejoue pas la persuasion de la home. Cette page sert à qualifier le type de besoin, le niveau de recadrage nécessaire et la ligne d'intervention la plus utile pour remettre un sujet en état de décision puis d'exécution.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-5 xl:grid-cols-3">
      {domains.map((domain) => (
        <article class="flex h-full flex-col border border-neutral-200 bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,0.03)]">
          <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-neutral-500">{domain.eyebrow}</p>
          <div class="mt-4 h-[2px] w-14 bg-opus-red"></div>
          <p class="mt-5 text-[0.78rem] font-medium uppercase tracking-[0.18em] text-neutral-500">{domain.label}</p>
          <h3 class="mt-3 text-[1.2rem] font-semibold leading-7 text-opus-dark">{domain.title}</h3>
          <p class="mt-4 text-sm leading-7 text-neutral-700">{domain.body}</p>
          <ul class="mt-6 space-y-3 border-t border-neutral-200 pt-6 text-sm leading-7 text-neutral-700">
            {domain.bullets.map((bullet) => (
              <li class="flex gap-3">
                <span class="mt-[0.85rem] h-[2px] w-4 shrink-0 bg-opus-red"></span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
