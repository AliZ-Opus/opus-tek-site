---
---
<div
  aria-hidden="true"
  data-ghost-cursor
  class="pointer-events-none fixed left-0 top-0 z-[140] hidden lg:block"
>
  <span
    data-ghost-ring
    class="absolute left-0 top-0 h-8 w-8 -translate-x-1/2 -translate-y-1/2 rounded-full border border-white/55 bg-white/10 backdrop-blur-[2px] transition-transform duration-200 ease-out"
  ></span>

  <span
    data-ghost-dot
    class="absolute left-0 top-0 h-[6px] w-[6px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-opus-red"
  ></span>
</div>

<script>
  function initGhostCursor() {
    const root = document.querySelector("[data-ghost-cursor]");
    const ring = document.querySelector("[data-ghost-ring]");
    const dot = document.querySelector("[data-ghost-dot]");

    if (!(root instanceof HTMLElement) || !(ring instanceof HTMLElement) || !(dot instanceof HTMLElement)) return;
    if (root.dataset.cursorReady === "true") return;
    root.dataset.cursorReady = "true";

    const isTouchLike =
      window.matchMedia("(hover: none), (pointer: coarse)").matches ||
      navigator.maxTouchPoints > 0;

    if (isTouchLike) {
      root.style.display = "none";
      return;
    }

    root.style.display = "block";

    let currentX = window.innerWidth / 2;
    let currentY = window.innerHeight / 2;
    let targetX = currentX;
    let targetY = currentY;
    let rafId = 0;
    let hovering = false;

    const interactiveSelector = 'a, button, [role="tab"], input, textarea, select, label[for], [data-cursor-hover]';

    const setHoverState = (state) => {
      hovering = state;
      if (hovering) {
        ring.style.transform = "translate(-50%, -50%) scale(1.5)";
        ring.style.backgroundColor = "#FF0000";
        ring.style.borderColor = "#FF0000";
        ring.style.opacity = "0.18";
      } else {
        ring.style.transform = "translate(-50%, -50%) scale(1)";
        ring.style.backgroundColor = "rgba(255,255,255,0.10)";
        ring.style.borderColor = "rgba(255,255,255,0.55)";
        ring.style.opacity = "1";
      }
    };

    const tick = () => {
      currentX += (targetX - currentX) * 0.18;
      currentY += (targetY - currentY) * 0.18;

      root.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
      rafId = requestAnimationFrame(tick);
    };

    const onMove = (event) => {
      targetX = event.clientX;
      targetY = event.clientY;
    };

    const onOver = (event) => {
      const target = event.target instanceof Element ? event.target.closest(interactiveSelector) : null;
      setHoverState(Boolean(target));
    };

    const onOut = (event) => {
      const related = event.relatedTarget instanceof Element ? event.relatedTarget.closest(interactiveSelector) : null;
      if (!related) setHoverState(false);
    };

    const onLeaveWindow = () => {
      root.style.opacity = "0";
    };

    const onEnterWindow = () => {
      root.style.opacity = "1";
    };

    window.addEventListener("mousemove", onMove, { passive: true });
    document.addEventListener("mouseover", onOver, { passive: true });
    document.addEventListener("mouseout", onOut, { passive: true });
    window.addEventListener("blur", onLeaveWindow);
    window.addEventListener("focus", onEnterWindow);
    document.addEventListener("mouseleave", onLeaveWindow);
    document.addEventListener("mouseenter", onEnterWindow);

    tick();
  }

  initGhostCursor();
  document.addEventListener("astro:page-load", initGhostCursor);
</script>