---
const cases = [
  { href: "/etudes-de-cas/appels-offres-ia", title: "Appels d’offres IA", text: "Priorisation et scoring explicable sur grand volume." },
  { href: "/etudes-de-cas/nostra", title: "Nostra (calcul intensif)", text: "Batch nocturne, volumétrie massive, résultats exploitables." },
  { href: "/etudes-de-cas/nexaid", title: "Ops IA réglementé", text: "Automatisation pragmatique, adoption rapide, traçabilité." },
];
---

<section class="home-block alt" aria-label="Études de cas - aperçu">
  <div class="wrap">
    <div class="head">
      <div>
        <div class="k">ÉTUDES DE CAS</div>
        <h2 class="t">Des preuves terrain, en contextes exigeants.</h2>
        <p class="p">Synthèse des approches, décisions et résultats observables.</p>
      </div>
      <div class="cta">
        <a class="btn btn-secondary" href="/etudes-de-cas">Voir toutes les études de cas →</a>
      </div>
    </div>

    <div class="grid">
      {cases.map((c) => (
        <a class="case" href={c.href}>
          <div class="case-top">
            <div class="k2">ÉTUDE DE CAS</div>
            <h3>{c.title}</h3>
          </div>
          <p>{c.text}</p>
          <div class="more">Lire →</div>
        </a>
      ))}
    </div>
  </div>

  <style>
    .home-block.alt{ border-top: 1px solid rgba(var(--line),1); background:#fff; }
    .grid{ margin-top: 18px; display:grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; }
    .case{
      text-decoration:none;
      border:1px solid rgba(var(--line),1);
      background:#fff;
      border-radius:16px;
      padding: 18px 16px;
      display:flex; flex-direction:column; gap: 10px;
      transition: transform .14s ease, box-shadow .14s ease, background .14s ease;
      position: relative;
    }
    .case::before{
      content:"";
      position:absolute;
      left: 16px; top: 0;
      width: 54px; height: 2px;
      background: rgba(var(--red),0.55);
      opacity:.55;
    }
    .case:hover{
      background: rgba(0,0,0,0.012);
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(17,24,39,0.06);
    }
    .k2{ font-size:12px; font-weight:900; letter-spacing:.18em; text-transform:uppercase; color: rgba(var(--muted),0.92); }
    .case h3{ margin: 6px 0 0; font-weight:950; letter-spacing:-0.01em; font-size: 18px; line-height:1.25; }
    .case p{ margin:0; color: rgba(var(--ink),0.75); line-height:1.75; font-size: 14px; }
    .more{ margin-top:auto; font-weight:900; color: rgba(var(--ink),0.86); }
    @media (max-width: 980px){ .grid{ grid-template-columns: 1fr; } }
  </style>
</section>