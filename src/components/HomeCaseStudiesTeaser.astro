---
import { strategicCaseStudies } from "../data/caseStudies";

const homeSummaries: Record<string, string> = {
  "fonder-une-plateforme-de-services":
    "Un sujet public sensible repris à sa base : plateforme plus lisible, plus cohérente, plus tenable.",
  "fondation-client-360-multi-plateforme":
    "Une fondation Client 360 rendue gouvernable : rôles, données et plateformes clarifiés.",
  "clarifier-prioriser-sequencer-recadrer-une-transformation":
    "Une transformation diffuse remise dans un ordre arbitrable avant relance de l'exécution.",
};
---

<section class="border-t border-black/8 bg-white" aria-label="Études de cas - aperçu">
  <div class="mx-auto w-full max-w-[1720px] px-4 py-11 md:px-8 md:py-12 xl:px-10">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-[54ch]">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">PREUVES OPUS</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-authority text-opus-dark md:text-5xl">
          Trois cas où le sujet redevient lisible.
        </h2>
        <p class="mt-4 max-w-[48ch] text-base leading-7 text-neutral-700 md:text-[1rem]">
          Des contextes repris avec assez de cadre pour soutenir décision, gouvernance et exécution.
        </p>
      </div>

      <a
        class="inline-flex min-h-11 items-center justify-center border border-neutral-400 bg-white px-5 text-sm font-medium text-opus-dark shadow-[0_10px_24px_rgba(0,0,0,0.04)] transition hover:border-opus-dark hover:bg-opus-dark hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
        href="/ressources#case-studies"
      >
        Voir les cas
      </a>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 xl:grid-cols-3">
      {strategicCaseStudies.map((item) => (
        <a
          class="group flex min-h-[194px] flex-col rounded-[20px] border border-black/8 bg-white px-6 py-5 text-left text-opus-dark shadow-[0_10px_24px_rgba(0,0,0,0.03)] transition hover:-translate-y-0.5 hover:border-black/12 hover:shadow-[0_18px_36px_rgba(17,24,39,0.08)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
          href={`/case-studies/${item.slug}`}
        >
          <div class="h-[2px] w-14 bg-opus-red/70"></div>
          <p class="mt-5 text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-opus-red">{item.eyebrow}</p>
          <h3 class="mt-4 text-[1.22rem] font-semibold leading-tight text-opus-dark">{item.title}</h3>
          <p class="mt-3 text-[0.94rem] leading-7 text-neutral-700">{homeSummaries[item.slug] ?? item.homeSummary}</p>
          <div class="mt-auto pt-5 text-[0.82rem] font-medium uppercase tracking-[0.18em] text-opus-dark transition group-hover:text-opus-red">
            Voir le cas
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
