---
import { strategicCaseStudies } from "../data/caseStudies";
---

<section class="border-t border-black/8 bg-white" aria-label="Études de cas - aperçu">
  <div class="mx-auto w-full max-w-[1720px] px-4 py-14 md:px-8 md:py-16 xl:px-10">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-[66ch]">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500">PREUVES OPUS</p>
        <h2 class="mt-4 text-4xl font-semibold tracking-authority text-opus-dark md:text-5xl">
          Trois preuves, trois destinations cohérentes, sans mosaïque.
        </h2>
        <p class="mt-5 text-base leading-7 text-neutral-700 md:text-[1.02rem]">
          Home et Ressources portent le même trio de preuves. Chaque carte annonce une promesse claire et ouvre la page qui la reprend immédiatement, sans décalage de lecture.
        </p>
      </div>

      <a
        class="inline-flex min-h-12 items-center justify-center border border-neutral-400 bg-white px-6 text-sm font-medium text-opus-dark shadow-[0_10px_24px_rgba(0,0,0,0.04)] transition hover:border-opus-dark hover:bg-opus-dark hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
        href="/ressources#case-studies"
      >
        Voir les cas
      </a>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 xl:grid-cols-3">
      {strategicCaseStudies.map((item) => (
        <a
          class="group flex min-h-[224px] flex-col rounded-[20px] border border-black/8 bg-white px-6 py-5 text-left text-opus-dark shadow-[0_10px_24px_rgba(0,0,0,0.03)] transition hover:-translate-y-0.5 hover:border-black/12 hover:shadow-[0_18px_36px_rgba(17,24,39,0.08)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
          href={`/case-studies/${item.slug}`}
        >
          <div class="h-[2px] w-14 bg-opus-red/70"></div>
          <p class="mt-5 text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-opus-red">{item.eyebrow}</p>
          <h3 class="mt-4 text-[1.4rem] font-semibold leading-tight text-opus-dark">{item.title}</h3>
          <p class="mt-4 text-[0.98rem] leading-7 text-neutral-700">{item.homeSummary}</p>
          <div class="mt-auto pt-6 text-[0.82rem] font-medium uppercase tracking-[0.18em] text-opus-dark transition group-hover:text-opus-red">
            Voir le cas
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
