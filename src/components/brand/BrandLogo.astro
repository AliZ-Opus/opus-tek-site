---
interface Props {
  theme?: "light" | "dark";
  className?: string;
  alt?: string;
}

const {
  theme = "dark",
  className = "",
  alt = "OPUS Technology",
} = Astro.props;

const src =
  theme === "light"
    ? "/assets/brand/logo-light.png"
    : "/assets/brand/logo-dark.png";
---

<img
  src={src}
  alt={alt}
  width="320"
  height="96"
  loading="eager"
  decoding="async"
  class:list={[
    "block h-auto w-auto max-w-full select-none",
    className,
  ]}
/>
