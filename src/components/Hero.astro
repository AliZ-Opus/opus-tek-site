---
import heroImage from "../assets/hero/opus-hero-cgi-hq.png";

interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
}

const {
  kicker = "CADRAGE SENIOR · EXÉCUTION GOUVERNABLE",
  title = "Quand la complexité ralentit, OPUS remet la décision au service de l'exécution.",
  lead = "OPUS intervient quand un sujet critique doit redevenir lisible, arbitrable et exécutable.",
  primaryCtaLabel = "Soumettre un besoin",
  primaryCtaHref = "/contact",
  secondaryCtaLabel = "Voir les cas",
  secondaryCtaHref = "/ressources#case-studies",
} = Astro.props;
---

<section aria-label="Accueil - Hero OPUS" class="relative isolate overflow-hidden bg-white">
  <div class="mx-auto grid min-h-[74svh] max-w-[1720px] grid-cols-1 items-center px-4 py-10 md:px-8 xl:px-10 lg:grid-cols-[32%_68%]">
    <div class="relative z-20 flex min-w-0 items-center">
      <div class="relative w-full max-w-[660px] py-8 lg:py-12">
        <div
          aria-hidden="true"
          class="hero-mask-left pointer-events-none absolute inset-y-0 -left-8 right-[-84%] z-0"
        ></div>

        <div class="relative z-10">
          <p class="mb-5 text-[0.7rem] font-semibold uppercase tracking-[0.26em] text-neutral-500">
            {kicker}
          </p>

          <h1 class="max-w-[15ch] text-[clamp(2.65rem,4.7vw,4.55rem)] font-black leading-[0.94] tracking-[-0.04em] text-opus-dark">
            {title}
          </h1>

          <p class="mt-5 max-w-[42ch] text-base leading-8 text-neutral-700 md:text-[1.05rem]">
            {lead}
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href={primaryCtaHref}
              class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white shadow-[0_10px_24px_rgba(0,0,0,0.08)] transition hover:border-black hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
            >
              {primaryCtaLabel}
            </a>

            <a
              href={secondaryCtaHref}
              class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark shadow-[0_10px_24px_rgba(0,0,0,0.04)] transition hover:border-opus-dark hover:bg-opus-dark hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
            >
              {secondaryCtaLabel}
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="relative mt-6 h-full min-h-[520px] sm:min-h-[600px] lg:mt-0 lg:min-h-[760px]">
      <img
        src={heroImage.src}
        alt="Visualisation architecturale OPUS"
        width={heroImage.width}
        height={heroImage.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-center"
        style="opacity:1!important;"
      />
    </div>
  </div>
</section>
