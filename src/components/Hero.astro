---
import { Image } from "astro:assets";
import S1Underline from "./nav/S1Underline.astro";
import HomeHeroMicroCard from "./HomeHeroMicroCard.astro";
import heroImage from "../assets/hero/opus-hero-cgi-hq.jpg";

interface PodItem {
  label: string;
  href: string;
  current?: boolean;
}

interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  pods?: PodItem[];
}

const {
  kicker = "TRANSFORMATION • DONNÉES • INTELLIGENCE ARTIFICIELLE",
  title = "Maîtriser chaque décision technologique critique.",
  lead = "Nous accompagnons les organisations qui veulent concevoir, sécuriser et exécuter des plateformes, intégrations et capacités d’IA avec rigueur, clarté et impact mesurable.",
  primaryCtaLabel = "Voir nos services",
  primaryCtaHref = "/services",
  secondaryCtaLabel = "Parler à un expert",
  secondaryCtaHref = "/contact",
  pods = [
    { label: "Services", href: "/services", current: true },
    { label: "Solutions", href: "/solutions" },
    { label: "Ressources", href: "/ressources" },
  ],
} = Astro.props;
---

<section aria-label="Accueil - Hero OPUS" class="relative isolate overflow-clip bg-white">
  <div class="mx-auto w-full grid min-h-[80svh] max-h-[760px] max-w-[1680px] grid-cols-1 items-center px-4 py-10 md:px-8 lg:grid-cols-[40%_60%] xl:grid-cols-[40%_60%] xl:px-10">
    <div class="relative z-20 flex min-w-0 items-center">
      <div class="relative w-full max-w-[800px] py-8 lg:py-12 lg:pr-12 xl:pr-24">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-y-0 -left-8 right-[-38%] z-0"
          style="
            background: linear-gradient(to right, rgba(255,255,255,0.98) 0%, rgba(255,255,255,0) 100%);
            -webkit-mask-image: linear-gradient(to right, black 42%, transparent 100%);
            mask-image: linear-gradient(to right, black 42%, transparent 100%);
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
            -webkit-mask-size: 100% 100%;
            mask-size: 100% 100%;
          "
        ></div>

        <div class="relative z-10">
          <p class="mb-5 text-[0.72rem] font-semibold uppercase tracking-[0.28em] text-neutral-500 sm:text-xs">
            {kicker}
          </p>

          <h1 class="max-w-[18ch] text-display-hero font-semibold leading-tightest tracking-authority text-opus-dark">
            {title}
          </h1>

          <p class="mt-6 max-w-[60ch] text-base leading-7 text-neutral-700 sm:text-[1.05rem]">
            {lead}
          </p>

          <div class="mt-7 h-[2px] w-24 bg-opus-red"></div>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href={primaryCtaHref}
              class="inline-flex min-h-12 items-center justify-center border border-opus-dark bg-opus-dark px-6 text-sm font-medium text-white transition hover:bg-black focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
            >
              {primaryCtaLabel} →
            </a>

            <a
              href={secondaryCtaHref}
              class="inline-flex min-h-12 items-center justify-center border border-neutral-300 bg-white px-6 text-sm font-medium text-opus-dark transition hover:border-opus-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgba(255,0,0,.45)]"
            >
              {secondaryCtaLabel} →
            </a>
          </div>

          <div class="mt-10 w-full max-w-[520px]">
            <S1Underline selector='[data-s1-item]' active='[aria-current="page"]'>
              <nav aria-label="Navigation rapide accueil" class="flex items-center gap-6 sm:gap-8">
                {pods.map((pod) => (
                  <a
                    href={pod.href}
                    data-s1-item
                    aria-current={pod.current ? "page" : undefined}
                    class:list={[
                      "relative inline-flex min-h-10 items-center pb-3 text-[0.82rem] font-medium uppercase tracking-[0.18em] transition",
                      pod.current ? "text-opus-dark" : "text-neutral-500 hover:text-opus-dark",
                    ]}
                  >
                    {pod.label}
                  </a>
                ))}
              </nav>
            </S1Underline>
          </div>
        </div>
      </div>
    </div>

    <div class="relative mt-6 h-full min-h-[400px] sm:min-h-[520px] lg:min-h-[560px] xl:mt-0 xl:min-h-[640px]">
      <Image
        src={heroImage}
        alt="Visualisation architecturale premium d’OPUS Technology"
        widths={[960, 1280, 1600, 1920]}
        sizes="(max-width: 1023px) 100vw, 60vw"
        format="avif"
        quality={92}
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 h-full w-full object-cover object-center"
        style="opacity: 1 !important;"
      />

      <div class="absolute bottom-4 right-4 z-20 w-[min(360px,calc(100%-2rem))] md:bottom-6 md:right-6 lg:bottom-8 lg:right-8">
        <HomeHeroMicroCard />
      </div>
    </div>
  </div>
</section>